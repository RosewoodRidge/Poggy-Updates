{
  "label": "Poggy Scene",
  "tagline": "Coloured scene text, status tags and a /me box that make every roleplay moment readable",
  "category": "Roleplay",
  "description": "Players place coloured floating text in the world that stays through restarts, wear a status tag above their head, and send /me and /do actions. Nearby /me messages also collect in a tidy on-screen box so nobody misses them.",
  "readme": "README.md",
  "help": [
    {
      "title": "Managing scenes in /poggy",
      "file": "docs/help/managing-scenes.md"
    },
    {
      "title": "Who can place and remove scenes",
      "file": "docs/help/scene-permissions.md"
    },
    {
      "title": "Colours, themes and the /me box",
      "file": "docs/help/colours-and-mebox.md"
    }
  ],
  "commands": [
    {
      "command": "/scene",
      "configPath": "Config.scenecommand",
      "who": "Everyone",
      "description": "Opens the Scene Editor to write coloured text and place it in the world. With Job lock on, only the allowed jobs, the remove jobs and the admin group can use it.",
      "usage": "/scene",
      "examples": [
        "/scene"
      ]
    },
    {
      "command": "/me",
      "configPath": "Config.mecommand",
      "who": "Everyone",
      "description": "An in-character action. Floats above your character and appears in nearby players' /me box.",
      "usage": "/me <action>",
      "examples": [
        "/me tips his hat",
        "/me counts the coins slowly"
      ]
    },
    {
      "command": "/do",
      "configPath": "Config.ooccommand",
      "who": "Everyone",
      "description": "A description of the scene, shown in red above your character. Not added to the /me box.",
      "usage": "/do <description>",
      "examples": [
        "/do The wanted poster is torn at the corner"
      ]
    },
    {
      "command": "/status",
      "configPath": "Config.statuscommand",
      "who": "Everyone",
      "description": "Sets a status tag that stays above your character. Alone, it opens the Status Editor with colours and saved presets.",
      "usage": "/status [text]",
      "examples": [
        "/status",
        "/status Injured, left arm"
      ]
    },
    {
      "command": "/cstatus",
      "configPath": "Config.stopdisplay",
      "who": "Everyone",
      "description": "Clears your status tag.",
      "usage": "/cstatus",
      "examples": [
        "/cstatus"
      ]
    },
    {
      "command": "/id",
      "configPath": "Config.id",
      "who": "Everyone",
      "description": "Shows your server ID above your character for a few seconds.",
      "usage": "/id",
      "examples": [
        "/id"
      ]
    },
    {
      "command": "/cash",
      "configPath": "Config.cash",
      "who": "Everyone",
      "description": "Shows your current cash above your character for a few seconds. The amount is read on the server.",
      "usage": "/cash",
      "examples": [
        "/cash"
      ]
    },
    {
      "command": "/mebox",
      "configPath": "Config.meboxcommand",
      "who": "Everyone",
      "description": "Controls your own /me box: auto (fades), persist, off, move (drag it; Esc saves), or small / normal / large. Saved for that player.",
      "usage": "/mebox auto | persist | off | move | small | normal | large",
      "examples": [
        "/mebox persist",
        "/mebox move",
        "/mebox large"
      ]
    }
  ],
