{
  "label": "Supply Drops & Scavenger Hunts",
  "tagline": "Balloon supply drops and riddle treasure hunts that send players racing across the map",
  "category": "World",
  "description": "Supply drops float down under a hot air balloon at random places, and the first player to reach one claims the goods. Scavenger hunts hide a treasure somewhere in the world with a photo and a riddle; revealing the clue costs part of the reward. Both run on their own schedule, and admins can start them by command.",
  "readme": "README.md",
  "help": [
    {
      "title": "How the schedule works",
      "file": "docs/help/schedule.md"
    },
    {
      "title": "Adding drop locations and loot",
      "file": "docs/help/supply-drops.md"
    },
    {
      "title": "Adding a scavenger hunt",
      "file": "docs/help/scavenger-hunts.md"
    }
  ],
  "commands": [
    {
      "command": "/supplydrop",
      "who": "Admins",
      "description": "Starts a supply drop now, at a random location with random loot. It also starts the supply drop cooldown. Admins are decided by poggy_core; also works from the server console.",
      "usage": "/supplydrop",
      "examples": [
        "/supplydrop"
      ]
    },
    {
      "command": "/scavengerhunt",
      "who": "Admins",
      "description": "Starts a scavenger hunt now, at a random hunt location with a random reward. It also starts the hunt cooldown. Admins are decided by poggy_core; also works from the server console.",
      "usage": "/scavengerhunt",
      "examples": [
        "/scavengerhunt"
      ]
    },
    {
      "command": "/nextdrop",
      "who": "Everyone",
      "description": "Shows how long until the next supply drop and scavenger hunt may happen. Admins who add 'detailed' also see the clock time.",
      "usage": "/nextdrop [detailed]",
      "examples": [
        "/nextdrop",
        "/nextdrop detailed"
      ]
    },
    {
      "command": "/clue",
      "who": "Everyone",
      "description": "Opens the current scavenger hunt: its photo, the reward and the hidden clue. Revealing the clue lowers the reward.",
      "usage": "/clue",
      "examples": [
        "/clue"
      ]
    },
    {
      "command": "testdiscord",
      "who": "Console",
      "description": "Sends a test message to the supply drop or scavenger hunt webhook. Server console only. Give a webhook URL as a second word to test that URL instead.",
      "usage": "testdiscord [supply|scavenger] [url]",
      "examples": [
        "testdiscord supply",
        "testdiscord scavenger"
      ]
    }
  ],
