/* ================================================================
   Poggy theme skin: poggy_badge

   Covers the badge editor (#editor-root: header, offset and rotation
   sliders, Show / Attach / Detach, presets, bone select).

   Left alone on purpose:
   - the badge pictures (images/*.png): the preview in the editor and the
     big picture nearby players are shown;
   - the whole badge flash (#badge-display): picture art with its name and
     server lines drawn straight over the game world (cream text with a
     dark shadow), so it keeps its own look on every theme.
   Detach keeps its meaning as the danger button; Show is a plain button
   and Attach the primary one (they were decorative green and blue).
   ================================================================ */

html.pg-themed body { color: var(--pg-text); }

/* ── the panel ── */
html.pg-themed .editor-panel {
    background: var(--pg-panel-bg);
    border: 1px solid var(--pg-border);
    border-radius: var(--pg-radius);
    box-shadow: var(--pg-shadow);
}
html.pg-themed .editor-panel::-webkit-scrollbar-thumb,
html.pg-themed .preset-list::-webkit-scrollbar-thumb { background: var(--pg-accent-soft); border-radius: 0; }

html.pg-themed .editor-header { border-bottom: 1px solid var(--pg-border-soft); }
html.pg-themed .editor-title {
    font-family: var(--pg-font-display);
    font-weight: 400;
    letter-spacing: .04em;
    color: var(--pg-text);
}
/* the close ×: a small plain square button (its size is the script's) */
html.pg-themed .editor-close {
    background: var(--pg-btn-bg);
    border: 1px solid var(--pg-btn-border);
    border-radius: var(--pg-radius-sm);
    color: var(--pg-text-soft);
}
html.pg-themed .editor-close:hover {
    background: var(--pg-btn-bg-hover);
    border-color: var(--pg-accent-soft);
    color: var(--pg-text);
}

/* the badge preview picture is left alone; only its drop shadow takes the shade token */
html.pg-themed .badge-preview img { filter: drop-shadow(0 1px 4px rgba(var(--pg-shade-rgb), .6)); }

html.pg-themed .section-label {
    font-family: var(--pg-font-display);
    color: var(--pg-text-muted);
    letter-spacing: .07em;
}

/* ── sliders ── */
html.pg-themed .slider-label {
    font-family: var(--pg-font-display);
    color: var(--pg-text-soft);
}
html.pg-themed .slider-label small { font-family: var(--pg-font-body); color: var(--pg-text-muted); }
html.pg-themed .slider {
    background: var(--pg-deep);
    border-radius: var(--pg-radius-sm);
    box-shadow: inset 0 0 0 1px var(--pg-border-soft);
}
html.pg-themed .slider::-webkit-slider-thumb {
    background: var(--pg-accent);
    border: 1px solid rgba(var(--pg-shade-rgb), .35);
    border-radius: var(--pg-radius-sm);
    box-shadow: 0 1px 4px rgba(var(--pg-shade-rgb), .4);
}
html.pg-themed .slider:hover::-webkit-slider-thumb { background: var(--pg-accent-hi); }

html.pg-themed .slider-val,
html.pg-themed .preset-save-row input[type="text"],
html.pg-themed .bone-select {
    background: var(--pg-input-bg);
    border: 1px solid var(--pg-input-border);
    border-radius: var(--pg-radius-sm);
    color: var(--pg-text);
    font-family: var(--pg-font-body);
}
html.pg-themed .slider-val { font-family: var(--pg-font-mono); }
html.pg-themed .slider-val:focus,
html.pg-themed .preset-save-row input[type="text"]:focus,
html.pg-themed .bone-select:focus {
    border-color: var(--pg-accent);
    box-shadow: var(--pg-focus-ring);
}
html.pg-themed .bone-select:hover { border-color: var(--pg-accent-soft); }
html.pg-themed .bone-select option { background: var(--pg-panel-solid); color: var(--pg-text); }
html.pg-themed .preset-save-row input[type="text"]::placeholder { color: var(--pg-text-dim); }

/* ── buttons ── */
html.pg-themed .btn {
    background: var(--pg-btn-bg);
    border: 1px solid var(--pg-btn-border);
    border-radius: var(--pg-radius-sm);
    color: var(--pg-text);
    font-family: var(--pg-font-display);
    letter-spacing: .07em;
    text-transform: uppercase;
}
html.pg-themed .btn:hover {
    background: var(--pg-btn-bg-hover);
    border-color: var(--pg-accent-soft);
}
html.pg-themed .btn-attach,
html.pg-themed .btn-attach:hover {
    background: var(--pg-btn-primary-bg);
    border-color: var(--pg-accent-soft);
    color: var(--pg-text);
}
html.pg-themed .btn-attach:hover { border-color: var(--pg-accent); }
html.pg-themed .btn-detach,
html.pg-themed .btn-detach:hover {
    background: var(--pg-btn-danger-bg);
    border-color: rgba(var(--pg-danger-rgb), .45);
    color: var(--pg-danger);
}
html.pg-themed .btn-detach:hover { border-color: var(--pg-danger); }

/* ── presets ── */
html.pg-themed .presets-empty { font-family: var(--pg-font-body); color: var(--pg-text-muted); }
html.pg-themed .preset-item {
    background: var(--pg-surface);
    border-radius: var(--pg-radius-sm);
    box-shadow: inset 0 0 0 1px var(--pg-border-soft);
}
html.pg-themed .preset-item:hover {
    background: var(--pg-surface-hover);
    box-shadow: inset 0 0 0 1px var(--pg-accent-soft);
}
html.pg-themed .preset-item-name { font-family: var(--pg-font-body); color: var(--pg-text); }
html.pg-themed .preset-item-name:hover { color: var(--pg-accent); }
html.pg-themed .preset-item-del { color: rgba(var(--pg-danger-rgb), .75); }
html.pg-themed .preset-item-del:hover { color: var(--pg-danger); }
