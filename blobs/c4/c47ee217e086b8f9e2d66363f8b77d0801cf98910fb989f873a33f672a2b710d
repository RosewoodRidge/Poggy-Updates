{
  "label": "Poggy Core",
  "tagline": "The engine behind every Poggy script: one framework layer, updates and this settings hub",
  "category": "Framework",
  "description": "poggy_core connects every Poggy script to your framework (VORP, RSG or QBR), keeps the scripts up to date from the Poggy update feed, and runs this settings hub. Every other Poggy script needs it running. Restart poggy_core by hand: restarting it restarts every Poggy script.",
  "readme": "README.md",
  "help": [
    {"title": "Using the settings hub", "file": "docs/help/settings-hub.md"},
    {"title": "Roles and job lists", "file": "docs/help/roles.md"},
    {"title": "Diagnostics commands", "file": "docs/help/diagnostics.md"},
    {"title": "Bans", "file": "docs/help/bans.md"},
    {"title": "Theme", "file": "docs/help/theme.md"}
  ],

  "commands": [
    {
      "command": "/poggy",
      "configPath": "PoggyCoreConfig.Hub.Command",
      "who": "Admins",
      "description": "Opens this settings hub. Allowed for players with the ACE poggy.settings or anyone your framework counts as an admin. Taking over a script someone else is editing needs the ACE poggy.settings.takeover.",
      "usage": "/poggy",
      "examples": ["/poggy"]
    },
    {
      "command": "poggycore",
      "who": "Admins",
      "description": "Status: framework, version, capabilities and registered containers. Works in the server console, or in chat as /poggycore for players with the ACE command or poggycore, or a framework admin.",
      "usage": "poggycore",
      "examples": ["poggycore", "/poggycore"]
    },
    {
      "command": "poggycore test",
      "who": "Admins",
      "description": "Read-only smoke test against your own character: character, money, inventory. Changes nothing. Run it in chat, in game.",
      "usage": "/poggycore test",
      "examples": ["/poggycore test"]
    },
    {
      "command": "poggycore selftest",
      "who": "Admins",
      "description": "Exercises every verb and reports pass or fail. 'full' also runs the verbs that change things, then undoes them.",
      "usage": "poggycore selftest [full]",
      "examples": ["/poggycore selftest", "/poggycore selftest full"]
    },
    {
      "command": "poggycore verbs",
      "who": "Admins",
      "description": "Lists the verbs scripts call through poggy_core, with the side they run on and what they need. Add a word to filter the list.",
      "usage": "poggycore verbs [filter]",
      "examples": ["poggycore verbs", "poggycore verbs money"]
    },
    {
      "command": "poggycore do",
      "who": "Admins",
      "description": "Runs one verb for real and prints the answer. src=me means you. Careful: verbs that give money or items really do it.",
      "usage": "poggycore do <verb> [key=value ...]",
      "examples": ["/poggycore do money.get src=me", "/poggycore do jobs.list"]
    },
    {
      "command": "poggycore caps",
      "who": "Admins",
      "description": "The full capability map: what the detected framework can and cannot do.",
      "usage": "poggycore caps",
      "examples": ["poggycore caps"]
    },
    {
      "command": "poggycore detect",
      "who": "Admins",
      "description": "Explains why the framework did or did not resolve: forced framework, detection order, and what each core answered.",
      "usage": "poggycore detect",
      "examples": ["poggycore detect"]
    },
    {
      "command": "poggycore resolve",
      "who": "Admins",
      "description": "Runs framework detection again without restarting, then shows the detect report.",
      "usage": "poggycore resolve",
      "examples": ["poggycore resolve"]
    },
    {
      "command": "poggycore scripts",
      "who": "Admins",
      "description": "Every registered Poggy script: product id, folder (when renamed) and version.",
      "usage": "poggycore scripts",
      "examples": ["poggycore scripts"]
    },
    {
      "command": "poggycore usables",
      "who": "Admins",
      "description": "Usable items registered through poggy_core, and which script owns each one.",
      "usage": "poggycore usables",
      "examples": ["poggycore usables"]
    },
    {
      "command": "poggycore dependents",
      "who": "Admins",
      "description": "Resources that stop when poggy_core stops, their state, and the record used to start them again.",
      "usage": "poggycore dependents",
      "examples": ["poggycore dependents"]
    },
    {
      "command": "poggycore catalog",
      "who": "Admins",
      "description": "Published Poggy scripts this server does not have, with store links.",
      "usage": "poggycore catalog",
      "examples": ["poggycore catalog"]
    },
    {
      "command": "poggycore update",
      "who": "Console",
      "description": "Checks for, or installs, updates from the Poggy feed. check only reports; apply installs (config files are merged, your values kept, backups made). A script only updates when the published version is higher. Server console only.",
      "usage": "poggycore update <resource|all> [check|stage|apply] [force]",
      "examples": ["poggycore update all", "poggycore update all apply", "poggycore update poggy_markets apply"]
    },
    {
      "command": "poggycore update nettest",
      "who": "Console",
      "description": "Tests whether the server can reach the update feed, and explains any failure. Server console only.",
      "usage": "poggycore update nettest",
      "examples": ["poggycore update nettest"]
    },
    {
      "command": "poggycore update <resource> writetest",
      "who": "Console",
      "description": "Tests whether poggy_core can write files into a script's folder, which updates and the settings hub both need. Server console only.",
      "usage": "poggycore update <resource> writetest",
      "examples": ["poggycore update poggy_markets writetest"]
    },
    {
      "command": "poggycore sql",
      "who": "Console",
      "description": "check shows what a script's sql/install.sql would change in the database; install runs it now. Server console only.",
      "usage": "poggycore sql <check|install> <resource|all>",
      "examples": ["poggycore sql check all", "poggycore sql install poggy_markets"]
    },
    {
      "command": "poggycore settings",
      "who": "Admins",
      "description": "Lists every script the hub knows, who is editing which, and each config file's fingerprint.",
      "usage": "poggycore settings",
      "examples": ["poggycore settings"]
    },
    {
      "command": "poggycore settings show",
      "who": "Admins",
      "description": "Prints every setting of one script with its value and file:line.",
      "usage": "poggycore settings show <id>",
      "examples": ["poggycore settings show poggy_markets"]
    },
    {
      "command": "poggycore settings set",
      "who": "Console",
      "description": "Changes one setting the same way the hub does (backup, checks, history), logged as 'console'. The value is JSON: numbers and true/false as they are, text in double quotes.",
      "usage": "poggycore settings set <id> <path> <json value>",
      "examples": [
        "poggycore settings set poggy_core PoggyCoreConfig.NotifyDuration 5000",
        "poggycore settings set poggy_core PoggyCoreConfig.Ui.Position \"left\""
      ]
    },
    {
      "command": "poggycore settings unlock",
      "who": "Console",
      "description": "Frees a script that someone is editing in the hub, for example after a crash. Their unsaved changes are lost.",
      "usage": "poggycore settings unlock <id>",
      "examples": ["poggycore settings unlock poggy_markets"]
    },
    {
      "command": "poggycore ban",
      "who": "Admins",
      "description": "Bans a player's account, so it follows them across characters, and removes them at once. Give a server id for someone online, or an identifier (license:...) for someone who has left. The word cheat marks a cheating ban; leave it out for a rule break. Console, or chat for players with the ACE command or poggycore, or a framework admin.",
      "usage": "poggycore ban <server id | identifier> <30m|2h|7d|1w|perm> [cheat] <reason>",
      "examples": ["poggycore ban 12 7d combat logging", "poggycore ban 12 perm cheat aimbot, clip in ticket 41", "poggycore ban license:1a2b3c perm cheat left before the ban"]
    },
    {
      "command": "poggycore unban",
      "who": "Admins",
      "description": "Lifts a ban. The ban stays on record, marked as lifted, with who lifted it and why.",
      "usage": "poggycore unban <ban number> <reason>",
      "examples": ["poggycore unban 14 appeal accepted"]
    },
    {
      "command": "poggycore baninfo",
      "who": "Admins",
      "description": "With nothing after it, lists the active bans. With a server id, an identifier or a ban number, shows every ban on record for it.",
      "usage": "poggycore baninfo [server id | identifier | ban number]",
      "examples": ["poggycore baninfo", "poggycore baninfo 12", "poggycore baninfo license:1a2b3c"]
    },
    {
      "command": "poggycore bannet",
      "who": "Admins",
      "description": "The ban network's status on this server: whether it refuses and shares, how many players the network knows, when the list was last read, and whether this server is registered and its votes count yet (a new server's votes wait 14 days). Add refresh to read the list now.",
      "usage": "poggycore bannet [refresh]",
      "examples": ["poggycore bannet", "poggycore bannet refresh"]
    },
    {
      "command": "poggycore banallow",
      "who": "Admins",
      "description": "A second chance: lets one player the network has blocked into YOUR server, and counts your server as one voice for them on the network. Needs their identifier (the console prints it when they are refused) and a reason. With nothing after it, lists who you have allowed. remove puts them back under the network.",
      "usage": "poggycore banallow <identifier> <reason>  |  poggycore banallow remove <identifier>",
      "examples": ["poggycore banallow", "poggycore banallow license:1a2b3c cleared on appeal", "poggycore banallow remove license:1a2b3c"]
    }
  ],

