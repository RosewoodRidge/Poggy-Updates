{
  "label": "Poggy Balloon",
  "tagline": "Hot air balloon taxis, self-flown rentals and passengers who stay in the basket",
  "category": "World",
  "description": "Balloon operators across the map fly players to any waypoint for a fare, or rent them a balloon to fly themselves. Captains get proper climb, descend, boost and brake controls, and up to four passengers ride with sitting animations instead of ragdolling.",
  "readme": "README.md",
  "help": [
    {"title": "Adding a balloon station", "file": "docs/help/adding-a-station.md"},
    {"title": "Tuning taxi flights and rentals", "file": "docs/help/tuning-flights.md"}
  ],

  "commands": [
    {
      "command": "/spawnballoon",
      "who": "Admins",
      "description": "Spawns a balloon next to you. With Admin only on, the player needs the ACE set in ACE permission or must be an admin in the framework. Turn it off entirely with Command enabled. The name is fixed.",
      "usage": "/spawnballoon",
      "examples": ["/spawnballoon"]
    },
    {
      "command": "/spawnballoon_local",
      "who": "Everyone",
      "description": "A client-side spawn that only exists when Admin only is turned off. Spawns a balloon next to you.",
      "usage": "/spawnballoon_local",
      "examples": ["/spawnballoon_local"]
    },
    {
      "command": "/balloon_server_status",
      "who": "ACE: command.balloon_server_status",
      "description": "Prints every tracked balloon and who sits in each seat to the server console.",
      "usage": "/balloon_server_status",
      "examples": ["/balloon_server_status"]
    },
    {
      "command": "/balloon_taxi_debug",
      "who": "Everyone",
      "description": "Taxi debugging in your own F8 console: toggle logging, set the level, or show the current ride state. Affects only the player who types it.",
      "usage": "/balloon_taxi_debug toggle | level <0-4> | status",
      "examples": ["/balloon_taxi_debug status", "/balloon_taxi_debug level 4"]
    },
    {
      "command": "/balloon_debug_main",
      "who": "Everyone",
      "description": "Seat and boarding debugging in your own F8 console. Affects only the player who types it.",
      "usage": "/balloon_debug_main level <0-4> | toggle | status",
      "examples": ["/balloon_debug_main status"]
    },
    {
      "command": "/balloon_debug_anim",
      "who": "Everyone",
      "description": "Animation debugging in your own F8 console. Affects only the player who types it.",
      "usage": "/balloon_debug_anim level <0-4> | toggle",
      "examples": ["/balloon_debug_anim toggle"]
    },
    {
      "command": "/balloon_debug_ctrl",
      "who": "Everyone",
      "description": "Captain controls debugging in your own F8 console. Affects only the player who types it.",
      "usage": "/balloon_debug_ctrl level <0-4> | toggle",
      "examples": ["/balloon_debug_ctrl toggle"]
    },
    {
      "command": "balloon_taxi_server_debug",
      "who": "Console",
      "description": "Server console: toggle taxi logging, list active rides, or clear a stuck ride so the player can book again.",
      "usage": "balloon_taxi_server_debug toggle | status | clear <playerId>",
      "examples": ["balloon_taxi_server_debug status", "balloon_taxi_server_debug clear 12"]
    },
    {
      "command": "balloon_rental_debug",
      "who": "Console",
      "description": "Server console: list active rentals with the time left, or end one early.",
      "usage": "balloon_rental_debug status | end <playerId>",
      "examples": ["balloon_rental_debug status", "balloon_rental_debug end 12"]
    }
  ],

