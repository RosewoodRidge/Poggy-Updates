{
  "label": "Witnesses",
  "tagline": "Every crime has a witness: stop them before they reach the law",
  "category": "Roleplay",
  "description": "When a player shoots, fights, lassos, tramples, steals a horse or carries a hostage in town, a nearby NPC sees it, flees and tries to report it. If the witness gets away, law jobs get an alert with a blip and a waypoint. The same alert system gives players commands like /callpolice and /calldoctor, and an optional NPC law posse can ride out when no player lawmen are on duty.",
  "readme": "README.md",
  "help": [
    {
      "title": "Adding an alert command",
      "file": "docs/help/alert-commands.md"
    },
    {
      "title": "Where witnesses work",
      "file": "docs/help/towns-and-zones.md"
    },
    {
      "title": "NPC law response",
      "file": "docs/help/npc-law.md"
    }
  ],
  "commands": [
    {
      "command": "/callpolice",
      "who": "Everyone",
      "description": "Sends a 'NEED POLICE' alert with a blip at the player's position to every law job in the law job list. 120 second cooldown per player. The name is set in that alert's row of the Job alerts list; this is the name it ships with.",
      "usage": "/callpolice",
      "examples": [
        "/callpolice"
      ]
    },
    {
      "command": "/calldoctor",
      "who": "Everyone",
      "description": "Sends a 'NEED DOCTOR' alert to the doctor job. The blip stays until a doctor reaches the spot. 120 second cooldown per player. The name is set in that alert's row of the Job alerts list; this is the name it ships with.",
      "usage": "/calldoctor",
      "examples": [
        "/calldoctor"
      ]
    },
    {
      "command": "/undertaker",
      "who": "Everyone",
      "description": "Sends an 'UNDERTAKER' alert to the undertaker job. /alertundertaker does the same. The name is set in that alert's row of the Job alerts list; this is the name it ships with.",
      "usage": "/undertaker",
      "examples": [
        "/undertaker",
        "/alertundertaker"
      ]
    },
    {
      "command": "/calltrain",
      "who": "Everyone",
      "description": "Sends a 'PASSENGER PICKUP' alert to the conductor job. The name is set in that alert's row of the Job alerts list; this is the name it ships with.",
      "usage": "/calltrain",
      "examples": [
        "/calltrain"
      ]
    },
    {
      "command": "/robbery198sd99720",
      "who": "Everyone",
      "description": "One of the hidden alert commands (robbery, break-in, bounty, drug sale, explosives, kidnapping, prisoner escape, train robbery, grave robbing and more). They are meant to be fired by other scripts; the odd names stop players guessing them, but anyone who knows a name can type it. Other scripts can also use exports.poggy_witnesses:TriggerAlertForPlayer(src, command).",
      "usage": "/<alert command>",
      "examples": [
        "/robbery198sd99720",
        "/graverobbing8x2kp19"
      ]
    },
    {
      "command": "/witness_shooting_alert",
      "configPath": "Config.Checks.Shooting.Command",
      "who": "Everyone",
      "description": "Fired by the script itself when a witness reports a shooting. The other crimes have their own: witness_threatening_alert, witness_melee_alert, witness_lassoing_alert, witness_trampling_alert, witness_hijacking_alert and witness_carrying_hostage_alert. A player who types one only reports themselves.",
      "usage": "/witness_shooting_alert",
      "examples": [
        "/witness_shooting_alert"
      ]
    },
    {
      "command": "/clearalerts",
      "who": "Everyone",
      "description": "Removes every alert blip on your map, including blips that wait for you to arrive, and clears your waypoint.",
      "usage": "/clearalerts",
      "examples": [
        "/clearalerts"
      ]
    },
    {
      "command": "/cleanalertblips",
      "who": "Everyone",
      "description": "Removes every alert blip on your map and tells you how many were removed. Your waypoint stays.",
      "usage": "/cleanalertblips",
      "examples": [
        "/cleanalertblips"
      ]
    },
    {
      "command": "/clearwaypoint",
      "who": "Everyone",
      "description": "Clears your GPS route and waypoint. /clearmarker does the same.",
      "usage": "/clearwaypoint",
      "examples": [
        "/clearwaypoint",
        "/clearmarker"
      ]
    },
    {
      "command": "/clearmarker",
      "who": "Everyone",
      "description": "Same as /clearwaypoint: clears your GPS route and waypoint.",
      "usage": "/clearmarker",
      "examples": [
        "/clearmarker"
      ]
    },
    {
      "command": "/getmyweaponhash_cl",
      "who": "Everyone",
      "description": "Diagnostic: prints the weapon you are holding, as the script sees it, to your F8 console. Useful when a weapon is or is not treated as threatening.",
      "usage": "/getmyweaponhash_cl",
      "examples": [
        "/getmyweaponhash_cl"
      ]
    },
    {
      "command": "/dumpalertgroups",
      "who": "ACE: command.dumpalertgroups",
