/* ============================================================================
   Commodities Exchange — TradingView-style UI
   Full-screen dark theme matching poggy_markets aesthetic
   ============================================================================ */

/* ── Exchange container ─────────────────────────────────────────────────── */
#exchange-container {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    background: var(--bg-primary);
    font-family: var(--font-body);
    color: var(--text-primary);
    overflow: hidden;
}

#exchange-container.hidden { display: none !important; }

/* ── Sidebar ────────────────────────────────────────────────────────────── */
.ex-sidebar {
    width: 220px;
    min-width: 220px;
    background: var(--bg-secondary);
    border-right: 1px solid var(--border-primary);
    display: flex;
    flex-direction: column;
    padding: 0;
}

.ex-sidebar-brand {
    padding: 24px 20px 20px;
    border-bottom: 1px solid var(--border-primary);
}

.ex-sidebar-brand h1 {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.5px;
    margin: 0 0 2px;
}

.ex-sidebar-brand span {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.ex-sidebar-nav {
    flex: 1;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.ex-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.15s ease;
    border: 1px solid transparent;
}

.ex-nav-item:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.ex-nav-item.active {
    background: var(--accent-bg);
    color: var(--accent);
    border-color: var(--border-accent);
}

.ex-nav-item svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    opacity: 0.7;
}

.ex-nav-item.active svg { opacity: 1; }

.ex-sidebar-footer {
    padding: 16px;
    border-top: 1px solid var(--border-primary);
}

.ex-balance-card {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: 14px;
}

.ex-balance-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 4px;
}

.ex-balance-amount {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    color: var(--green);
}

.ex-balance-actions {
    display: flex;
    gap: 6px;
    margin-top: 10px;
}

.ex-balance-actions button {
    flex: 1;
    padding: 6px;
    font-size: 11px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-body);
}

.ex-btn-deposit {
    background: var(--green-bg);
    color: var(--green);
    border-color: var(--green-border) !important;
}

.ex-btn-deposit:hover {
    background: rgba(52, 211, 153, 0.20);
}

.ex-btn-withdraw {
    background: var(--orange-bg);
    color: var(--orange);
    border-color: var(--orange-border) !important;
}

.ex-btn-withdraw:hover {
    background: rgba(251, 146, 60, 0.20);
}

/* ── Main content area ──────────────────────────────────────────────────── */
.ex-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.ex-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-secondary);
    min-height: 58px;
}

.ex-header-left {
    display: flex;
    align-items: center;
    gap: 16px;
}

.ex-header h2 {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    margin: 0;
}

.ex-search-box {
    position: relative;
}

.ex-search-box input {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    padding: 7px 12px 7px 32px;
    font-size: 12px;
    color: var(--text-primary);
    width: 220px;
    font-family: var(--font-body);
    transition: border-color 0.15s ease;
}

.ex-search-box input:focus {
    outline: none;
    border-color: var(--accent);
}

.ex-search-box input::placeholder {
    color: var(--text-muted);
}

.ex-search-box svg {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 14px;
    height: 14px;
    color: var(--text-muted);
}

.ex-header-right {
    display: flex;
    align-items: center;
    gap: 10px;
}

.ex-btn-close {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-secondary);
    color: var(--text-secondary);
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
}

.ex-btn-close:hover {
    background: var(--red-bg);
    color: var(--red);
    border-color: var(--red-border);
}

/* ── Filter tabs ────────────────────────────────────────────────────────── */
.ex-filter-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 24px;
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-primary);
}

.ex-filter-btn {
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 500;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-primary);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-body);
}

.ex-filter-btn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.ex-filter-btn.active {
    background: var(--accent-bg);
    color: var(--accent);
    border-color: var(--border-accent);
}

/* ── Content panels ─────────────────────────────────────────────────────── */
.ex-content {
    flex: 1;
    overflow-y: auto;
    padding: 0;
}

.ex-panel { display: none; height: 100%; }
.ex-panel.active { display: flex; flex-direction: column; }

/* ── Market table ───────────────────────────────────────────────────────── */
.ex-table-wrap {
    flex: 1;
    overflow-y: auto;
    padding: 0 0 20px;
}

.ex-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}

.ex-table thead {
    position: sticky;
    top: 0;
    z-index: 2;
}

.ex-table th {
    background: var(--bg-secondary);
    padding: 10px 16px;
    text-align: left;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-primary);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
}

.ex-table th:hover { color: var(--text-secondary); }

.ex-table th.sort-asc::after { content: ' ▲'; font-size: 9px; }
.ex-table th.sort-desc::after { content: ' ▼'; font-size: 9px; }

.ex-table td {
    padding: 10px 16px;
    border-bottom: 1px solid var(--border-primary);
    white-space: nowrap;
}

.ex-table tbody tr {
    transition: background 0.1s ease;
}

.ex-table tbody tr:hover {
    background: var(--bg-hover);
}

.ex-item-cell {
    display: flex;
    align-items: center;
    gap: 10px;
}

.ex-item-cell img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    border-radius: 4px;
    background: var(--bg-tertiary);
    padding: 2px;
}

.ex-item-name {
    font-weight: 500;
    color: var(--text-primary);
}

.ex-item-category {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 1px;
}

.ex-price {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 14px;
}

.ex-change {
    font-weight: 600;
    font-size: 12px;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    display: inline-block;
}

.ex-change.up {
    color: var(--green);
    background: var(--green-bg);
}

.ex-change.down {
    color: var(--red);
    background: var(--red-bg);
}

.ex-change.flat {
    color: var(--text-muted);
    background: var(--bg-tertiary);
}

.ex-action-btns {
    display: flex;
    gap: 6px;
}

.ex-btn {
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    border: 1px solid;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-body);
    white-space: nowrap;
}

.ex-btn-buy {
    background: var(--green-bg);
    color: var(--green);
    border-color: var(--green-border);
}
.ex-btn-buy:hover { background: rgba(52, 211, 153, 0.20); }

.ex-btn-short {
    background: var(--red-bg);
    color: var(--red);
    border-color: var(--red-border);
}
.ex-btn-short:hover { background: rgba(248, 113, 113, 0.20); }

.ex-btn-sell {
    background: var(--orange-bg);
    color: var(--orange);
    border-color: var(--orange-border);
}
.ex-btn-sell:hover { background: rgba(251, 146, 60, 0.20); }

.ex-btn-cover {
    background: var(--accent-bg);
    color: var(--accent);
    border-color: var(--border-accent);
}
.ex-btn-cover:hover { background: rgba(99, 140, 255, 0.20); }

/* deliver button removed — exchange is speculative only */

/* ── Portfolio summary cards ────────────────────────────────────────────── */
.ex-port-summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    padding: 20px 24px;
    border-bottom: 1px solid var(--border-primary);
}

.ex-stat-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: 16px;
}

.ex-stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-bottom: 6px;
}

.ex-stat-value {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
}

.ex-stat-value.positive { color: var(--green); }
.ex-stat-value.negative { color: var(--red); }
.ex-stat-value.neutral  { color: var(--text-primary); }

/* ── Portfolio position cards ───────────────────────────────────────────── */
.ex-port-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 16px;
    padding: 20px 24px;
    overflow-y: auto;
    max-height: calc(100vh - 280px);
}

.ex-port-empty {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 60px 20px;
    color: var(--text-muted);
    font-size: 14px;
}
.ex-port-empty svg { width: 40px; height: 40px; opacity: 0.3; }

.ex-port-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s;
}
.ex-port-card:hover { border-color: var(--border-secondary); }
.ex-port-card.card-profit { border-left: 3px solid var(--green); }
.ex-port-card.card-loss   { border-left: 3px solid var(--red); }

.ex-pc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px 16px 12px;
    border-bottom: 1px solid var(--border-primary);
}

.ex-pc-item {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}

.ex-pc-img {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--bg-tertiary);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.ex-pc-img img {
    width: 36px;
    height: 36px;
    object-fit: contain;
}

.ex-pc-name {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ex-pc-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 3px;
}

.ex-pc-pnl {
    text-align: right;
    flex-shrink: 0;
}
.ex-pc-pnl-value {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
}
.ex-pc-pnl.up .ex-pc-pnl-value { color: var(--green); }
.ex-pc-pnl.down .ex-pc-pnl-value { color: var(--red); }
.ex-pc-pnl.flat .ex-pc-pnl-value { color: var(--text-secondary); }
.ex-pc-pnl-pct {
    font-size: 11px;
    margin-top: 2px;
}
.ex-pc-pnl.up .ex-pc-pnl-pct { color: var(--green); }
.ex-pc-pnl.down .ex-pc-pnl-pct { color: var(--red); }
.ex-pc-pnl.flat .ex-pc-pnl-pct { color: var(--text-muted); }

.ex-pc-details {
    padding: 12px 16px;
}

.ex-pc-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 5px 0;
    font-size: 13px;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(255,255,255,0.03);
}
.ex-pc-row:last-child { border-bottom: none; }
.ex-pc-row span:last-child { color: var(--text-primary); font-weight: 500; }

.ex-pc-current { font-family: var(--font-heading); font-weight: 600; }

/* Take-profit row */
.ex-pc-tp-row {
    padding: 8px 0 4px;
}
.ex-pc-tp-row.tp-hit {
    background: rgba(34, 197, 94, 0.08);
    border-radius: var(--radius-sm);
    padding: 8px 6px 4px;
    margin: 0 -6px;
}
.ex-pc-tp-input-wrap {
    display: flex;
    align-items: center;
    gap: 4px;
}
.ex-pc-tp-prefix {
    color: var(--text-muted);
    font-size: 13px;
}
.ex-pc-tp-input {
    width: 80px;
    padding: 4px 6px;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-size: 13px;
    font-family: var(--font-heading);
    text-align: right;
    outline: none;
}
.ex-pc-tp-input:focus { border-color: var(--accent); }
.ex-pc-tp-input::placeholder { color: var(--text-muted); }

.ex-pc-tp-set {
    padding: 4px 10px;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    background: var(--bg-tertiary);
    color: var(--accent);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}
.ex-pc-tp-set:hover {
    background: var(--accent-bg);
    border-color: var(--border-accent);
}

.ex-pc-actions {
    display: flex;
    gap: 8px;
    padding: 0 16px 16px;
}
.ex-pc-actions .ex-btn {
    flex: 1;
    text-align: center;
    justify-content: center;
}

/* ── Trade modal overlay ────────────────────────────────────────────────── */
.ex-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100000;
    backdrop-filter: blur(4px);
}

.ex-modal-overlay.hidden { display: none !important; }

.ex-modal {
    background: var(--bg-secondary);
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-lg);
    width: 400px;
    max-width: 90vw;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
    overflow: hidden;
}

.ex-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border-primary);
}

.ex-modal-header h3 {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    margin: 0;
}

.ex-modal-close {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
}
.ex-modal-close:hover { color: var(--text-primary); }

.ex-modal-body {
    padding: 20px;
}

.ex-modal-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
}

.ex-modal-row-label {
    font-size: 13px;
    color: var(--text-secondary);
}

.ex-modal-row-value {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
}

.ex-modal-input-group {
    margin: 14px 0;
}

.ex-modal-input-group label {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
}

.ex-modal-input-group input {
    width: 100%;
    padding: 10px 14px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 14px;
    font-family: var(--font-heading);
    font-weight: 600;
    transition: border-color 0.15s ease;
}

.ex-modal-input-group input:focus {
    outline: none;
    border-color: var(--accent);
}

.ex-modal-summary {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: 14px;
    margin-top: 14px;
}

.ex-modal-summary-row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    font-size: 13px;
}

.ex-modal-summary-row.total {
    border-top: 1px solid var(--border-primary);
    margin-top: 6px;
    padding-top: 8px;
    font-weight: 700;
    font-size: 14px;
}

.ex-modal-summary-row.note,
.ex-ct-summary-row.note {
    color: #f59e0b;
    font-size: 12px;
    font-style: italic;
}

.ex-modal-footer {
    padding: 16px 20px;
    border-top: 1px solid var(--border-primary);
    display: flex;
    gap: 8px;
}

.ex-modal-footer button {
    flex: 1;
    padding: 10px;
    font-size: 13px;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: 1px solid;
    cursor: pointer;
    font-family: var(--font-body);
    transition: all 0.15s ease;
}

.ex-modal-cancel {
    background: var(--bg-tertiary);
    border-color: var(--border-secondary) !important;
    color: var(--text-secondary);
}
.ex-modal-cancel:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.ex-modal-confirm-buy {
    background: var(--green-bg);
    border-color: var(--green-border) !important;
    color: var(--green);
}
.ex-modal-confirm-buy:hover { background: rgba(52, 211, 153, 0.25); }

.ex-modal-confirm-short {
    background: var(--red-bg);
    border-color: var(--red-border) !important;
    color: var(--red);
}
.ex-modal-confirm-short:hover { background: rgba(248, 113, 113, 0.25); }

.ex-modal-confirm-sell {
    background: var(--orange-bg);
    border-color: var(--orange-border) !important;
    color: var(--orange);
}
.ex-modal-confirm-sell:hover { background: rgba(251, 146, 60, 0.25); }

.ex-modal-confirm-cover {
    background: var(--accent-bg);
    border-color: var(--border-accent) !important;
    color: var(--accent);
}
.ex-modal-confirm-cover:hover { background: rgba(99, 140, 255, 0.25); }

/* ── Notification toasts ────────────────────────────────────────────────── */
.ex-toast-container {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 100001;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
}

.ex-toast {
    padding: 12px 18px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 500;
    pointer-events: auto;
    animation: exToastIn 0.25s ease forwards;
    max-width: 360px;
    border: 1px solid;
}

.ex-toast.success {
    background: var(--green-bg);
    color: var(--green);
    border-color: var(--green-border);
}

.ex-toast.error {
    background: var(--red-bg);
    color: var(--red);
    border-color: var(--red-border);
}

.ex-toast.fade-out {
    animation: exToastOut 0.3s ease forwards;
}

@keyframes exToastIn {
    from { opacity: 0; transform: translateX(30px); }
    to   { opacity: 1; transform: translateX(0); }
}

@keyframes exToastOut {
    from { opacity: 1; transform: translateX(0); }
    to   { opacity: 0; transform: translateX(30px); }
}

/* ── Account page ───────────────────────────────────────────────────────── */
.ex-account-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 24px;
}

.ex-account-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: 20px;
}

.ex-account-card h3 {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 16px;
    color: var(--text-primary);
}

.ex-account-input-row {
    display: flex;
    gap: 8px;
    margin-top: 12px;
}

.ex-account-input-row input {
    flex: 1;
    padding: 8px 12px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 13px;
    font-family: var(--font-body);
}

.ex-account-input-row input:focus {
    outline: none;
    border-color: var(--accent);
}

.ex-account-input-row button {
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    border: 1px solid;
    cursor: pointer;
    font-family: var(--font-body);
    transition: all 0.15s ease;
    white-space: nowrap;
}

/* ── Trade history ──────────────────────────────────────────────────────── */
.ex-history-table {
    padding: 0 24px 24px;
    flex: 1;
    overflow-y: auto;
}

.ex-type-badge {
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

.ex-type-badge.buy   { background: var(--green-bg); color: var(--green); }
.ex-type-badge.sell   { background: var(--orange-bg); color: var(--orange); }
.ex-type-badge.short  { background: var(--red-bg); color: var(--red); }
.ex-type-badge.cover  { background: var(--accent-bg); color: var(--accent); }
.ex-type-badge.deliver { background: var(--bg-elevated); color: var(--text-secondary); }

/* ── Scrollbar styling ──────────────────────────────────────────────────── */
#exchange-container ::-webkit-scrollbar { width: 6px; }
#exchange-container ::-webkit-scrollbar-track { background: transparent; }
#exchange-container ::-webkit-scrollbar-thumb {
    background: var(--bg-active);
    border-radius: 3px;
}
#exchange-container ::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
}

/* ── Empty state ────────────────────────────────────────────────────────── */
.ex-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px;
    color: var(--text-muted);
    font-size: 14px;
    gap: 8px;
}

.ex-empty svg {
    width: 40px;
    height: 40px;
    opacity: 0.3;
    margin-bottom: 8px;
}

/* Market type badge */
.ex-market-badge {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 2px 6px;
    border-radius: 3px;
}

.ex-market-badge.pelt {
    background: rgba(251, 191, 36, 0.12);
    color: var(--yellow);
}

.ex-market-badge.metal {
    background: rgba(99, 140, 255, 0.12);
    color: var(--accent);
}

/* ── Chart panel ────────────────────────────────────────────────────────── */
/* Use .active gating so it stays hidden when another tab is active.
   ID specificity is needed because #id > .class in CSS. */
#ex-panel-chart {
    display: none;           /* hidden by default (matches .ex-panel) */
    flex-direction: column;
    height: 100%;
    padding: 0;
}
#ex-panel-chart.active {
    display: flex;           /* show only when active */
}

.ex-chart-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-secondary);
    gap: 12px;
    flex-shrink: 0;
}

.ex-chart-toolbar-left {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1;
    min-width: 0;
}

.ex-chart-toolbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
}

/* ── Search autocomplete ────────────────────────────────────────────────── */
.ex-chart-search-wrap {
    position: relative;
    min-width: 240px;
}

.ex-chart-search-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.4;
    pointer-events: none;
}

.ex-chart-search {
    width: 100%;
    padding: 7px 12px 7px 30px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 13px;
    font-family: var(--font-body);
    font-weight: 500;
    box-sizing: border-box;
}

.ex-chart-search:focus {
    outline: none;
    border-color: var(--accent);
}

.ex-chart-search::placeholder { color: var(--text-muted); }

.ex-chart-ac {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-top: none;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    max-height: 240px;
    overflow-y: auto;
    z-index: 100;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
}

.ex-chart-ac.open { display: block; }

.ex-chart-ac-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    cursor: pointer;
    font-size: 12px;
    color: var(--text-secondary);
    transition: background 0.1s;
}

.ex-chart-ac-item:hover,
.ex-chart-ac-item.highlighted {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.ex-chart-ac-item img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    border-radius: 2px;
}

.ex-chart-ac-name {
    flex: 1;
    font-weight: 500;
}

.ex-chart-ac-badge {
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 1px 5px;
    border-radius: 3px;
    letter-spacing: 0.3px;
}
.ex-chart-ac-badge.pelt {
    background: rgba(251,191,36,0.12);
    color: var(--yellow);
}
.ex-chart-ac-badge.metal {
    background: rgba(99,140,255,0.12);
    color: var(--accent);
}

.ex-chart-ac-price {
    font-family: var(--font-mono, var(--font-body));
    font-size: 11px;
    color: var(--text-muted);
}

/* ── Chart body (chart area + trade sidebar) ────────────────────────────── */
.ex-chart-body {
    flex: 1;
    display: flex;
    min-height: 0;
}

.ex-chart-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.ex-chart-current-price {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    font-family: var(--font-mono, var(--font-body));
    letter-spacing: -0.5px;
}

.ex-chart-range-btns {
    display: flex;
    gap: 2px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-sm);
    padding: 2px;
    border: 1px solid var(--border-primary);
}

.ex-chart-range-btn {
    padding: 5px 12px;
    background: transparent;
    border: none;
    border-radius: 3px;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.15s ease;
    letter-spacing: 0.3px;
}

.ex-chart-range-btn:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
}

.ex-chart-range-btn.active {
    background: var(--accent-bg);
    color: var(--accent);
}

.ex-chart-wrapper {
    flex: 1;
    position: relative;
    min-height: 0;
    padding: 16px 20px;
}

.ex-chart-wrapper canvas {
    width: 100% !important;
    height: 100% !important;
    cursor: crosshair;
}

.ex-chart-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    gap: 12px;
}

.ex-chart-empty svg { opacity: 0.2; }
.ex-chart-empty p { font-size: 14px; margin: 0; opacity: 0.6; }
.ex-chart-empty.hidden { display: none; }

.ex-chart-info-bar {
    display: flex;
    gap: 24px;
    padding: 10px 20px;
    border-top: 1px solid var(--border-primary);
    background: var(--bg-secondary);
    flex-shrink: 0;
}

.ex-chart-info-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
}

.ex-chart-info-label {
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 10px;
}

.ex-chart-info-item span:last-child {
    color: var(--text-primary);
    font-weight: 600;
    font-family: var(--font-mono, var(--font-body));
}

/* ── Trade sidebar (right of chart) ─────────────────────────────────────── */
.ex-chart-trade {
    width: 260px;
    min-width: 260px;
    background: var(--bg-secondary);
    border-left: 1px solid var(--border-primary);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
}

.ex-ct-header {
    padding: 16px 16px 12px;
    border-bottom: 1px solid var(--border-primary);
}

.ex-ct-header h3 {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 4px;
}

.ex-ct-item-label {
    font-size: 11px;
    color: var(--text-muted);
}

.ex-ct-tabs {
    display: flex;
    border-bottom: 1px solid var(--border-primary);
}

.ex-ct-tab {
    flex: 1;
    padding: 10px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.15s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.ex-ct-tab:hover { color: var(--text-primary); }

.ex-ct-tab.active[data-ct-action="buy"] {
    color: #22c55e;
    border-bottom-color: #22c55e;
}

.ex-ct-tab.active[data-ct-action="short"] {
    color: #ef4444;
    border-bottom-color: #ef4444;
}

.ex-ct-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.ex-ct-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
}

.ex-ct-label { color: var(--text-muted); font-weight: 500; }
.ex-ct-value { color: var(--text-primary); font-weight: 600; font-family: var(--font-mono, var(--font-body)); }

.ex-ct-input-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.ex-ct-input-group label {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

.ex-ct-input-group input {
    padding: 8px 10px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 13px;
    font-family: var(--font-body);
    text-align: center;
}

.ex-ct-input-group input:focus {
    outline: none;
    border-color: var(--accent);
}

.ex-ct-summary {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 0;
    border-top: 1px solid var(--border-primary);
    border-bottom: 1px solid var(--border-primary);
}

.ex-ct-summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-muted);
}

.ex-ct-summary-row.total {
    font-weight: 700;
    font-size: 12px;
    color: var(--text-primary);
    padding-top: 6px;
    margin-top: 2px;
    border-top: 1px solid var(--border-primary);
}

.ex-ct-confirm {
    width: 100%;
    padding: 10px;
    border: none;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.15s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.ex-ct-confirm.buy {
    background: rgba(34,197,94,0.15);
    color: #22c55e;
    border: 1px solid rgba(34,197,94,0.3);
}
.ex-ct-confirm.buy:hover { background: rgba(34,197,94,0.25); }

.ex-ct-confirm.short {
    background: rgba(239,68,68,0.15);
    color: #ef4444;
    border: 1px solid rgba(239,68,68,0.3);
}
.ex-ct-confirm.short:hover { background: rgba(239,68,68,0.25); }

/* ── Position info in trade sidebar ─────────────────────────────────────── */
.ex-ct-position h4 {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    margin: 0 0 10px;
}

.ex-ct-divider {
    height: 1px;
    background: var(--border-primary);
    margin: 12px 0;
}

.ex-ct-position {
    padding: 0 16px 16px;
}

.ex-ct-pos-actions {
    display: flex;
    gap: 6px;
    margin-top: 10px;
}

.ex-ct-pos-btn {
    flex: 1;
    padding: 7px 8px;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
}

.ex-ct-pos-btn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.ex-ct-pos-btn.sell { color: #f59e0b; border-color: rgba(245,158,11,0.3); }
.ex-ct-pos-btn.sell:hover { background: rgba(245,158,11,0.1); }
.ex-ct-pos-btn.cover { color: #638cff; border-color: rgba(99,140,255,0.3); }
.ex-ct-pos-btn.cover:hover { background: rgba(99,140,255,0.1); }

/* Item name clickable in market table to open chart */
#ex-market-table .ex-item-name {
    cursor: pointer;
    transition: color 0.15s ease;
}
#ex-market-table .ex-item-name:hover {
    color: var(--accent);
    text-decoration: underline;
}
