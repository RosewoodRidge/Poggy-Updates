/* ================================================================
   Poggy theme skin: poggy_core (its own page, ui/index.html)

   Covers:
   - the menu every Poggy script opens (menu.open): panel, title, rule,
     rows (hover, selected, disabled), right-hand column, description,
     count, key hints, Close button;
   - the text input (input.open): field, invalid state, note, buttons;
   - the /poggy settings hub: top bar, search, home (masthead, stats,
     filter chips, script cards), script page (header, banners, rail,
     panels, every field control), lists and tables, the row drawer,
     collections, key tables, data panels, commands, help, history,
     roles, the save bar, toasts, modals, popovers, pickers, tooltips,
     the palette, and the item-check reds and yellows.

   The hub keeps its colours in --ph-* variables on #poggy-hub and the
   menu in :root variables (style.css), so those are re-pointed first;
   the rules below fix what hub.css names directly (hovers, tints,
   shadows, badges, pills, the breathe / pulse / flash animations).

   Fonts: the hub's base text (descriptions, values, tables, prose) is
   --pg-font-body; titles, labels, tabs, buttons, badges are
   --pg-font-display at weight 400 (IM Fell has one weight); code stays
   --pg-font-mono.

   Left alone on purpose:
   - the hub's backdrop picture (img/backdrop.webp) and the script art
     (icons, the monogram tiles and their --mono colour);
   - category colours (--cat: chips' dots, card glows, the line under a
     script header), set inline by hub-pages.js: a category's identity;
   - colour swatches of a colour setting (inline, the owner's data).
   ================================================================ */

/* ── The menu and the text input (style.css) ───────────────────── */

html.pg-themed {
    --gold:          var(--pg-accent);
    --gold-light:    var(--pg-accent-hi);
    --gold-dim:      var(--pg-accent-soft);
    --amber:         var(--pg-accent);
    --bg-panel:      var(--pg-panel);
    --bg-item:       var(--pg-surface);
    --bg-hover:      var(--pg-surface-hover);
    --bg-selected:   var(--pg-surface-hover);
    --bg-input:      var(--pg-input-bg);
    --bg-btn:        var(--pg-btn-bg);
    --bg-btn-hover:  var(--pg-btn-bg-hover);
    --border:        var(--pg-border);
    --border-strong: var(--pg-accent-soft);
    --text:          var(--pg-text);
    --text-muted:    var(--pg-text-muted);
    --text-dim:      var(--pg-text-dim);
    --text-on-gold:  var(--pg-on-accent);
    --text-input:    var(--pg-text);
    --red:           var(--pg-danger);
    --shadow:        rgba(var(--pg-shade-rgb), 0.45);
    --glow:          transparent;
    --glow-strong:   transparent;
    --font-heading:  var(--pg-font-display);
    --font-body:     var(--pg-font-body);
    --radius:        var(--pg-radius);
    --radius-sm:     var(--pg-radius-sm);
}

html.pg-themed .pg-panel {
    background: var(--pg-panel-bg);
    border: 1px solid var(--pg-border);
    border-radius: var(--pg-radius);
    box-shadow: var(--pg-shadow);
}

html.pg-themed .pg-title {
    font-family: var(--pg-font-display);
    font-weight: 400;
    letter-spacing: .06em;
    color: var(--pg-text);
    text-shadow: none;
}
html.pg-themed .pg-subtitle { font-family: var(--pg-font-body); color: var(--pg-text-muted); }

html.pg-themed .pg-rule {
    background: linear-gradient(90deg, transparent, var(--pg-border-strong) 20%, var(--pg-border-strong) 80%, transparent);
}
html.pg-themed .pg-rule::after { background: var(--pg-accent); box-shadow: 0 0 0 2px var(--pg-panel-solid); }

html.pg-themed .pg-item {
    background: var(--pg-surface);
    border: 1px solid var(--pg-border-soft);
    border-radius: var(--pg-radius-sm);
}
html.pg-themed .pg-item:hover:not(.disabled) { background: var(--pg-surface-hover); border-color: var(--pg-accent-soft); }
html.pg-themed .pg-item.selected {
    background: var(--pg-surface-hover);
    border-color: var(--pg-accent-soft);
    box-shadow: inset 0 0 0 1px var(--pg-accent-soft);
}
html.pg-themed .pg-item.selected::before { background: var(--pg-accent); border-radius: 0; }
html.pg-themed .pg-item.selected .pg-label { color: var(--pg-accent-hi); }
html.pg-themed .pg-item.disabled .pg-label { color: var(--pg-text-muted); }

html.pg-themed .pg-label { font-family: var(--pg-font-display); color: var(--pg-text); }
html.pg-themed .pg-right { font-family: var(--pg-font-body); letter-spacing: .02em; color: var(--pg-accent); }

html.pg-themed .pg-desc {
    font-family: var(--pg-font-body);
    color: var(--pg-text-muted);
    border-top-color: var(--pg-border-soft);
}

html.pg-themed .pg-count { font-family: var(--pg-font-body); color: var(--pg-text-dim); }
html.pg-themed .pg-hint { font-family: var(--pg-font-body); color: var(--pg-text-dim); }
html.pg-themed .pg-hint span {
    font-family: var(--pg-font-body);
    color: var(--pg-text-muted);
    border-color: var(--pg-border);
    border-radius: var(--pg-radius-sm);
    background: var(--pg-surface);
}

html.pg-themed .pg-btn {
    background: var(--pg-btn-bg);
    border: 1px solid var(--pg-btn-border);
    border-radius: var(--pg-radius-sm);
    color: var(--pg-text);
    font-family: var(--pg-font-display);
    font-weight: 400;
    letter-spacing: .07em;
    box-shadow: none;
}
html.pg-themed .pg-btn:hover { background: var(--pg-btn-bg-hover); border-color: var(--pg-accent-soft); color: var(--pg-text); }
html.pg-themed .pg-btn-primary,
html.pg-themed .pg-btn-primary:hover {
    background: var(--pg-btn-primary-bg);
    border-color: var(--pg-accent-soft);
    color: var(--pg-text);
    box-shadow: none;
}
html.pg-themed .pg-btn-primary:hover { border-color: var(--pg-accent); }

html.pg-themed #pg-input-field {
    background: var(--pg-input-bg);
    border: 1px solid var(--pg-input-border);
    border-radius: var(--pg-radius-sm);
    color: var(--pg-text);
    font-family: var(--pg-font-body);
}
html.pg-themed #pg-input-field:focus { border-color: var(--pg-accent); box-shadow: var(--pg-focus-ring); }
html.pg-themed #pg-input-field::placeholder { color: var(--pg-text-dim); }
html.pg-themed #pg-input-field.invalid { border-color: var(--pg-danger); box-shadow: 0 0 0 1px rgba(var(--pg-danger-rgb), 0.35); }
html.pg-themed .pg-input-note { font-family: var(--pg-font-body); color: var(--pg-text-dim); }
html.pg-themed .pg-input-note.error { color: var(--pg-danger); }

/* ── The settings hub (hub.css): its variables ─────────────────── */

html.pg-themed #poggy-hub {
    --ph-bg:          rgb(var(--pg-deep-rgb));
    --ph-panel:       var(--pg-panel);
    --ph-panel-solid: var(--pg-panel-solid);
    --ph-panel-hi:    var(--pg-raise);
    --ph-field:       var(--pg-input-bg);
    --ph-hover:       rgba(var(--pg-text-rgb), 0.035);

    --ph-rule:        rgba(var(--pg-text-rgb), 0.11);
    --ph-rule-strong: rgba(var(--pg-text-rgb), 0.24);

    --ph-ink:         var(--pg-text);
    --ph-ink-soft:    rgba(var(--pg-text-rgb), 0.76);
    --ph-ink-faint:   rgba(var(--pg-text-rgb), 0.56);
    --ph-ink-dim:     rgba(var(--pg-text-rgb), 0.36);
    --ph-tan:         var(--pg-accent-hi);

    --ph-clay:        var(--pg-accent);
    --ph-clay-lift:   var(--pg-accent-hi);
    --ph-clay-soft:   rgba(var(--pg-accent-rgb), 0.16);
    --ph-brass:       var(--pg-warning);
    --ph-brass-soft:  var(--pg-warning-soft);
    --ph-green:       var(--pg-success);
    --ph-go:          var(--pg-success);
    --ph-go-lift:     var(--pg-success);
    --ph-crimson:     var(--pg-danger);
    --ph-crimson-lift:var(--pg-danger);
    --ph-blue:        var(--pg-info);

    --ph-serif:  var(--pg-font-body);
    --ph-mono:   var(--pg-font-mono);
    --ph-radius: var(--pg-radius);
    --ph-shadow: var(--pg-shadow);

    --ph-bad-ink:   var(--pg-danger);
    --ph-bad-line:  rgba(var(--pg-danger-rgb), 0.70);
    --ph-bad-tint:  rgba(var(--pg-danger-rgb), 0.10);
    --ph-warn:      var(--pg-warning);
    --ph-warn-ink:  var(--pg-warning);
    --ph-warn-line: rgba(var(--pg-warning-rgb), 0.65);
    --ph-warn-tint: rgba(var(--pg-warning-rgb), 0.08);
}

