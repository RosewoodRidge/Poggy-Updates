html.pg-themed .ph .ph-doc h4, html.pg-themed .ph .ph-doc h5, html.pg-themed .ph .ph-doc h6 { color: var(--pg-accent); }
html.pg-themed .ph .ph-doc code { color: var(--pg-accent-hi); background: var(--pg-surface-hover); border-color: var(--pg-border-soft); border-radius: var(--pg-radius-sm); }
html.pg-themed .ph .ph-doc .ph-md-pre { border-color: var(--pg-border-soft); border-left-color: var(--pg-accent); }
html.pg-themed .ph .ph-doc .ph-md-pre code { background: none; border: 0; color: var(--pg-text); }
html.pg-themed .ph .ph-doc li::marker { color: var(--pg-accent); }
html.pg-themed .ph .ph-doc blockquote { border-left-color: var(--pg-warning); border-radius: 0; }
html.pg-themed .ph .ph-md-check.is-done { background: var(--pg-success); border-color: var(--pg-success); }
html.pg-themed .ph .ph-toc__item:hover { color: var(--pg-accent); }

html.pg-themed .ph .ph-diff__old { color: var(--pg-danger); text-decoration-color: rgba(var(--pg-danger-rgb), 0.5); }
html.pg-themed .ph .ph-diff__new { color: var(--pg-success); }
html.pg-themed .ph .ph-opbadge { border-radius: var(--pg-radius-sm); }
html.pg-themed .ph .ph-opbadge--set { color: var(--pg-accent); border-color: var(--pg-accent-soft); }
html.pg-themed .ph .ph-opbadge--insert,
html.pg-themed .ph .ph-opbadge--duplicate { color: var(--pg-success); border-color: rgba(var(--pg-success-rgb), 0.5); }
html.pg-themed .ph .ph-opbadge--remove { color: var(--pg-danger); border-color: rgba(var(--pg-danger-rgb), 0.5); }
html.pg-themed .ph .ph-opbadge--reset,
html.pg-themed .ph .ph-opbadge--linkRole,
html.pg-themed .ph .ph-opbadge--unlinkRole { color: var(--pg-warning); border-color: rgba(var(--pg-warning-rgb), 0.5); }

/* ── Save bar, toasts ───────────────────────────────────────────── */

html.pg-themed .ph .ph-savebar__inner {
    background: var(--pg-popup-bg);
    border-color: var(--pg-accent-soft);
    border-radius: var(--pg-radius);
    box-shadow: var(--pg-shadow-strong);
}
html.pg-themed .ph .ph-savebar__dot { background: var(--pg-accent); animation-name: pg-core-pulse-accent; }
@keyframes pg-core-pulse-accent {
    0%   { box-shadow: 0 0 0 0 rgba(var(--pg-accent-rgb), 0.55); }
    70%  { box-shadow: 0 0 0 .5rem rgba(var(--pg-accent-rgb), 0); }
    100% { box-shadow: 0 0 0 0 rgba(var(--pg-accent-rgb), 0); }
}

html.pg-themed .ph .ph-toast {
    background: var(--pg-popup-bg);
    border-color: var(--pg-border);
    border-left-color: var(--pg-info);
    border-radius: var(--pg-radius);
    box-shadow: var(--pg-shadow-strong);
}
html.pg-themed .ph .ph-toast--success { border-left-color: var(--pg-success); }
html.pg-themed .ph .ph-toast--success .ph-toast__ico { color: var(--pg-success); }
html.pg-themed .ph .ph-toast--error { border-left-color: var(--pg-danger); }
html.pg-themed .ph .ph-toast--error .ph-toast__ico { color: var(--pg-danger); }
html.pg-themed .ph .ph-toast--warning { border-left-color: var(--pg-warning); }

/* ── Overlays: modals, popovers, tooltips, palette ──────────────── */

html.pg-themed .ph .ph-scrim { background: var(--pg-veil); }
html.pg-themed .ph .ph-busy { background: rgba(var(--pg-shade-rgb), 0.5); }

html.pg-themed .ph .ph-modal,
html.pg-themed .ph .ph-palette {
    background: var(--pg-popup-bg);
    border-color: var(--pg-border);
    border-radius: var(--pg-radius);
    box-shadow: var(--pg-shadow-strong);
}
html.pg-themed .ph .ph-modal { border-top-color: var(--pg-accent); }
html.pg-themed .ph .ph-modal--danger { border-top-color: var(--pg-danger); }
html.pg-themed .ph .ph-modal--warn { border-top-color: var(--pg-warning); }
html.pg-themed .ph .ph-modal__ico { color: var(--pg-accent); }
html.pg-themed .ph .ph-modal--danger .ph-modal__ico { color: var(--pg-danger); }
html.pg-themed .ph .ph-modal__foot { border-top-color: var(--pg-border-soft); }

html.pg-themed .ph .ph-pop,
html.pg-themed .ph .ph-tip,
html.pg-themed .ph .ph-busy__box {
    background: var(--pg-popup-bg);
    border-color: var(--pg-border);
    border-radius: var(--pg-radius);
    box-shadow: var(--pg-shadow-strong);
}
html.pg-themed .ph .ph-tip { font-family: var(--pg-font-body); }
html.pg-themed .ph .ph-tip__row b { color: var(--pg-accent); }

html.pg-themed .ph .ph-menu__item,
html.pg-themed .ph .ph-pick__row,
html.pg-themed .ph .ph-hit { border-radius: var(--pg-radius-sm); }
html.pg-themed .ph .ph-menu__item:hover,
html.pg-themed .ph .ph-menu__item:focus { background: var(--pg-surface-hover); color: var(--pg-text); }
html.pg-themed .ph .ph-menu__item.is-active,
html.pg-themed .ph .ph-menu__item.is-active .ph-ico { color: var(--pg-accent); }
html.pg-themed .ph .ph-menu__item.is-danger { color: var(--pg-danger); }
html.pg-themed .ph .ph-pick__row.is-sel,
html.pg-themed .ph .ph-hit.is-sel,
html.pg-themed .ph .ph-hits .ph-hit:hover { background: var(--pg-accent-faint); }
html.pg-themed .ph .ph-hit.is-sel .ph-hit__label { color: var(--pg-accent); }
html.pg-themed .ph .ph-hit__ico { background: var(--pg-slot-bg); border-color: var(--pg-border-soft); border-radius: var(--pg-radius-sm); }
html.pg-themed .ph .ph-palette__bar > .ph-ico { color: var(--pg-accent); }
html.pg-themed .ph .ph-palette__bar { border-bottom-color: var(--pg-border); }

html.pg-themed .ph .ph-spinner { border-color: rgba(var(--pg-text-rgb), 0.15); border-top-color: var(--pg-accent); }

/* ── Roles ──────────────────────────────────────────────────────── */

html.pg-themed .ph .ph-rolecard:hover { border-color: var(--pg-accent-soft); }
html.pg-themed .ph .ph-rolecard.is-on {
    border-color: var(--pg-accent-soft);
    background: var(--pg-raise);
    box-shadow: inset 3px 0 0 var(--pg-accent), inset 0 0 0 1px var(--pg-accent-soft);
}
html.pg-themed .ph .ph-rolecard__ico {
    border-radius: var(--pg-radius-sm);
    background: var(--pg-slot-bg);
    border-color: var(--pg-border);
    color: var(--pg-accent);
}

/* ── Skeleton ───────────────────────────────────────────────────── */

html.pg-themed .ph .ph-skel__block,
html.pg-themed .ph .ph-skel__line {
    border-radius: var(--pg-radius-sm);
    background: linear-gradient(90deg, rgba(var(--pg-text-rgb), 0.05) 0%, rgba(var(--pg-text-rgb), 0.11) 40%, rgba(var(--pg-text-rgb), 0.05) 80%);
    background-size: 200% 100%;
}

/* ── Crumbs, tab pages ──────────────────────────────────────────── */

html.pg-themed .ph .ph-crumbs__item:hover { color: var(--pg-accent-hi); }
html.pg-themed .ph .ph-crumbs__item.is-current { color: var(--pg-accent); }
html.pg-themed .ph .ph-crumbs__item.is-current.is-script { color: var(--pg-text); }
html.pg-themed .ph .ph-tabhead__title .ph-ico,
html.pg-themed .ph .ph-sechead .ph-ico,
html.pg-themed .ph .ph-searchres__trail .ph-ico,
html.pg-themed .ph .ph-panelv .ph-list__title > .ph-ico,
html.pg-themed .ph .ph-report__row .ph-ico { color: var(--pg-accent); }

/* ── Item checks (red: missing; yellow: something is off) ──────── */

html.pg-themed .ph .ph-list__warn {
    background: var(--pg-danger-soft);
    border-color: rgba(var(--pg-danger-rgb), 0.45);
    border-radius: var(--pg-radius-sm);
}
html.pg-themed .ph .ph-list__warn > .ph-ico,
html.pg-themed .ph .ph-warnline,
html.pg-themed .ph .ph-cellbad,
html.pg-themed .ph .ph-ref__note,
html.pg-themed .ph .ph-ref__note .ph-ico,
html.pg-themed .ph .ph-itemta.is-bad .ph-itemta__img .ph-ico { color: var(--pg-danger); }
html.pg-themed .ph .ph-picked.is-unknown { border-color: rgba(var(--pg-danger-rgb), 0.8); background: rgba(var(--pg-danger-rgb), 0.08); }
html.pg-themed .ph .ph-picked.is-unknown .ph-picked__label,
html.pg-themed .ph .ph-picked.is-unknown .ph-picked__face > .ph-ico { color: var(--pg-danger); }
html.pg-themed .ph .ph-chip.is-bad { border-color: rgba(var(--pg-danger-rgb), 0.7); background: rgba(var(--pg-danger-rgb), 0.14); color: var(--pg-danger); }
html.pg-themed .ph .ph-chip.is-warn { background: rgba(var(--pg-warning-rgb), 0.12); }
html.pg-themed .ph .ph-usedby { border-radius: var(--pg-radius-sm); border-color: rgba(var(--pg-warning-rgb), 0.40); }
html.pg-themed .ph .ph-usedby:hover { color: var(--pg-accent-hi); border-color: var(--pg-accent-soft); }
html.pg-themed .ph .ph-usedby.is-none { border-color: var(--pg-border-strong); }

html.pg-themed .ph .ph-itemta.is-warn .ph-itemta__input { box-shadow: 0 0 0 1px rgba(var(--pg-warning-rgb), 0.35); }
html.pg-themed .ph .ph-itemta.is-bad .ph-itemta__input { border-color: var(--pg-danger); box-shadow: 0 0 0 1px rgba(var(--pg-danger-rgb), 0.45); }
html.pg-themed .ph .ph-icchip,
html.pg-themed .ph .ph-rowflag,
html.pg-themed .ph .ph-diagsum,
html.pg-themed .ph .ph-flagchip,
html.pg-themed .ph .ph-flagchip__n,
html.pg-themed .ph .ph-livetag { border-radius: var(--pg-radius-sm); }
html.pg-themed .ph .ph-icchip.is-bad { background: rgba(var(--pg-danger-rgb), 0.18); }
html.pg-themed .ph .ph-icchip.is-warn { background: rgba(var(--pg-warning-rgb), 0.12); }
html.pg-themed .ph .ph-itemfix { color: var(--pg-on-accent); background: var(--pg-accent); border-radius: var(--pg-radius-sm); }
html.pg-themed .ph .ph-itemfix:hover { background: var(--pg-accent-hi); }
html.pg-themed .ph .ph-row.is-itembad:hover td { background: rgba(var(--pg-danger-rgb), 0.15); }
html.pg-themed .ph .ph-row.is-itemwarn:hover td { background: rgba(var(--pg-warning-rgb), 0.12); }
html.pg-themed .ph .ph-rowflag.is-bad { background: rgba(var(--pg-danger-rgb), 0.18); }
html.pg-themed .ph .ph-rowflag.is-warn { background: rgba(var(--pg-warning-rgb), 0.13); }
html.pg-themed .ph .ph-flagchip:hover { color: var(--pg-accent-hi); border-color: var(--pg-accent-soft); }
html.pg-themed .ph .ph-flagchip.is-on { color: var(--pg-accent); border-color: var(--pg-accent-soft); background: var(--pg-accent-faint); }
html.pg-themed .ph .ph-flagchip.is-bad.is-on { color: var(--pg-danger); border-color: var(--ph-bad-line); background: rgba(var(--pg-danger-rgb), 0.18); }
html.pg-themed .ph .ph-flagchip.is-warn.is-on { color: var(--pg-warning); border-color: var(--ph-warn-line); background: rgba(var(--pg-warning-rgb), 0.14); }
html.pg-themed .ph .ph-flagchip__n { background: var(--pg-surface-hover); }
html.pg-themed .ph .ph-diagsum { background: rgba(var(--pg-warning-rgb), 0.12); }
html.pg-themed .ph button.ph-diagsum:hover { background: rgba(var(--pg-warning-rgb), 0.20); }
html.pg-themed .ph .ph-diagsum__go { color: var(--pg-accent); }

/* ── Data panels ────────────────────────────────────────────────── */

html.pg-themed .ph .ph-livetag { color: var(--pg-success); border-color: rgba(var(--pg-success-rgb), 0.55); background: var(--pg-success-soft); }
html.pg-themed .ph .ph-livetag::before { background: var(--pg-success); box-shadow: 0 0 6px rgba(var(--pg-success-rgb), 0.8); }
html.pg-themed .ph .ph-panelv__live {
    background: rgba(var(--pg-success-rgb), 0.08);
    border-color: rgba(var(--pg-success-rgb), 0.30);
    border-left-color: var(--pg-success);
    border-radius: var(--pg-radius-sm);
}
html.pg-themed .ph .ph-panelv__live > .ph-ico { color: var(--pg-success); }
html.pg-themed .ph .ph-pcrumbs__item { color: var(--pg-accent); }
html.pg-themed .ph .ph-pcrumbs__item.is-current { color: var(--pg-text-muted); }
html.pg-themed .ph .ph-pcell__status.is-ok { color: rgb(var(--pg-bg-rgb)); background: var(--pg-success); box-shadow: 0 0 10px rgba(var(--pg-success-rgb), 0.45); }
html.pg-themed .ph .ph-pcell__status.is-bad { color: rgb(var(--pg-bg-rgb)); background: var(--pg-danger); }
html.pg-themed .ph .ph-table--panel .ph-prow.is-clickable:hover td { background: var(--pg-accent-faint); }
html.pg-themed .ph .ph-prow__open.is-main { color: var(--pg-accent); border-color: var(--pg-accent-soft); }
html.pg-themed .ph .ph-pinput__label b { color: var(--pg-accent); }
html.pg-themed .ph .ph-pinput__req { color: var(--pg-danger); }
