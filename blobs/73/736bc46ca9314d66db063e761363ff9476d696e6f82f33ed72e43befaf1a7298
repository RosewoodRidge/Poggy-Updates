   IM Fell only has old-style figures, which read as "o.18.o" at label sizes. */
html.pg-themed .ph .ph-tag, html.pg-themed .ph .ph-badge, html.pg-themed .ph .ph-card__changed,
html.pg-themed .ph .ph-catchip .n, html.pg-themed .ph .ph-card__meta, html.pg-themed .ph .ph-rail__count,
html.pg-themed .ph .ph-panel__count, html.pg-themed .ph .ph-tabhead__meta, html.pg-themed .ph .ph-sechead__count,
html.pg-themed .ph .ph-list__count, html.pg-themed .ph .ph-cindex__count, html.pg-themed .ph .ph-drawer__searchcount,
html.pg-themed .ph .ph-drawer__pos, html.pg-themed .ph .ph-nest__sub, html.pg-themed .ph .ph-itemcard__meta,
html.pg-themed .ph .ph-savebar__text b, html.pg-themed .ph .ph-dtab__n, html.pg-themed .ph .ph-subtab__n,
html.pg-themed .ph .ph-flagchip__n, html.pg-themed .ph .ph-eyebrow, html.pg-themed .ph .ph-pager__page {
    font-family: var(--pg-font-body);
}
/* Mono inside display labels stays mono. */
html.pg-themed .ph .ph-card__folder, html.pg-themed .ph .ph-mono-inline,
html.pg-themed .ph .ph-hit__label.is-mono { font-family: var(--pg-font-mono); }
html.pg-themed .ph .ph-sortbtn b { font-family: var(--pg-font-body); }

/* ── Frame ──────────────────────────────────────────────────────── */

html.pg-themed .ph ::-webkit-scrollbar-thumb,
html.pg-themed .ph ::-webkit-scrollbar-thumb:hover {
    border: 0; border-radius: 0; background-clip: border-box;
}
html.pg-themed .ph ::-webkit-scrollbar-thumb { background: var(--pg-accent-soft); }
html.pg-themed .ph ::-webkit-scrollbar-thumb:hover { background: var(--pg-accent); }

html.pg-themed .ph .ph-bg__shade {
    background:
        radial-gradient(ellipse at 50% 0%, rgba(var(--pg-deep-rgb), 0.60) 0%, rgba(var(--pg-deep-rgb), 0.92) 70%),
        linear-gradient(180deg, rgba(var(--pg-deep-rgb), 0.75) 0%, rgba(var(--pg-deep-rgb), 0.94) 38%, rgba(var(--pg-deep-rgb), 0.97) 100%);
}

html.pg-themed .ph .ph-top {
    background: linear-gradient(180deg, rgba(var(--pg-text-rgb), 0.05), transparent), rgba(var(--pg-bg-rgb), 0.86);
    border-bottom-color: var(--pg-border);
}

html.pg-themed .ph .ph-brand__mark {
    color: var(--pg-accent);
    border-color: var(--pg-accent-soft);
    border-radius: var(--pg-radius-sm);
    background: var(--pg-slot-bg);
}

html.pg-themed .ph .ph-searchbox { border-radius: var(--pg-radius-sm); border-color: var(--pg-input-border); }
html.pg-themed .ph .ph-searchbox:focus-within {
    border-color: var(--pg-accent);
    box-shadow: var(--pg-focus-ring);
    background: rgba(var(--pg-deep-rgb), 0.85);
    color: var(--pg-accent);
}

html.pg-themed .ph .ph-kbd { background: var(--pg-surface); border-radius: var(--pg-radius-sm); }
html.pg-themed .ph .ph-kbd:hover { color: var(--pg-accent); border-color: var(--pg-accent-soft); }

/* ── Buttons ────────────────────────────────────────────────────── */

html.pg-themed .ph .ph-btn {
    border-radius: var(--pg-radius-sm);
    background: var(--pg-btn-bg);
    border-color: var(--pg-btn-border);
    color: var(--pg-text);
    box-shadow: none;
}
html.pg-themed .ph .ph-btn:hover { box-shadow: none; }
html.pg-themed .ph .ph-btn--primary { background: var(--pg-btn-primary-bg); border-color: var(--pg-accent-soft); color: var(--pg-text); }
html.pg-themed .ph .ph-btn--primary:hover {
    background: linear-gradient(180deg, var(--pg-accent-glow), rgba(var(--pg-shade-rgb), 0.20));
    border-color: var(--pg-accent);
    color: var(--pg-text);
}
html.pg-themed .ph .ph-btn--go { background: var(--pg-btn-success-bg); border-color: rgba(var(--pg-success-rgb), 0.50); color: var(--pg-text); }
html.pg-themed .ph .ph-btn--go:hover {
    background: linear-gradient(180deg, rgba(var(--pg-success-rgb), 0.45), rgba(var(--pg-shade-rgb), 0.20));
    border-color: var(--pg-success);
}
html.pg-themed .ph .ph-btn--danger { background: var(--pg-btn-danger-bg); border-color: rgba(var(--pg-danger-rgb), 0.50); color: var(--pg-text); }
html.pg-themed .ph .ph-btn--danger:hover {
    background: linear-gradient(180deg, rgba(var(--pg-danger-rgb), 0.45), rgba(var(--pg-shade-rgb), 0.20));
    border-color: var(--pg-danger);
}
html.pg-themed .ph .ph-btn--ghost { background: var(--pg-btn-bg); border-color: var(--pg-btn-border); color: var(--pg-text); }
html.pg-themed .ph .ph-btn--ghost:hover { background: var(--pg-btn-bg-hover); border-color: var(--pg-accent-soft); color: var(--pg-accent-hi); }
html.pg-themed .ph .ph-btn--danger-text { color: var(--pg-danger); }
html.pg-themed .ph .ph-btn--danger-text:hover { color: var(--pg-danger); border-color: rgba(var(--pg-danger-rgb), 0.55); background: var(--pg-danger-soft); }
html.pg-themed .ph .ph-btn.is-attention { border-color: var(--pg-accent); color: var(--pg-accent-hi); animation-name: pg-core-breathe; }
@keyframes pg-core-breathe {
    0%, 100% { box-shadow: 0 0 0 0 rgba(var(--pg-accent-rgb), 0.45); }
    50%      { box-shadow: 0 0 0 6px rgba(var(--pg-accent-rgb), 0); }
}
html.pg-themed .ph .ph-btn--split { border-left-color: rgba(var(--pg-shade-rgb), 0.35); }
html.pg-themed .ph .ph-split .ph-btn:first-child { border-radius: var(--pg-radius-sm) 0 0 var(--pg-radius-sm); }
html.pg-themed .ph .ph-split .ph-btn--split { border-radius: 0 var(--pg-radius-sm) var(--pg-radius-sm) 0; }

html.pg-themed .ph .ph-iconbtn { border-radius: var(--pg-radius-sm); }
html.pg-themed .ph .ph-iconbtn:hover { color: var(--pg-accent-hi); background: var(--pg-btn-bg-hover); border-color: var(--pg-accent-soft); }
html.pg-themed .ph .ph-iconbtn--lg { border-radius: var(--pg-radius-sm); border-color: var(--pg-btn-border); background: var(--pg-btn-bg); }
html.pg-themed .ph .ph-iconbtn--lg:hover,
html.pg-themed .ph .ph-iconbtn--danger:hover { color: var(--pg-danger); background: var(--pg-danger-soft); border-color: rgba(var(--pg-danger-rgb), 0.55); }

html.pg-themed .ph .ph-linkbtn,
html.pg-themed .ph .ph-md-link { color: var(--pg-accent); text-decoration-color: var(--pg-accent-soft); }
html.pg-themed .ph .ph-linkbtn:hover,
html.pg-themed .ph .ph-md-link:hover { text-decoration-color: var(--pg-accent); }

/* ── Small labels, tags, badges, pills ──────────────────────────── */

html.pg-themed .ph .ph-eyebrow { color: var(--pg-accent); }
html.pg-themed .ph .ph-tag { border-color: var(--pg-border-strong); border-radius: var(--pg-radius-sm); background: var(--pg-surface); }
html.pg-themed .ph .ph-badge { border-radius: var(--pg-radius-sm); }
html.pg-themed .ph .ph-badge--changed { color: var(--pg-accent); background: var(--pg-accent-faint); border-color: var(--pg-accent-soft); }
html.pg-themed .ph .ph-badge--pending { color: var(--pg-on-accent); background: var(--pg-accent); border-color: var(--pg-accent); }

html.pg-themed .ph .ph-status {
    background: rgba(var(--pg-deep-rgb), 0.85);
    border-color: var(--pg-border-strong);
    border-radius: var(--pg-radius-sm);
}
html.pg-themed .ph .ph-status.is-on { color: var(--pg-success); border-color: rgba(var(--pg-success-rgb), 0.55); }
html.pg-themed .ph .ph-status.is-on .ph-status__dot { background: var(--pg-success); animation-name: pg-core-pulse-ok; }
@keyframes pg-core-pulse-ok {
    0%   { box-shadow: 0 0 0 0 rgba(var(--pg-success-rgb), 0.55); }
    70%  { box-shadow: 0 0 0 .45rem rgba(var(--pg-success-rgb), 0); }
    100% { box-shadow: 0 0 0 0 rgba(var(--pg-success-rgb), 0); }
}

html.pg-themed .ph .ph-lockpill {
    color: var(--pg-accent-hi);
    background: rgba(var(--pg-deep-rgb), 0.85);
    border-color: var(--pg-accent-soft);
    border-radius: var(--pg-radius-sm);
}
html.pg-themed .ph .ph-lockpill.is-mine { color: var(--pg-success); border-color: rgba(var(--pg-success-rgb), 0.55); background: rgba(var(--pg-deep-rgb), 0.85); }
html.pg-themed .ph .ph-lockpill.is-free { color: var(--pg-text-muted); border-color: var(--pg-border-strong); background: rgba(var(--pg-deep-rgb), 0.6); }

/* ── Home ───────────────────────────────────────────────────────── */

html.pg-themed .ph .ph-masthead__title { letter-spacing: .02em; }
html.pg-themed .ph .ph-stats b { color: var(--pg-accent); }
html.pg-themed .ph .ph-stats li::before { background: var(--pg-accent); }

html.pg-themed .ph .ph-catchip { border-radius: var(--pg-radius-sm); border-color: var(--pg-border-strong); }
html.pg-themed .ph .ph-catchip:hover { color: var(--pg-accent-hi); border-color: var(--pg-accent-soft); background: var(--pg-surface-hover); }
html.pg-themed .ph .ph-catchip.is-active {
    background: var(--pg-accent-faint);
    border-color: var(--pg-accent-soft);
