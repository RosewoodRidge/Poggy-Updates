    font-family: var(--pg-font-display);
    font-weight: 400;
    letter-spacing: .04em;
    text-transform: none;
    color: var(--pg-text);
}
html.pg-themed:not([data-skin]) .manager-header h1,
html.pg-themed:not([data-skin]) .customer-header h1 { font-size: 21px; }
html.pg-themed:not([data-skin]) .ex-sidebar-brand h1 { font-size: 20px; letter-spacing: .08em; }
html.pg-themed:not([data-skin]) .ex-header h2 { font-size: 20px; }

html.pg-themed:not([data-skin]) .panel-title,
html.pg-themed:not([data-skin]) .settings-card-title,
html.pg-themed:not([data-skin]) .ex-account-card h3,
html.pg-themed:not([data-skin]) .ex-modal-header h3,
html.pg-themed:not([data-skin]) .ex-ct-header h3,
html.pg-themed:not([data-skin]) .ex-pc-name,
html.pg-themed:not([data-skin]) .pm-prompt-title {
    font-family: var(--pg-font-display);
    font-weight: 400;
    letter-spacing: .04em;
    color: var(--pg-text);
}
html.pg-themed:not([data-skin]) .dash-panel .panel-title,
html.pg-themed:not([data-skin]) .buylist-current .panel-title,
html.pg-themed:not([data-skin]) .buylist-add-panel .panel-title,
html.pg-themed:not([data-skin]) .ledger-history-header .panel-title,
html.pg-themed:not([data-skin]) .analytics-chart-header .panel-title,
html.pg-themed:not([data-skin]) .inv-toolbar .panel-title { font-size: 16px; }
html.pg-themed:not([data-skin]) .settings-card-title { font-size: 17px; }
html.pg-themed:not([data-skin]) .ex-account-card h3,
html.pg-themed:not([data-skin]) .ex-ct-header h3 { font-size: 16px; }
html.pg-themed:not([data-skin]) .ex-modal-header h3,
html.pg-themed:not([data-skin]) .pm-prompt-title { font-size: 18px; }
html.pg-themed:not([data-skin]) .ex-pc-name { font-size: 16px; }
html.pg-themed:not([data-skin]) .emp-add-panel .panel-title { font-size: 13px; color: var(--pg-text-muted); text-transform: uppercase; letter-spacing: .07em; }

/* Section labels: display font, muted, small capitals */
