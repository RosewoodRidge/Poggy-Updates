html.pg-themed:not([data-skin]) .ex-btn-buy:hover,
html.pg-themed:not([data-skin]) .ex-btn-deposit:hover { background: rgba(var(--pg-success-rgb), 0.24); border-color: var(--pg-success) !important; }
