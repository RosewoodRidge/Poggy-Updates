html.pg-themed:not([data-skin]) .listings-table th,
html.pg-themed:not([data-skin]) .ex-table th,
html.pg-themed:not([data-skin]) .form-group label,
html.pg-themed:not([data-skin]) .cust-sel-key,
html.pg-themed:not([data-skin]) .ex-sidebar-brand span,
html.pg-themed:not([data-skin]) .ex-balance-label,
html.pg-themed:not([data-skin]) .ex-stat-label,
html.pg-themed:not([data-skin]) .ex-chart-info-label,
html.pg-themed:not([data-skin]) .ex-ct-input-group label,
html.pg-themed:not([data-skin]) .ex-modal-input-group label,
html.pg-themed:not([data-skin]) .ex-ct-position h4 {
    font-family: var(--pg-font-display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--pg-text-muted);
}

/* ── Numbers and prices: the body font ───────────────────────────── */
html.pg-themed:not([data-skin]) .stat-value,
html.pg-themed:not([data-skin]) .top-seller-rank,
html.pg-themed:not([data-skin]) .ex-balance-amount,
html.pg-themed:not([data-skin]) .ex-price,
html.pg-themed:not([data-skin]) .ex-stat-value,
html.pg-themed:not([data-skin]) .ex-pc-pnl-value,
html.pg-themed:not([data-skin]) .ex-pc-current,
html.pg-themed:not([data-skin]) .ex-pc-tp-input,
html.pg-themed:not([data-skin]) .ex-modal-row-value,
html.pg-themed:not([data-skin]) .ex-modal-input-group input,
html.pg-themed:not([data-skin]) .ex-chart-current-price,
html.pg-themed:not([data-skin]) .ex-chart-ac-price,
html.pg-themed:not([data-skin]) .ex-chart-info-item span:last-child,
html.pg-themed:not([data-skin]) .ex-ct-value {
    font-family: var(--pg-font-body);
}
html.pg-themed:not([data-skin]) .stat-value { color: var(--pg-text); }
html.pg-themed:not([data-skin]) .stat-green,
html.pg-themed:not([data-skin]) .ex-balance-amount,
html.pg-themed:not([data-skin]) .ex-price,
html.pg-themed:not([data-skin]) .cust-sel-total,
html.pg-themed:not([data-skin]) .cust-grid-tip-price,
html.pg-themed:not([data-skin]) .cust-buy-total-cell,
html.pg-themed:not([data-skin]) .cust-sell-total-cell,
html.pg-themed:not([data-skin]) .top-seller-rev { color: var(--pg-accent); }
html.pg-themed:not([data-skin]) .top-seller-qty { color: var(--pg-text-soft); }
html.pg-themed:not([data-skin]) #settings-upgrade-total,
html.pg-themed:not([data-skin]) #storage-upgrade-total { font-family: var(--pg-font-body); }
html.pg-themed:not([data-skin]) .cust-sell-total-bar strong { color: var(--pg-accent); font-family: var(--pg-font-body); }
html.pg-themed:not([data-skin]) .settings-card-desc code { font-family: var(--pg-font-mono); border-radius: var(--pg-radius-sm) !important; }
html.pg-themed:not([data-skin]) .settings-card-desc a { color: var(--pg-accent) !important; }   /* inline colour names an undefined variable */

/* ── Tabs ────────────────────────────────────────────────────────── */
html.pg-themed:not([data-skin]) .tab-btn,
html.pg-themed:not([data-skin]) .cust-tab-btn,
html.pg-themed:not([data-skin]) .ex-ct-tab {
    font-family: var(--pg-font-display);
    font-weight: 400;
    letter-spacing: .06em;
    color: var(--pg-text-muted);
    border-bottom-color: transparent;
}
html.pg-themed:not([data-skin]) .tab-btn,
html.pg-themed:not([data-skin]) .cust-tab-btn { font-size: 15px; }
html.pg-themed:not([data-skin]) .ex-ct-tab { font-size: 13px; }
html.pg-themed:not([data-skin]) .tab-btn:hover,
html.pg-themed:not([data-skin]) .cust-tab-btn:hover,
html.pg-themed:not([data-skin]) .ex-ct-tab:hover { color: var(--pg-text); }
html.pg-themed:not([data-skin]) .tab-btn.active,
html.pg-themed:not([data-skin]) .cust-tab-btn.active {
    color: var(--pg-accent);
    border-bottom-color: var(--pg-accent);
}
/* the trade sidebar's Buy / Short tabs keep their meaning colour */
html.pg-themed:not([data-skin]) .ex-ct-tab.active[data-ct-action="buy"] { color: var(--pg-success); border-bottom-color: var(--pg-success); }
html.pg-themed:not([data-skin]) .ex-ct-tab.active[data-ct-action="short"] { color: var(--pg-danger); border-bottom-color: var(--pg-danger); }

/* Exchange sidebar nav: a list of places, selected like a row */
html.pg-themed:not([data-skin]) .ex-sidebar {
    background: rgba(var(--pg-text-rgb), 0.02);
    border-right: 1px solid var(--pg-border-soft);
}
html.pg-themed:not([data-skin]) .ex-nav-item {
    font-family: var(--pg-font-display);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: .04em;
    color: var(--pg-text-soft);
    border-radius: var(--pg-radius-sm);
}
html.pg-themed:not([data-skin]) .ex-nav-item:hover { background: var(--pg-surface-hover); color: var(--pg-text); }
html.pg-themed:not([data-skin]) .ex-nav-item.active {
    background: var(--pg-surface);
    color: var(--pg-accent);
    border-color: var(--pg-accent-soft);
}

/* Toggle groups: market filter, chart range, list / grid view */
html.pg-themed:not([data-skin]) .ex-filter-bar { background: transparent; border-bottom: 1px solid var(--pg-border-soft); }
html.pg-themed:not([data-skin]) .ex-filter-btn,
html.pg-themed:not([data-skin]) .ex-chart-range-btn,
html.pg-themed:not([data-skin]) .cust-view-btn {
    font-family: var(--pg-font-display);
    font-weight: 400;
    letter-spacing: .06em;
    background: var(--pg-btn-bg);
    color: var(--pg-text-muted);
    border-radius: var(--pg-radius-sm);
}
html.pg-themed:not([data-skin]) .ex-filter-btn { border: 1px solid var(--pg-btn-border); text-transform: uppercase; }
html.pg-themed:not([data-skin]) .ex-filter-btn:hover,
html.pg-themed:not([data-skin]) .ex-chart-range-btn:hover,
html.pg-themed:not([data-skin]) .cust-view-btn:hover { background: var(--pg-btn-bg-hover); color: var(--pg-text); }
html.pg-themed:not([data-skin]) .ex-filter-btn.active,
html.pg-themed:not([data-skin]) .ex-chart-range-btn.active,
html.pg-themed:not([data-skin]) .cust-view-btn.active {
    background: var(--pg-btn-primary-bg);
    color: var(--pg-accent);
    border-color: var(--pg-accent-soft);
}
html.pg-themed:not([data-skin]) .ex-chart-range-btns,
html.pg-themed:not([data-skin]) .cust-view-toggle {
    background: var(--pg-deep);
    border: 1px solid var(--pg-border-soft);
    border-radius: var(--pg-radius-sm);
}
html.pg-themed:not([data-skin]) .cust-view-btn + .cust-view-btn { border-left-color: var(--pg-border-soft); }

/* ── Buttons ─────────────────────────────────────────────────────── */
/* every button family shares the house shape */
html.pg-themed:not([data-skin]) .btn-action,
html.pg-themed:not([data-skin]) .btn-submit,
html.pg-themed:not([data-skin]) .btn-danger,
html.pg-themed:not([data-skin]) .btn-outline,
html.pg-themed:not([data-skin]) .btn-inline-save,
html.pg-themed:not([data-skin]) .btn-max,
html.pg-themed:not([data-skin]) .cust-btn-buy,
html.pg-themed:not([data-skin]) .cust-btn-sell,
html.pg-themed:not([data-skin]) .cust-btn-sell-all-row,
html.pg-themed:not([data-skin]) .ex-btn,
html.pg-themed:not([data-skin]) .ex-balance-actions button,
html.pg-themed:not([data-skin]) .ex-account-input-row button,
html.pg-themed:not([data-skin]) .ex-pc-tp-set,
html.pg-themed:not([data-skin]) .ex-modal-footer button,
html.pg-themed:not([data-skin]) .ex-ct-confirm,
html.pg-themed:not([data-skin]) .ex-ct-pos-btn,
html.pg-themed:not([data-skin]) .pm-prompt-btn {
    font-family: var(--pg-font-display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: .07em;
    border-radius: var(--pg-radius-sm);
    box-shadow: none;
    transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
}
html.pg-themed:not([data-skin]) button:disabled { opacity: .45; cursor: default; }

/* plain: Refresh, Save, Apply, Withdraw, Upgrade, Max, Cancel, Set */
html.pg-themed:not([data-skin]) .btn-action,
html.pg-themed:not([data-skin]) .btn-max,
html.pg-themed:not([data-skin]) .cust-qty-group .btn-max,
html.pg-themed:not([data-skin]) .ex-pc-tp-set,
html.pg-themed:not([data-skin]) .ex-modal-cancel,
html.pg-themed:not([data-skin]) .ex-ct-pos-btn,
html.pg-themed:not([data-skin]) .pm-prompt-btn.cancel {
    background: var(--pg-btn-bg);
    border: 1px solid var(--pg-btn-border);
    color: var(--pg-text);
}
html.pg-themed:not([data-skin]) .ex-modal-cancel { border-color: var(--pg-btn-border) !important; }   /* the page's own rule is !important */
html.pg-themed:not([data-skin]) .btn-action:hover,
html.pg-themed:not([data-skin]) .btn-max:hover,
html.pg-themed:not([data-skin]) .cust-qty-group .btn-max:hover,
html.pg-themed:not([data-skin]) .ex-pc-tp-set:hover,
html.pg-themed:not([data-skin]) .ex-modal-cancel:hover,
html.pg-themed:not([data-skin]) .ex-ct-pos-btn:hover,
html.pg-themed:not([data-skin]) .pm-prompt-btn.cancel:hover {
    background: var(--pg-btn-bg-hover);
    border-color: var(--pg-accent-soft);
    color: var(--pg-text);
}
html.pg-themed:not([data-skin]) .ex-modal-cancel:hover { border-color: var(--pg-accent-soft) !important; }

/* primary: Add, Deposit, Take, Buy, Sell (in the shop), Confirm */
html.pg-themed:not([data-skin]) .btn-submit,
html.pg-themed:not([data-skin]) .btn-inline-save,
html.pg-themed:not([data-skin]) .cust-btn-buy,
html.pg-themed:not([data-skin]) .cust-btn-sell,
html.pg-themed:not([data-skin]) .ex-modal-confirm-cover,
html.pg-themed:not([data-skin]) .pm-prompt-btn.confirm {
    background: var(--pg-btn-primary-bg);
    border: 1px solid var(--pg-accent-soft);
    color: var(--pg-text);
}
html.pg-themed:not([data-skin]) .ex-modal-confirm-cover { border-color: var(--pg-accent-soft) !important; }
html.pg-themed:not([data-skin]) .btn-submit:hover,
html.pg-themed:not([data-skin]) .btn-inline-save:hover,
html.pg-themed:not([data-skin]) .cust-btn-buy:hover,
html.pg-themed:not([data-skin]) .cust-btn-sell:hover,
html.pg-themed:not([data-skin]) .ex-modal-confirm-cover:hover,
html.pg-themed:not([data-skin]) .pm-prompt-btn.confirm:hover {
    background: linear-gradient(180deg, var(--pg-accent-glow), rgba(var(--pg-shade-rgb), 0.20));
    border-color: var(--pg-accent);
    color: var(--pg-text);
}

/* danger: Del, Remove, Sell All (every item) */
html.pg-themed:not([data-skin]) .btn-danger,
html.pg-themed:not([data-skin]) .btn-outline {
    background: var(--pg-btn-bg);
    border: 1px solid rgba(var(--pg-danger-rgb), 0.35);
    color: var(--pg-danger);
}
html.pg-themed:not([data-skin]) .btn-outline { border-color: rgba(var(--pg-danger-rgb), 0.35) !important; color: var(--pg-danger) !important; }  /* inline colours, same meaning */
html.pg-themed:not([data-skin]) .btn-danger:hover,
html.pg-themed:not([data-skin]) .btn-outline:hover {
    background: var(--pg-danger-soft);
    border-color: var(--pg-danger) !important;
}

/* caution: Sell All on one row */
html.pg-themed:not([data-skin]) .cust-btn-sell-all-row {
    background: var(--pg-btn-bg);
    border: 1px solid rgba(var(--pg-warning-rgb), 0.35);
    color: var(--pg-warning);
}
html.pg-themed:not([data-skin]) .cust-btn-sell-all-row:hover {
    background: var(--pg-warning-soft);
    border-color: var(--pg-warning);
    color: var(--pg-warning);
}

/* Exchange trade buttons keep the trading meaning: buy / deposit green,
   short red, sell / withdraw amber, cover the accent. */
html.pg-themed:not([data-skin]) .ex-btn-buy,
html.pg-themed:not([data-skin]) .ex-btn-deposit {
    background: var(--pg-success-soft);
    border-color: rgba(var(--pg-success-rgb), 0.35) !important;
    color: var(--pg-success);
}
html.pg-themed:not([data-skin]) .ex-btn-short {
    background: var(--pg-danger-soft);
    border-color: rgba(var(--pg-danger-rgb), 0.35);
    color: var(--pg-danger);
}
html.pg-themed:not([data-skin]) .ex-btn-sell,
html.pg-themed:not([data-skin]) .ex-btn-withdraw {
    background: var(--pg-warning-soft);
    border-color: rgba(var(--pg-warning-rgb), 0.35) !important;
    color: var(--pg-warning);
}
html.pg-themed:not([data-skin]) .ex-btn-cover {
    background: var(--pg-btn-primary-bg);
    border-color: var(--pg-accent-soft);
    color: var(--pg-accent);
