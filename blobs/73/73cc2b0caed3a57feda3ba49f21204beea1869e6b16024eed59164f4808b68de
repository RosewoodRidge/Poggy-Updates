html.pg-themed:not([data-skin]) .ex-btn-sell:hover,
html.pg-themed:not([data-skin]) .ex-btn-withdraw:hover { background: rgba(var(--pg-warning-rgb), 0.24); border-color: var(--pg-warning) !important; }
html.pg-themed:not([data-skin]) .ex-btn-cover:hover { border-color: var(--pg-accent); }

