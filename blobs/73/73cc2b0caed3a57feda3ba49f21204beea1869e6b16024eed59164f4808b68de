/* ================================================================
   poggy_core — Poggy theme skin for poggy_markets

   Pages (all one ui/index.html):
     - Store manager: header, tab bar, Dashboard, Inventory, Buy List,
       Sold Items, Ledger, Analytics (the CSS bar chart), Settings,
       Employees.
     - Customer shop: Buy (list and grid, the grid's detail bar and
       hover tip), Sell, the sell-total bar.
     - Commodities exchange: sidebar, header, filter bar, Market table,
       Chart (toolbar, search autocomplete, range buttons, info bar,
       trade sidebar), Portfolio cards, Account, the trade modal, toasts.
     - The text prompt (js/prompt.js: naming a store).

   Scope: html.pg-themed:not([data-skin]). skin.js puts data-skin on
   <html> only for an image skin (Config.UI.skin = "leather", or any
   other name); "default" removes the attribute. So this skin applies
   exactly when no image skin is chosen, and the leather skin keeps its
   own look (and its images) untouched.

   Left alone on purpose:
     - the leather image skin (css/skin-leather.css) and its images;
     - item icons;
     - the exchange price chart (a <canvas> drawn by Chart.js with
       colours written in exchange.js; CSS cannot reach it);
     - the select arrow (a data-URI SVG with a fixed grey stroke; it
       reads on both dark and light themes).

   Meaning kept: gains / buy / deposit green (--pg-success), losses /
   short / delete red (--pg-danger), withdraw / sell / low stock amber
   (--pg-warning). Numbers and prices in the body font; prices in the
   accent.

   The exchange writes a few colours into element.style (the chart's
   current price, the spread, the trade sidebar's position type and
   P&L, the price flash on a chart click). Those are matched by the
   colour Chromium serialises into the style attribute and re-pointed
   with !important, so their meaning (up green, down red) survives.
   ================================================================ */

/* ── The script's own variables, re-pointed to the theme ─────────── */
html.pg-themed:not([data-skin]) {
    --bg-primary:    transparent;
    --bg-secondary:  var(--pg-surface);
    --bg-tertiary:   var(--pg-deep);
    --bg-elevated:   var(--pg-raise);
    --bg-hover:      var(--pg-surface-hover);
    --bg-active:     var(--pg-surface-strong);
    --bg-base:       var(--pg-surface);

    --border-primary:   var(--pg-border-soft);
    --border-secondary: var(--pg-border);
    --border-accent:    var(--pg-accent-soft);

    --text-primary:   var(--pg-text);
    --text-secondary: var(--pg-text-soft);
    --text-muted:     var(--pg-text-muted);
    --text-accent:    var(--pg-accent);

    --accent:        var(--pg-accent);
    --accent-hover:  var(--pg-accent-hi);
    --accent-glow:   var(--pg-accent-faint);
    --accent-bg:     var(--pg-accent-faint);

    --green:         var(--pg-success);
    --green-bg:      var(--pg-success-soft);
    --green-border:  rgba(var(--pg-success-rgb), 0.35);
    --orange:        var(--pg-warning);
    --orange-bg:     var(--pg-warning-soft);
    --orange-border: rgba(var(--pg-warning-rgb), 0.35);
    --red:           var(--pg-danger);
    --red-bg:        var(--pg-danger-soft);
    --red-border:    rgba(var(--pg-danger-rgb), 0.35);
    --yellow:        var(--pg-warning);

    --radius-sm: var(--pg-radius-sm);
    --radius-md: var(--pg-radius-sm);
    --radius-lg: var(--pg-radius);

    --font-body:    var(--pg-font-body);
    --font-heading: var(--pg-font-display);
    --font-mono:    var(--pg-font-body);
}

/* ── Windows ─────────────────────────────────────────────────────── */
html.pg-themed:not([data-skin]) #manager-container,
html.pg-themed:not([data-skin]) .customer-container,
html.pg-themed:not([data-skin]) #exchange-container {
    background: var(--pg-panel-bg);
    border: 1px solid var(--pg-border);
    border-radius: var(--pg-radius);
    box-shadow: var(--pg-shadow);
    color: var(--pg-text);
}
html.pg-themed:not([data-skin]) #exchange-container { border: none; border-radius: 0; box-shadow: none; }

/* Headers and bars laid on the panel: a quiet band, no colour of their own */
html.pg-themed:not([data-skin]) .manager-header,
html.pg-themed:not([data-skin]) .customer-header,
html.pg-themed:not([data-skin]) .ex-header {
    background: transparent;
    border-bottom: 1px solid var(--pg-border-soft);
}
html.pg-themed:not([data-skin]) .tab-bar,
html.pg-themed:not([data-skin]) .cust-tab-bar {
    background: transparent;
    border-bottom: 1px solid var(--pg-border-soft);
}

/* ── Titles ──────────────────────────────────────────────────────── */
html.pg-themed:not([data-skin]) .manager-header h1,
html.pg-themed:not([data-skin]) .customer-header h1,
html.pg-themed:not([data-skin]) .ex-sidebar-brand h1,
