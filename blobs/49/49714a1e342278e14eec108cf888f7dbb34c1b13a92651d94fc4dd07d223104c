  "commands": [
    {
      "command": "/craft",
      "configPath": "Config.Commands.craft",
      "who": "Everyone",
      "description": "Opens the recipe browser anywhere. Recipes that need a bench or prop are still out of reach.",
      "usage": "/craft",
      "examples": [
        "/craft"
      ]
    },
    {
      "command": "/campfire",
      "configPath": "Config.Commands.campfire",
      "who": "Staff (admins)",
      "description": "Places a campfire without using the item. Off by default (false). Staff only: the server checks the player is an admin.",
      "usage": "/campfire",
      "examples": [
        "/campfire"
      ]
    },
    {
      "command": "/extinguish",
      "configPath": "Config.Commands.extinguish",
      "who": "Everyone",
      "description": "Puts out the campfire you placed.",
      "usage": "/extinguish",
      "examples": [
        "/extinguish"
      ]
    },
    {
      "command": "/gt",
      "configPath": "Config.Commands.tracker",
      "who": "Everyone",
      "description": "Gives the mouse to the gathering tracker so you can drag it somewhere else.",
      "usage": "/gt",
      "examples": [
        "/gt"
      ]
    },
    {
      "command": "/gthide",
      "configPath": "Config.Commands.trackerHide",
      "who": "Everyone",
      "description": "Hides or shows the gathering tracker.",
      "usage": "/gthide",
      "examples": [
        "/gthide"
      ]
    },
    {
      "command": "poggycrafting_icons",
      "who": "Server console",
      "description": "Runs the hidden-recipe check again and prints how many recipes are hidden and why. Only matters with Hide recipes with no item icon on.",
      "usage": "poggycrafting_icons",
      "examples": [
        "poggycrafting_icons"
      ]
