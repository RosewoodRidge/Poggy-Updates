      "label": "Benches",
      "itemLabel": "bench",
      "tab": "locations",
      "kind": "list",
      "titleField": "name",
      "subtitleField": "id",
      "columns": [
        {
          "field": "name",
          "label": "Name"
        },
        {
          "field": "id",
          "label": "ID"
        },
        {
          "field": "Categories",
          "label": "Categories"
        },
        {
          "field": "Job",
          "label": "Jobs"
        }
      ],
      "search": [
        "name",
        "id"
      ],
      "fields": {
        "id": {
          "label": "ID",
          "tooltip": "Unique id that recipes and categories use in their Location list. Never reuse one; renaming it breaks those links."
        },
        "name": {
          "label": "Name",
          "tooltip": "Shown on the prompt and the map blip."
        },
        "x": {
          "label": "X",
          "tooltip": "Bench position, east-west.",
          "step": 0.01
        },
        "y": {
          "label": "Y",
          "tooltip": "Bench position, north-south.",
          "step": 0.01
        },
        "z": {
          "label": "Z",
          "tooltip": "Bench position, height.",
          "step": 0.01
        },
        "Categories": {
          "label": "Categories",
          "tooltip": "Every category, or only the ones listed (from Recipes → Categories). A recipe whose category this bench does not offer is greyed out here.",
          "any": { "value": 0, "label": "Every category", "listLabel": "Only these", "emptyNote": "Empty list: this bench offers no recipes at all until you add a category." },
          "suggest": [
            { "from": "Config.Categories", "field": "ident", "label": "text", "group": "Category", "icon": "link" }
          ],
          "suggestNote": "Not the ident of a category. Check the spelling, or add it under Recipes → Categories."
        },
        "Job": {
          "label": "Jobs",
          "tooltip": "Who sees this bench's prompt. Anyone, or only the jobs listed.",
          "any": { "value": 0, "label": "Anyone", "listLabel": "Only these jobs" }
        },
        "Job[]": {
          "picker": "job"
        },
        "Blip": {
          "label": "Map blip",
          "tooltip": "Leave out for no blip."
        },
        "Blip.enable": {
          "label": "Show blip",
          "tooltip": "Show this bench on the map."
        },
        "Blip.Hash": {
          "label": "Blip sprite",
          "tooltip": "RedM blip sprite name, e.g. blip_shop_blacksmith."
        },
        "Blip.scale": {
          "label": "Blip size",
          "tooltip": "Blip scale. Default 0.2.",
          "min": 0.05,
          "max": 2,
          "step": 0.05
        },
        "Categories[]": {
          "ref": "Config.Categories",
          "refField": "ident"
        }
      },
      "template": {
        "id": "new_bench",
        "name": "Workbench",
        "x": 0.0,
        "y": 0.0,
        "z": 0.0,
        "Categories": 0,
        "Job": 0
      }
    },
    "Config.CraftingProps": {
      "label": "Crafting props",
      "itemLabel": "prop group",
      "tab": "locations",
      "kind": "list",
      "titleField": "title",
      "columns": [
        {
          "field": "title",
          "label": "Title"
        },
        {
          "field": "prop",
          "label": "Models"
        }
      ],
      "search": [
        "title"
      ],
      "fields": {
        "title": {
          "label": "Title",
          "tooltip": "Prompt text. Lower-cased, it is also the location id recipes match on: Location = { 'campfire' }."
        },
        "prop": {
          "label": "Prop models",
          "tooltip": "World prop models that count as this place. Standing next to any of them opens the browser."
        }
      },
      "template": {
        "title": "New Prop",
        "prop": []
      }
    },
    "Config.Crafting": {
      "label": "Recipes",
      "itemLabel": "recipe",
      "tab": "recipes",
      "kind": "list",
      "titleField": "Text",
      "subtitleField": "Category",
      "columns": [
        {
          "field": "Text",
          "label": "Recipe"
        },
        {
          "field": "Category",
          "label": "Category"
        },
        {
          "field": "Job",
          "label": "Jobs"
        },
        {
          "field": "Location",
          "label": "Where"
        }
      ],
      "search": [
        "Text",
        "SubText",
        "Category",
        "Items[].name",
        "Reward[].name"
      ],
      "fields": {
        "Text": {
          "label": "Name",
          "tooltip": "The recipe's identity: it must be unique. Renaming it orphans shopping-list entries, so treat it as an id."
        },
        "SubText": {
          "label": "Subtitle",
          "tooltip": "A short line under the name in the browser."
        },
        "Desc": {
          "label": "Description",
          "tooltip": "The long description in the browser.",
          "picker": "multiline"
        },
        "Items": {
          "label": "Ingredients",
          "tooltip": "What one craft uses up."
        },
        "Items[]": {
          "template": { "name": "", "count": 1 }
        },
        "Items[].name": {
          "label": "Item",
          "tooltip": "Inventory item name.",
          "picker": "item"
        },
        "Items[].count": {
          "label": "Amount",
          "tooltip": "How many per craft.",
          "min": 1,
          "step": 1
        },
        "Items[].take": {
          "label": "Used up",
          "tooltip": "Off = the item is needed but kept, like a tool: one is enough however many are crafted at a time. Default on."
        },
        "Items[].canUseDecay": {
          "label": "Minimum condition",
          "tooltip": "Only accept the item at or above this condition, 0-100. VORP only; elsewhere the check passes.",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%"
        },
        "Items[].AltNames": {
          "label": "Alternatives",
          "tooltip": "Other items that can fill this slot, e.g. any fish."
        },
        "Items[].AltNames[]": {
          "picker": "item"
        },
        "Reward": {
          "label": "Rewards",
          "tooltip": "What one craft gives. In currency mode, an entry with no item is money: negative = the player pays."
        },
        "Reward[]": {
          "template": { "name": "", "count": 1 }
        },
        "Reward[].name": {
          "label": "Item",
          "tooltip": "Item or weapon name. Leave empty in currency mode for money.",
          "picker": "item"
        },
        "Reward[].count": {
          "label": "Amount",
          "tooltip": "How many per craft. For money, dollars (negative = a cost).",
          "step": 1
        },
        "AltRewards": {
          "label": "Rewards by alternative",
          "tooltip": "Alternative item name = a full reward list that replaces the default when that alternative was used.",
          "advanced": true
        },
        "Type": {
          "label": "Reward kind",
          "tooltip": "Weapon rewards are created as real weapons with a serial.",
          "options": [
            {
              "value": "item",
              "label": "Item"
            },
            {
              "value": "weapon",
              "label": "Weapon"
            }
          ]
        },
        "Category": {
          "label": "Category",
          "tooltip": "Which category it is listed under: one of the Categories on this tab.",
          "ref": "Config.Categories",
          "refField": "ident"
        },
        "Job": {
          "label": "Jobs",
          "tooltip": "Who can craft it. Anyone, or only the jobs listed. A player without the job can still try it if the recipe has a job skillcheck.",
          "any": { "value": 0, "label": "Anyone", "listLabel": "Only these jobs" }
        },
        "Job[]": {
          "picker": "job"
        },
        "Location": {
          "label": "Where",
          "tooltip": "Anywhere, or only at the places listed: bench IDs from Locations → Benches, and prop titles in lower case, e.g. campfire, oven, forge.",
          "any": { "value": 0, "label": "Anywhere", "listLabel": "Only at these places", "emptyNote": "Empty list: this can be crafted nowhere until you add a place." },
          "suggest": [
            { "from": "Config.Locations", "field": "id", "label": "name", "group": "Bench", "icon": "map" },
            { "from": "Config.CraftingProps", "field": "title", "lower": true, "group": "Prop", "icon": "link" }
          ],
          "suggestNote": "Not a bench ID or a prop title. Check the spelling, or add the bench under Locations."
        },
        "Animation": {
          "label": "Animation",
          "tooltip": "One of the Animations (Advanced tab). Left empty, 'craft' is used.",
          "ref": "Config.Animations"
        },
        "CraftTime": {
          "label": "Craft time",
          "tooltip": "Overrides the general craft time for this recipe.",
          "min": 500,
          "max": 120000,
          "step": 500,
          "unit": "ms"
        },
        "UseCurrencyMode": {
          "label": "Currency mode",
          "tooltip": "On = reward entries with no item are money paid (positive) or charged (negative)."
        },
        "CurrencyType": {
          "label": "Currency",
          "tooltip": "Which money currency mode uses.",
          "options": [
            {
              "value": 0,
              "label": "Cash"
            },
            {
              "value": 1,
              "label": "Gold"
            },
            {
              "value": 2,
              "label": "Role tokens"
            }
          ]
        },
        "skillcheck": {
          "label": "Skillcheck rounds",
          "tooltip": "Rounds instead of the progress bar. Partial passes give a share of the reward. 0 or empty = none.",
          "min": 0,
          "max": 20,
          "step": 1
        },
        "jobSkillcheck": {
          "label": "Untrained rounds",
          "tooltip": "A player without the job may still craft it on this many untrained-difficulty rounds. Players with the job craft normally.",
          "min": 0,
          "max": 20,
          "step": 1
        },
        "useHardSkillcheck": {
          "label": "Hard skillcheck",
          "tooltip": "Use the Hard difficulty for this recipe's skillcheck rounds."
        },
        "explodeOnFail": {
          "label": "Explode on failure",
          "tooltip": "A missed round sets off an explosion on the crafter, and the craft gives nothing."
        },
        "catchFireOnFail": {
          "label": "Catch fire on failure",
          "tooltip": "A missed round sets the crafter alight, and the craft gives nothing."
        },
        "AltRewards[][].name": {
          "picker": "item",
          "label": "Reward item",
          "tooltip": "The item given instead when this alternative ingredient was used."
        }
      },
      "template": {
        "Text": "New Recipe",
        "SubText": "",
        "Desc": "",
        "Items": [
          {
            "name": "item_name",
            "count": 1
          }
        ],
        "Reward": [
          {
            "name": "item_name",
            "count": 1
          }
        ],
        "Type": "item",
        "Category": "supplies",
        "Job": 0,
        "Location": 0
      }
    },
    "Config.Categories": {
      "label": "Categories",
      "itemLabel": "category",
      "tab": "recipes",
      "kind": "list",
      "titleField": "text",
      "subtitleField": "ident",
      "columns": [
        {
          "field": "text",
          "label": "Name"
        },
        {
          "field": "ident",
          "label": "Ident"
        },
        {
          "field": "Location",
          "label": "Where"
        },
        {
          "field": "Job",
          "label": "Jobs"
        }
      ],
      "search": [
        "text",
        "ident"
      ],
      "fields": {
        "ident": {
          "label": "Ident",
          "tooltip": "The id recipes use in their Category. Must match exactly."
        },
        "text": {
          "label": "Name",
          "tooltip": "What the player reads in the browser."
        },
        "Location": {
          "label": "Where",
          "tooltip": "Anywhere, or only at the places listed: bench IDs from Locations → Benches, and prop titles in lower case, e.g. campfire. Every recipe in the category follows this.",
          "any": { "value": 0, "label": "Anywhere", "listLabel": "Only at these places", "emptyNote": "Empty list: nothing in this category can be crafted until you add a place." },
          "suggest": [
            { "from": "Config.Locations", "field": "id", "label": "name", "group": "Bench", "icon": "map" },
            { "from": "Config.CraftingProps", "field": "title", "lower": true, "group": "Prop", "icon": "link" }
          ],
          "suggestNote": "Not a bench ID or a prop title. Check the spelling, or add the bench under Locations."
        },
        "Job": {
          "label": "Jobs",
          "tooltip": "Who can craft in this category. Anyone, or only the jobs listed. A locked category still shows, greyed out.",
          "any": { "value": 0, "label": "Anyone", "listLabel": "Only these jobs" }
        },
        "Job[]": {
          "picker": "job"
        }
      },
      "template": {
        "ident": "new_category",
        "text": "New Category",
        "Location": 0,
        "Job": 0
      }
    },
    "Config.ItemSources": {
      "label": "Where items come from",
      "itemLabel": "item source",
      "tab": "recipes",
      "kind": "map",
      "titleField": "source",
      "subtitleField": "description",
      "columns": [
        {
          "field": "source",
          "label": "Badge"
        },
        {
          "field": "description",
          "label": "Description"
        }
      ],
      "search": [
        "source",
        "description"
      ],
      "fields": {
        "source": {
          "label": "Badge",
          "tooltip": "Short badge such as Hunting or Store. Reuse the same wording: the colour comes from the text."
        },
        "description": {
          "label": "Description",
          "tooltip": "One line saying where to go and what to do."
        }
      },
      "template": {
        "source": "Store",
        "description": "Sold at general stores"
      }
    },
    "Config.Animations": {
      "label": "Animations",
      "itemLabel": "animation",
      "tab": "advanced",
      "kind": "map",
      "titleField": "name",
      "subtitleField": "dict",
      "columns": [
        {
          "field": "dict",
          "label": "Dictionary"
        },
        {
          "field": "name",
          "label": "Clip"
        },
        {
          "field": "flag",
          "label": "Flag"
        }
      ],
      "search": [
        "dict",
        "name"
      ],
      "fields": {
        "dict": {
          "label": "Dictionary",
          "tooltip": "Animation dictionary. One the game does not have plays nothing."
        },
        "name": {
          "label": "Clip",
          "tooltip": "Animation clip in that dictionary."
        },
        "flag": {
          "label": "Flag",
          "tooltip": "27 plays once, 17 loops. Looping suits long crafts.",
          "step": 1
        },
        "type": {
          "label": "Kind",
          "tooltip": "Standard animation, or a scenario (then set the scenario hash).",
          "options": [
            {
              "value": "standard",
              "label": "Animation"
            },
            {
              "value": "scenario",
              "label": "Scenario"
            }
          ]
        },
        "hash": {
          "label": "Scenario",
          "tooltip": "Scenario name, when kind is scenario."
        },
        "prop": {
          "label": "Hand prop",
          "tooltip": "Optional object held while crafting."
        },
        "prop.model": {
          "label": "Prop model",
          "tooltip": "Object model in the hand."
        },
        "prop.bone": {
          "label": "Bone",
          "tooltip": "Bone it attaches to, e.g. SKEL_R_Finger13."
        },
        "prop.coords": {
          "label": "Prop offset",
          "tooltip": "Position (x, y, z) and rotation (xr, yr, zr) relative to the bone."
        },
        "prop.subprop": {
          "label": "Second prop",
          "tooltip": "Optional second object on the same bone, e.g. meat on a knife."
        }
      },
      "template": {
        "dict": "mech_inventory@crafting@fallbacks",
        "name": "full_craft_and_stow",
        "flag": 27,
        "type": "standard"
      }
    }
  }
}
