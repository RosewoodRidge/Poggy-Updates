-- ===============================================
-- TRANSLATION HELPER FUNCTION
-- ===============================================

-- Get a translation string for the current language
function T(key, ...)
    local lang = Config.Language or "en"
    local translations = Translations[lang] or Translations["en"]
    local text = translations[key] or Translations["en"][key] or key
    
    -- Handle string formatting if additional arguments provided
    if select('#', ...) > 0 then
        return string.format(text, ...)
    end
    
    return text
end

