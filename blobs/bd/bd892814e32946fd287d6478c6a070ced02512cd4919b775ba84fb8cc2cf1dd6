/* ============================================================================
   poggy_auction — Modern Dark Auction House Theme
   Clean black/white/blue palette, large readable fonts, Web 3.0 aesthetic
   ============================================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

/* ============================================================================
   CSS VARIABLES
   ============================================================================ */

:root {
    --bg-primary:    #0a0a0f;
    --bg-secondary:  #111118;
    --bg-tertiary:   #16161f;
    --bg-elevated:   #1c1c28;
    --bg-hover:      #22223a;
    --bg-active:     #282845;

    --border-primary:   rgba(255, 255, 255, 0.06);
    --border-secondary: rgba(255, 255, 255, 0.10);
    --border-accent:    rgba(99, 140, 255, 0.3);

    --text-primary:   #f0f0f5;
    --text-secondary: #9898b0;
    --text-muted:     #5a5a78;
    --text-accent:    #638cff;

    --accent:        #638cff;
    --accent-hover:  #7da0ff;
    --accent-glow:   rgba(99, 140, 255, 0.15);
    --accent-bg:     rgba(99, 140, 255, 0.08);

    --green:         #34d399;
    --green-bg:      rgba(52, 211, 153, 0.10);
    --green-border:  rgba(52, 211, 153, 0.25);

    --orange:        #fb923c;
    --orange-bg:     rgba(251, 146, 60, 0.10);
    --orange-border: rgba(251, 146, 60, 0.25);

    --red:           #f87171;
    --red-bg:        rgba(248, 113, 113, 0.10);
    --red-border:    rgba(248, 113, 113, 0.25);

    --yellow:        #fbbf24;

    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 12px;

    --font-body:    'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-heading: 'Space Grotesk', 'Inter', sans-serif;

    --border-color:  rgba(255, 255, 255, 0.10);
    --bg-card:       #16161f;
}

/* ============================================================================
   RESET & BASE
   ============================================================================ */

html {
    background: transparent !important;
    background-color: transparent !important;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    color: var(--text-primary);
    overflow: hidden;
    user-select: none;
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    background: transparent !important;
    background-color: transparent !important;
}

.hidden {
    display: none !important;
}

/* ============================================================================
   MAIN CONTAINER
   ============================================================================ */

.container {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 9999;
}

#auction-container {
    width: 88vw;
    max-width: 1300px;
    height: 82vh;
    max-height: 900px;
    background: var(--bg-primary);
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    overflow: hidden;
}

/* ============================================================================
   HEADER
   ============================================================================ */

.auction-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-secondary);
    flex-shrink: 0;
}

.auction-header h1 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 3px;
    text-transform: uppercase;
}

.btn-close {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-secondary);
    color: var(--text-secondary);
    width: 34px;
    height: 34px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-close:hover {
    background: var(--red-bg);
    border-color: var(--red-border);
    color: var(--red);
}

/* ============================================================================
   TAB BAR
   ============================================================================ */

.tab-bar {
    display: flex;
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-secondary);
    padding: 0 16px;
    flex-shrink: 0;
    gap: 2px;
}

.tab-btn {
    padding: 12px 24px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    letter-spacing: 0.5px;
    transition: all 0.2s;
    margin-bottom: -1px;
}

.tab-btn:hover {
    color: var(--text-secondary);
}

.tab-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
}

/* ============================================================================
   TAB CONTENT
   ============================================================================ */

.tab-content {
    display: none;
    flex: 1;
    overflow: hidden;
    min-height: 0;
}

.tab-content.active {
    display: flex;
    flex-direction: column;
}

/* ============================================================================
   BROWSE TAB — LAYOUT
   ============================================================================ */

.browse-layout {
    display: flex;
    flex: 1;
    overflow: hidden;
}

/* Category Sidebar */
.category-sidebar {
    width: 200px;
    border-right: 1px solid var(--border-primary);
    background: var(--bg-secondary);
    overflow-y: auto;
    flex-shrink: 0;
}

.category-list {
    padding: 8px;
}

.category-item {
    padding: 10px 14px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.15s;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 2px;
}

.category-item:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.category-item.active {
    background: var(--accent-bg);
    color: var(--accent);
}

.category-icon {
    font-size: 16px;
    width: 22px;
    text-align: center;
    flex-shrink: 0;
}

/* Listings Area */
.listings-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* ============================================================================
   SEARCH BAR
   ============================================================================ */

.search-bar {
    display: flex;
    gap: 10px;
    padding: 14px 18px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.input-field {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-secondary);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 14px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.input-field:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
}

.input-field::placeholder {
    color: var(--text-muted);
}

#search-input {
    flex: 1;
}

.sort-select {
    width: 200px;
}

select.input-field {
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%239898b0' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 12px center;
    padding-right: 32px;
}

select.input-field option {
    background: var(--bg-tertiary);
    color: var(--text-primary);
}

.btn-action {
    background: var(--accent-bg);
    border: 1px solid var(--border-accent);
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    letter-spacing: 0.5px;
    transition: all 0.2s;
}

.btn-action:hover {
    background: rgba(99, 140, 255, 0.15);
    color: var(--accent-hover);
    box-shadow: 0 0 12px rgba(99, 140, 255, 0.1);
}

/* ============================================================================
   LISTINGS TABLE
   ============================================================================ */

.listings-table-wrapper {
    flex: 1;
    overflow-y: auto;
    padding: 0;
}

.myauctions-wrapper {
    flex: 1;
    overflow-y: auto;
    padding: 0;
}

.listings-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}

.listings-table thead {
    position: sticky;
    top: 0;
    z-index: 10;
}

.listings-table th {
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 12px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border-primary);
}

.listings-table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--border-primary);
    font-size: 14px;
    vertical-align: middle;
    color: var(--text-primary);
}

.listings-table tbody tr {
    transition: background 0.15s;
}

.listings-table tbody tr:hover {
    background: var(--bg-hover);
}

.col-item    { width: 24%; }
.col-qty     { width: 5%; text-align: center; }
.col-bid     { width: 11%; }
.col-buyout  { width: 11%; }
.col-time    { width: 10%; }
.col-seller  { width: 12%; }
.col-bids    { width: 5%; text-align: center; }
.col-status  { width: 10%; }
.col-actions { width: 16%; text-align: center; }

.item-cell {
    display: flex;
    align-items: center;
    gap: 10px;
}

.empty-cell {
    text-align: center;
    padding: 40px;
    color: var(--text-muted);
}

.price-bid {
    color: var(--accent);
    font-weight: 600;
}

.price-buyout {
    color: var(--orange);
    font-weight: 600;
}

.price-none {
    color: var(--text-muted);
    font-style: italic;
    font-size: 13px;
}

.time-urgent {
    color: var(--red);
    font-weight: 600;
}

.time-normal {
    color: var(--text-secondary);
}

/* ============================================================================
   LISTING ACTION BUTTONS
   ============================================================================ */

.btn-bid {
    background: var(--accent-bg);
    border: 1px solid var(--border-accent);
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
    margin-right: 6px;
}

.btn-bid:hover {
    background: rgba(99, 140, 255, 0.18);
    color: var(--accent-hover);
}

.btn-buyout {
    background: var(--orange-bg);
    border: 1px solid var(--orange-border);
    color: var(--orange);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
}

.btn-buyout:hover {
    background: rgba(251, 146, 60, 0.18);
    color: #ffa857;
}

.btn-cancel-listing {
    background: var(--red-bg);
    border: 1px solid var(--red-border);
    color: var(--red);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
}

.btn-cancel-listing:hover {
    background: rgba(248, 113, 113, 0.18);
}

/* ============================================================================
   STATUS BADGES
   ============================================================================ */

.status-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.status-active {
    background: var(--green-bg);
    color: var(--green);
    border: 1px solid var(--green-border);
}

.status-sold {
    background: var(--accent-bg);
    color: var(--accent);
    border: 1px solid var(--border-accent);
}

.status-expired {
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-muted);
    border: 1px solid var(--border-secondary);
}

.status-cancelled {
    background: var(--red-bg);
    color: var(--red);
    border: 1px solid var(--red-border);
}

.status-outbid {
    background: rgba(255, 180, 50, 0.08);
    color: #ffb432;
    border: 1px solid rgba(255, 180, 50, 0.25);
}

/* ============================================================================
   PAGINATION
   ============================================================================ */

.pagination {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 10px 18px;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.listings-count {
    color: var(--text-muted);
    font-size: 13px;
}

/* ============================================================================
   SELL TAB — LAYOUT
   ============================================================================ */

.sell-layout {
    display: flex;
    flex: 1;
    overflow: hidden;
}

/* Inventory Panel */
.inventory-panel {
    width: 320px;
    border-right: 1px solid var(--border-primary);
    background: var(--bg-secondary);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.panel-title {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-primary);
    letter-spacing: 0.5px;
}

.inventory-search-wrapper {
    padding: 8px 10px;
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.inventory-search-wrapper .input-field {
    width: 100%;
    font-size: 13px;
    padding: 8px 12px;
}

.inventory-list {
    flex: 1;
    overflow-y: auto;
    padding: 6px;
}

.inventory-item {
    display: flex;
    align-items: center;
    padding: 10px 12px;
    cursor: pointer;
    transition: all 0.15s;
    border-radius: var(--radius-sm);
    gap: 12px;
    margin-bottom: 2px;
}

.inventory-item:hover {
    background: var(--bg-hover);
}

.inventory-item.selected {
    background: var(--accent-bg);
    border: 1px solid var(--border-accent);
}

.item-img {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    object-fit: contain;
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.item-img-sm {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    object-fit: contain;
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    flex-shrink: 0;
    vertical-align: middle;
    margin-right: 8px;
}

.item-img-lg {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    object-fit: contain;
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.inv-item-name {
    flex: 1;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
}

.inv-item-count {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-elevated);
    padding: 3px 10px;
    border-radius: 20px;
}

/* Listing Form Panel */
.listing-form-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 0;
}

.listing-form {
    padding: 24px 28px;
}

.form-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    color: var(--text-muted);
    font-size: 15px;
}

.selected-item-preview {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: var(--accent-bg);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-md);
    margin-bottom: 20px;
}

.item-preview-name {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
}

.item-preview-count {
    font-size: 13px;
    color: var(--text-secondary);
    margin-left: auto;
}

.form-group {
    margin-bottom: 16px;
}

.form-group label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 6px;
    letter-spacing: 0.3px;
}

.form-group .optional {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 400;
}

.form-group .input-field {
    width: 100%;
}

.fee-breakdown {
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: 14px 18px;
    margin: 20px 0;
}

.fee-breakdown h4 {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.fee-row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    font-size: 14px;
    color: var(--text-secondary);
}

.fee-row span:last-child {
    color: var(--text-primary);
    font-weight: 500;
}

.fee-row-total {
    background: rgba(76, 175, 80, 0.12);
    border: 1px solid rgba(76, 175, 80, 0.35);
    border-radius: 6px;
    padding: 8px 10px !important;
    margin-bottom: 6px;
}

.fee-row-total span:first-child {
    color: #81c784;
    font-weight: 600;
}

.fee-row-total span:last-child {
    color: #a5d6a7;
    font-weight: 700;
    font-size: 15px;
}

.btn-submit {
    width: 100%;
    background: var(--accent);
    border: none;
    color: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    padding: 12px 24px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    letter-spacing: 1px;
    transition: all 0.2s;
    text-transform: uppercase;
}

.btn-submit:hover {
    background: var(--accent-hover);
    box-shadow: 0 4px 20px rgba(99, 140, 255, 0.25);
}

.btn-submit.btn-danger {
    background: var(--red);
}

.btn-submit.btn-danger:hover {
    background: #fca5a5;
    box-shadow: 0 4px 20px rgba(248, 113, 113, 0.25);
}

.btn-cancel-form {
    width: 100%;
    background: var(--bg-elevated);
    border: 1px solid var(--border-secondary);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
    margin-top: 8px;
}

.btn-cancel-form:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

/* ============================================================================
   MAILBOX TAB
   ============================================================================ */

.mailbox-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-right: 18px;
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.mailbox-wrapper {
    flex: 1;
    overflow-y: auto;
}

.mailbox-list {
    padding: 8px;
}

.mailbox-entry {
    display: flex;
    align-items: center;
    padding: 14px 18px;
    border-radius: var(--radius-md);
    gap: 16px;
    transition: background 0.15s;
    margin-bottom: 4px;
}

.mailbox-entry:hover {
    background: var(--bg-hover);
}

.mailbox-icon {
    font-size: 20px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    flex-shrink: 0;
}

.mailbox-icon.type-item {
    background: var(--orange-bg);
    color: var(--orange);
}

.mailbox-icon.type-money {
    background: var(--green-bg);
    color: var(--green);
}

.mailbox-details {
    flex: 1;
}

.mailbox-item-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
}

.mailbox-reason {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 2px;
}

.btn-collect {
    background: var(--green-bg);
    border: 1px solid var(--green-border);
    color: var(--green);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    padding: 8px 18px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
    flex-shrink: 0;
}

.btn-collect:hover {
    background: rgba(52, 211, 153, 0.18);
}

/* ============================================================================
   EMPTY STATE
   ============================================================================ */

.empty-state {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
}

.empty-state p {
    font-size: 15px;
    color: var(--text-muted);
}

/* ============================================================================
   MODALS
   ============================================================================ */

.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    backdrop-filter: blur(4px);
}

.modal-box {
    background: var(--bg-elevated);
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    width: 420px;
    max-width: 90vw;
    box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.03),
        0 20px 60px rgba(0, 0, 0, 0.5);
}

.modal-box h2 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 16px;
}

.modal-item-name {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 16px;
}

.modal-detail {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 8px;
}

.modal-form-group {
    margin-bottom: 12px;
}

.modal-form-group label {
    display: block;
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 4px;
}

.modal-form-group span {
    color: var(--text-primary);
    font-weight: 600;
}

.modal-form-group .input-field {
    width: 100%;
    margin-top: 6px;
}

.modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 24px;
}

.modal-actions .btn-submit,
.modal-actions .btn-cancel-form {
    flex: 1;
}

/* ============================================================================
   SCROLLBAR
   ============================================================================ */

::-webkit-scrollbar {
    width: 6px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.14);
}

/* ============================================================================
   ANIMATIONS
   ============================================================================ */

@keyframes fadeIn {
    from { opacity: 0; transform: translate(-50%, -50%) scale(0.97); }
    to   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

#auction-container:not(.hidden) {
    animation: fadeIn 0.2s ease-out;
}

@keyframes modalFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.modal-overlay:not(.hidden) {
    animation: modalFadeIn 0.15s ease-out;
}

@keyframes modalBoxIn {
    from { opacity: 0; transform: scale(0.95) translateY(8px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-overlay:not(.hidden) .modal-box {
    animation: modalBoxIn 0.2s ease-out;
}

/* ============================================================================
   MISC
   ============================================================================ */

/* Subtle row striping */
.listings-table tbody tr:nth-child(even) {
    background: rgba(255, 255, 255, 0.01);
}

.listings-table tbody tr:nth-child(even):hover {
    background: var(--bg-hover);
}

/* ============================================================================
   CATALOGUE TAB
   ============================================================================ */

.catalogue-layout {
    display: flex;
    height: 100%;
    gap: 0;
    position: relative;
    overflow: hidden;
}

/* Sidebar */
.catalogue-sidebar {
    width: 190px;
    flex-shrink: 0;
    background: var(--bg-secondary);
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 12px 0;
}

.sidebar-section {
    padding: 0 12px 16px;
}

.sidebar-title {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 8px;
}

.filter-list {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.filter-btn {
    background: transparent;
    color: var(--text-secondary);
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    text-align: left;
    font-size: 12px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
}

.filter-btn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.filter-btn.active {
    background: var(--accent-muted, rgba(180,140,80,0.2));
    color: var(--accent);
    font-weight: 600;
}

.btn-full {
    width: 100%;
    text-align: center;
    justify-content: center;
}

/* Main grid area */
.catalogue-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.catalogue-search-bar {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
}

.catalogue-view {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}

.catalogue-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    grid-auto-rows: minmax(200px, auto);
    gap: 12px;
    padding: 14px;
    overflow-y: auto;
    align-content: start;
    min-height: 0;
}

/* Item Card */
.catalogue-card {
    background: var(--bg-card, var(--bg-secondary));
    border: 1px solid var(--border-color);
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.catalogue-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
}

.card-img-wrapper {
    background: rgba(0,0,0,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80px;
    overflow: hidden;
}

.card-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    image-rendering: pixelated;
}

.card-body {
    padding: 10px 10px 8px;
    display: flex;
    flex-direction: column;
    flex: 1;
}

.card-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
    line-height: 1.3;
}

.card-desc {
    font-size: 10px;
    color: var(--text-muted);
    flex: 1;
    line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
}

.card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
    flex-wrap: wrap;
    gap: 4px;
}

.card-price {
    font-size: 12px;
    font-weight: 700;
    color: var(--accent);
}

.company-badge {
    font-size: 9px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 10px;
    white-space: nowrap;
    max-width: 110px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* My Orders slide panel */
.orders-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 340px;
    height: 100%;
    background: var(--bg-secondary);
    border-left: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    z-index: 10;
    box-shadow: -4px 0 16px rgba(0,0,0,0.4);
}

.orders-panel.hidden {
    display: none;
}

.orders-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-color);
}

.orders-panel-header h3 {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
}

.btn-icon-close {
    background: transparent;
    border: none;
    font-size: 20px;
    color: var(--text-muted);
    cursor: pointer;
    line-height: 1;
    transition: color 0.15s;
}

.btn-icon-close:hover { color: var(--text-primary); }

.orders-list {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.order-entry {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 12px;
}

.order-entry-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
}

.order-entry-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
}

.order-entry-company {
    font-size: 10px;
    color: var(--text-muted);
    margin-bottom: 2px;
}

.order-entry-paid {
    font-size: 10px;
    color: var(--accent);
    margin-bottom: 10px;
}

/* Order tracking timeline */
.order-timeline {
    display: flex;
    align-items: flex-start;
    gap: 0;
    padding-top: 4px;
}

.timeline-step {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
}

.timeline-step:not(:first-child)::before {
    content: '';
    position: absolute;
    top: 5px;
    left: -50%;
    width: 100%;
    height: 2px;
    background: var(--border-color);
}

.timeline-step.step-done::before,
.timeline-step.step-active::before {
    background: var(--accent);
}

.step-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--border-color);
    border: 2px solid var(--border-color);
    z-index: 1;
    position: relative;
}

.timeline-step.step-done .step-dot {
    background: var(--accent);
    border-color: var(--accent);
}

.timeline-step.step-active .step-dot {
    background: transparent;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(180,140,80,0.3);
}

.step-label {
    font-size: 8px;
    color: var(--text-muted);
    margin-top: 4px;
    line-height: 1.2;
}

.timeline-step.step-done .step-label,
.timeline-step.step-active .step-label {
    color: var(--text-secondary);
    font-weight: 600;
}

/* Order Modal */
.modal-order {
    max-width: 460px;
}

.modal-order-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
}

.modal-item-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    image-rendering: pixelated;
    background: rgba(0,0,0,0.2);
    border-radius: 6px;
    padding: 4px;
}

.modal-company-badge {
    font-size: 11px;
    color: var(--text-muted);
    margin: 2px 0 0;
}

.modal-desc {
    font-size: 11px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 14px;
    background: rgba(0,0,0,0.15);
    padding: 8px 10px;
    border-radius: 4px;
    border-left: 2px solid var(--accent);
}

/* ============================================================================
   REQUESTS TAB
   ============================================================================ */

.requests-subnav {
    display: flex;
    gap: 4px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
}

.subnav-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 6px 14px;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
}

.subnav-btn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.subnav-btn.active {
    background: var(--accent-muted, rgba(180,140,80,0.2));
    border-color: var(--accent);
    color: var(--accent);
}

.requests-panel {
    display: none;
    flex: 1;
    overflow: hidden;
    flex-direction: column;
    min-height: 0;
}

.requests-panel.active {
    display: flex;
}

#tab-requests.active {
    display: flex;
    flex-direction: column;
}

.requests-search-bar {
    display: flex;
    justify-content: center;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
    flex-shrink: 0;
}

.requests-search-inner {
    display: flex;
    gap: 8px;
    width: 100%;
    max-width: 700px;
    align-items: center;
}

.requests-search-inner .input-field {
    flex: 1;
}

.requests-search-inner .sort-select {
    flex: 0 0 170px;
}

.col-req-img {
    width: 36px;
    padding: 0 4px !important;
}

.requests-table .col-bid { min-width: 90px; }

.badge-persistent {
    font-size: 9px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 10px;
    background: rgba(92,184,92,0.15);
    color: #5cb85c;
    letter-spacing: 0.05em;
}

/* Post Request form */
.post-request-form {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-width: 680px;
    padding: 20px 20px;
}

.panel-subtitle {
    font-size: 11px;
    color: var(--text-muted);
    margin: -4px 0 16px;
    line-height: 1.5;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.hint {
    font-size: 10px;
    color: var(--text-muted);
    font-weight: 400;
}

.fee-row.subtle {
    opacity: 0.7;
    font-size: 11px;
}

/* Shared small button */
.btn-sm {
    padding: 4px 10px !important;
    font-size: 10px !important;
    min-height: unset !important;
}

.btn-danger {
    background: rgba(217,83,79,0.15) !important;
    border-color: rgba(217,83,79,0.4) !important;
    color: #d9534f !important;
}

.btn-danger:hover {
    background: rgba(217,83,79,0.3) !important;
}

/* ============================================================================
   POST REQUEST — Item Search Picker
   ============================================================================ */

.req-item-search-bar {
    display: flex;
    gap: 8px;
    align-items: center;
}

.req-item-search-bar .input-field {
    flex: 1;
}

.req-item-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 10px;
    margin-top: 12px;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding-right: 4px;
    align-content: start;
}

.req-item-results.hidden { display: none; }

.req-item-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 10px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    transition: border-color 0.15s, transform 0.1s;
}

.req-item-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
}

.req-item-card img {
    width: 52px;
    height: 52px;
    object-fit: contain;
    image-rendering: pixelated;
}

.req-item-card-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-primary);
    text-align: center;
    line-height: 1.3;
}

.req-item-card-desc {
    font-size: 10px;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.req-item-no-results {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--text-muted);
    font-size: 12px;
    padding: 24px;
}

/* Selected item preview */
.req-selected-item {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg-card);
    border: 1px solid var(--accent);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 16px;
}

.req-selected-item img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    image-rendering: pixelated;
    flex-shrink: 0;
}

.req-selected-info {
    flex: 1;
    min-width: 0;
}

.req-selected-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
}

.req-selected-name {
    font-size: 10px;
    color: var(--text-muted);
    margin-bottom: 4px;
    font-family: monospace;
}

.req-selected-desc {
    font-size: 11px;
    color: var(--text-secondary);
    line-height: 1.4;
}

.req-form-actions {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 14px;
}

.req-form-actions .btn-submit {
    flex: 1;
    margin-top: 0;
}

#req-form-step.hidden,
#req-search-step.hidden { display: none; }

#req-search-step {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
}

#req-form-step {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
}

/* Empty state generic */
.empty-state {
    text-align: center;
    color: var(--text-muted);
    padding: 40px 20px;
    font-size: 13px;
}

.empty-cell {
    text-align: center;
    color: var(--text-muted);
    padding: 32px 20px !important;
    font-size: 12px;
}

/* ============================================================================
   ORDERS VIEW (My Orders — Amazon-style delivery tracking)
   ============================================================================ */

.orders-view {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}

.orders-view-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
    flex-shrink: 0;
}

.orders-view-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.03em;
}

.orders-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 0;
}

/* Individual order card */
.order-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.order-card.order-delivered {
    border-color: var(--green-border);
    opacity: 0.8;
}

.order-card.order-cancelled {
    border-color: var(--red-border);
    opacity: 0.55;
}

.order-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.order-card-item {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
}

.order-item-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    image-rendering: pixelated;
    background: rgba(0, 0, 0, 0.25);
    border-radius: 6px;
    padding: 3px;
    flex-shrink: 0;
}

.order-card-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.order-item-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.order-item-sub {
    font-size: 11px;
    color: var(--text-muted);
}

.order-card-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
    flex-shrink: 0;
}

.order-total-paid {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
}

/* Order status badge */
.order-status-badge {
    font-size: 9px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
}

.order-status-processing      { background: var(--orange-bg); color: var(--orange); border: 1px solid var(--orange-border); }
.order-status-in_transit       { background: var(--accent-bg); color: var(--accent); border: 1px solid var(--border-accent); }
.order-status-out_for_delivery { background: rgba(251,191,36,0.12); color: var(--yellow); border: 1px solid rgba(251,191,36,0.3); }
.order-status-delivered        { background: var(--green-bg);  color: var(--green);  border: 1px solid var(--green-border); }
.order-status-cancelled        { background: var(--red-bg);    color: var(--red);    border: 1px solid var(--red-border); }

.btn-order-cancel {
    font-size: 10px;
    padding: 3px 9px;
    background: var(--red-bg);
    color: var(--red);
    border: 1px solid var(--red-border);
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s;
}

.btn-order-cancel:hover { background: rgba(248, 113, 113, 0.25); }

.btn-order-reorder {
    font-size: 10px;
    padding: 3px 9px;
    background: rgba(96, 165, 250, 0.12);
    color: #60a5fa;
    border: 1px solid rgba(96, 165, 250, 0.3);
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s;
}
.btn-order-reorder:hover { background: rgba(96, 165, 250, 0.25); }

.btn-order-archive {
    font-size: 10px;
    padding: 3px 9px;
    background: rgba(156, 163, 175, 0.12);
    color: #9ca3af;
    border: 1px solid rgba(156, 163, 175, 0.3);
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s;
}
.btn-order-archive:hover { background: rgba(156, 163, 175, 0.25); }

.order-shop-delivery {
    font-size: 11px;
    color: #60a5fa;
    margin-top: 2px;
}

/* Delivery progress tracker */
.order-tracker {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 2px;
}

.track-steps {
    display: flex;
    align-items: flex-start;
    width: 100%;
}

.track-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.track-conn {
    flex: 1;
    height: 2px;
    background: var(--bg-hover);
    align-self: flex-start;
    margin-top: 6px;  /* vertical center of 14px dot */
    border-radius: 1px;
    min-width: 0;
}

.track-conn.done { background: var(--accent); }

.track-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-hover);
    border: 2px solid rgba(255, 255, 255, 0.12);
    flex-shrink: 0;
}

.track-step.step-done .track-dot {
    background: var(--accent);
    border-color: var(--accent);
}

.track-step.step-active .track-dot {
    background: var(--bg-primary);
    border: 3px solid var(--accent);
    box-shadow: 0 0 0 3px rgba(99, 140, 255, 0.2);
}

.track-label {
    font-size: 9px;
    color: var(--text-muted);
    margin-top: 4px;
    text-align: center;
    line-height: 1.3;
    white-space: nowrap;
    max-width: 64px;
}

.track-step.step-done  .track-label,
.track-step.step-active .track-label { color: var(--text-secondary); }

.order-eta {
    font-size: 11px;
    color: var(--text-secondary);
    padding: 0;
    line-height: 1.4;
}
