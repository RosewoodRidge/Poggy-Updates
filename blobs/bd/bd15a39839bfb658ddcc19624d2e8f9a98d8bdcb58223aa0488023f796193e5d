{
  "label": "Tickets",
  "tagline": "Players ask for help, staff claim it: tickets, help calls, warn, kick, ban and Discord",
  "category": "Admin",
  "description": "A ticket window for players (a key or /ticket) and a large staff panel. Tickets are tracked live, routed to the right staff by kind, claimed by one person, answered in a conversation or in person with a one-press teleport, and posted to Discord as one message that is edited as the ticket moves. Staff are hired in the panel. Bans use poggy_core's account bans.",
  "readme": "README.md",
  "help": [
    {
      "title": "For players: sending a ticket",
      "file": "docs/help/players.md"
    },
    {
      "title": "For staff: the panel",
      "file": "docs/help/staff.md"
    },
    {
      "title": "Setting up: staff, routing and Discord",
      "file": "docs/help/setup.md"
    }
  ],
  "commands": [
    {
      "command": "/ticket",
      "configPath": "Config.Command",
      "who": "Everyone",
      "description": "Opens the ticket form: send a ticket, call for help, or read and answer your own tickets. The Open key (Page Up by default) does the same.",
      "usage": "/ticket",
      "examples": [
        "/ticket"
      ]
    },
    {
      "command": "/tickets",
      "configPath": "Config.StaffCommand",
      "who": "Staff (admins, mods, helpers, developers)",
      "description": "Opens the staff panel. Staff are the people added on the panel's Staff tab, plus anyone your framework counts as an admin. The Staff panel key (Page Down by default) does the same.",
      "usage": "/tickets",
      "examples": [
        "/tickets"
      ]
    },
    {
      "command": "/mod",
      "configPath": "Config.ModCommand",
      "who": "Staff who may warn, kick or ban (mods and admins)",
      "description": "Opens the Players menu: everyone online, each with their record (warnings, bans, tickets) and Warn, Kick and Ban. No ticket needed. Add a server id to open it on that player. Search a name and press Enter to act on someone who has left. Mods can warn and kick; only admins can ban. Every action needs a reason and is in the audit trail.",
      "usage": "/mod [server id]",
      "examples": [
        "/mod",
        "/mod 12"
      ]
    },
    {
      "command": "/invis",
      "configPath": "Config.InvisCommand",
      "who": "Staff (admins, mods, helpers, developers)",
      "description": "Turns your invisibility on or off. While invisible you cannot be hurt. It is also turned on when you teleport from a ticket and off when you press Return. It never survives a relog. Every use is in the audit trail.",
      "usage": "/invis",
      "examples": [
        "/invis"
      ]
    },
    {
      "command": "/staffduty",
      "configPath": "Config.DutyCommand",
      "who": "Staff (admins, mods, helpers, developers)",
      "description": "Goes off duty, or back on. Off duty you get no sounds, pop-ups or badge, and you do not count as staff online; the panel still opens. You are always back on duty after you log in again.",
      "usage": "/staffduty",
      "examples": [
        "/staffduty"
      ]
    }
  ],
