{
  "label": "Poggy Markets",
  "tagline": "Player-owned stores, living prices and a frontier commodities exchange",
  "category": "Economy",
  "description": "Players buy or found their own shops, stock and price them, hire staff and read a sales dashboard. NPC stores across the map trade from catalogs you control. Optional modules add supply-and-demand pricing, a commodities exchange and simulated customers.",
  "readme": "README.md",
  "help": [
    {
      "title": "Adding a store",
      "file": "docs/help/adding-a-store.md"
    },
    {
      "title": "Editing what stores trade",
      "file": "docs/help/catalog.md"
    },
    {
      "title": "Running the economy modules",
      "file": "docs/help/economy-modules.md"
    }
  ],
  "commands": [
    {
      "command": "/pmhere",
      "configPath": "Config.Admin.commands.storeHere",
      "who": "Admins",
      "description": "Prints a finished store block for where you stand to the server console, ready to paste into config/stores.lua. In game only.",
      "usage": "/pmhere <type> <name>",
      "examples": [
        "/pmhere gunsmith Valentine Gunsmith",
        "/pmhere butcher"
      ]
    },
    {
      "command": "/pmgiveshop",
      "configPath": "Config.Admin.commands.giveShop",
      "who": "Admins",
      "description": "Founds a shop at a player's feet and makes them the owner. No deed needed. Also works from the server console.",
      "usage": "/pmgiveshop <serverId>",
      "examples": [
        "/pmgiveshop 12"
      ]
    },
    {
      "command": "/pmdelshop",
      "configPath": "Config.Admin.commands.deleteShop",
      "who": "Admins",
      "description": "Deletes a shop permanently, with its stock and ledger. Also works from the server console.",
      "usage": "/pmdelshop <shopId>",
      "examples": [
        "/pmdelshop 7"
      ]
    },
    {
      "command": "/pmmoveshop",
      "configPath": "Config.Admin.commands.moveShop",
      "who": "Admins",
      "description": "Moves a shop. With no coordinates it moves to where you stand; from the console, coordinates are required.",
      "usage": "/pmmoveshop <shopId> [x y z]",
      "examples": [
        "/pmmoveshop 7",
        "/pmmoveshop 7 -325.4 797.5 117.9"
      ]
    },
    {
      "command": "/pmreposhop",
      "configPath": "Config.Admin.commands.repoShop",
      "who": "Admins",
      "description": "Repossesses a shop: hidden from players, owner locked out, nothing deleted.",
      "usage": "/pmreposhop <shopId>",
      "examples": [
        "/pmreposhop 7"
      ]
    },
    {
      "command": "/pmunreposhop",
      "configPath": "Config.Admin.commands.unrepoShop",
      "who": "Admins",
      "description": "Restores a repossessed shop to its owner.",
      "usage": "/pmunreposhop <shopId>",
      "examples": [
        "/pmunreposhop 7"
      ]
    },
    {
      "command": "/pmshopjob",
      "configPath": "Config.Admin.commands.shopJob",
      "who": "Admins, console",
      "description": "Sets the job a shop gives its owner and staff. Optional: the Shop jobs panel in /poggy does the same and is the main way. Players can never change a shop's job; they see it locked in the staff tab. none = no job even if config/stores.lua names one; reset = back to config/stores.lua. With no job it shows the current one. Also works from the server console.",
      "usage": "/pmshopjob <shopId> <job|none|reset>",
      "examples": [
        "/pmshopjob 7 generalstore",
        "/pmshopjob 7 none",
        "/pmshopjob 7 reset",
        "/pmshopjob 7"
      ]
    },
    {
      "command": "/pmshops",
      "who": "Admins",
      "description": "Lists every shop with its ID, owner, ledger and linked storefront in the server console. Also works from the console.",
      "usage": "/pmshops",
      "examples": [
        "/pmshops"
      ]
    },
    {
      "command": "/pmdiag",
      "who": "Admins",
      "description": "Prints what loaded to the server console: framework, stores, catalog lists, modules and tracked markets. Start here when a store shows nothing.",
      "usage": "/pmdiag",
      "examples": [
        "/pmdiag"
      ]
    },
    {
      "command": "/pmreload",
      "who": "Admins",
      "description": "Rebuilds the store index and reloads shops from the database. It does not re-read the config files; restart the script for config changes.",
      "usage": "/pmreload",
      "examples": [
        "/pmreload"
      ]
    },
    {
      "command": "/pmmanage",
      "who": "Admins",
      "description": "Opens any shop's manager as its owner. With no ID, opens the shop you are standing in. In game only.",
      "usage": "/pmmanage [shopId]",
      "examples": [
        "/pmmanage 7"
      ]
    },
    {
      "command": "/openstore",
      "who": "Everyone",
      "description": "Opens the \"name your store\" prompt, for frameworks where the shop deed cannot be used from the inventory. The deed is still needed and used up. Only exists while player shops and the deed item are on.",
      "usage": "/openstore",
      "examples": [
        "/openstore"
      ]
    }
  ],
