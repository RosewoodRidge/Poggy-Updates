/* ============================================================================
   poggy_markets — Store Manager UI
   Dark theme matching poggy_auction · Web 3.0 aesthetic
   ============================================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

/* ============================================================================
   CSS VARIABLES (identical to auction house)
   ============================================================================ */

:root {
    --bg-primary:    #0a0a0f;
    --bg-secondary:  #111118;
    --bg-tertiary:   #16161f;
    --bg-elevated:   #1c1c28;
    --bg-hover:      #22223a;
    --bg-active:     #282845;

    --border-primary:   rgba(255, 255, 255, 0.06);
    --border-secondary: rgba(255, 255, 255, 0.10);
    --border-accent:    rgba(99, 140, 255, 0.3);

    --text-primary:   #f0f0f5;
    --text-secondary: #9898b0;
    --text-muted:     #5a5a78;
    --text-accent:    #638cff;

    --accent:        #638cff;
    --accent-hover:  #7da0ff;
    --accent-glow:   rgba(99, 140, 255, 0.15);
    --accent-bg:     rgba(99, 140, 255, 0.08);

    --green:         #34d399;
    --green-bg:      rgba(52, 211, 153, 0.10);
    --green-border:  rgba(52, 211, 153, 0.25);

    --orange:        #fb923c;
    --orange-bg:     rgba(251, 146, 60, 0.10);
    --orange-border: rgba(251, 146, 60, 0.25);

    --red:           #f87171;
    --red-bg:        rgba(248, 113, 113, 0.10);
    --red-border:    rgba(248, 113, 113, 0.25);

    --yellow:        #fbbf24;

    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 12px;

    --font-body:    'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-heading: 'Space Grotesk', 'Inter', sans-serif;
}

/* ============================================================================
   RESET & BASE
   ============================================================================ */

html { background: transparent !important; }

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: var(--font-body);
    color: var(--text-primary);
    overflow: hidden;
    user-select: none;
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    background: transparent !important;
}

.hidden { display: none !important; }

/* ============================================================================
   MAIN CONTAINER
   ============================================================================ */

.container {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 9999;
}

#manager-container {
    width: 88vw;
    max-width: 1300px;
    height: 82vh;
    max-height: 900px;
    background: var(--bg-primary);
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    overflow: hidden;
}

/* ============================================================================
   HEADER
   ============================================================================ */

.manager-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-secondary);
    flex-shrink: 0;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 14px;
}

.manager-header h1 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 3px;
    text-transform: uppercase;
}

.shop-id-badge {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-elevated);
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid var(--border-secondary);
    letter-spacing: 0.5px;
}

.btn-close {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-secondary);
    color: var(--text-secondary);
    width: 34px;
    height: 34px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-close:hover {
    background: var(--red-bg);
    border-color: var(--red-border);
    color: var(--red);
}

/* ============================================================================
   TAB BAR
   ============================================================================ */

.tab-bar {
    display: flex;
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-secondary);
    padding: 0 16px;
    flex-shrink: 0;
    gap: 2px;
    overflow-x: auto;
}

.tab-btn {
    padding: 12px 20px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    letter-spacing: 0.5px;
    transition: all 0.2s;
    margin-bottom: -1px;
    white-space: nowrap;
}

.tab-btn:hover { color: var(--text-secondary); }

.tab-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
}

/* ============================================================================
   TAB CONTENT
   ============================================================================ */

.tab-content {
    display: none;
    flex: 1;
    overflow: hidden;
    min-height: 0;
}

.tab-content.active {
    display: flex;
    flex-direction: column;
}

/* ============================================================================
   COMMON: INPUT / BUTTONS / TABLE
   ============================================================================ */

.input-field {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-secondary);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 14px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.input-field:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
}

.input-field::placeholder { color: var(--text-muted); }

select.input-field {
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%239898b0' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 12px center;
    padding-right: 32px;
}

select.input-field option {
    background: var(--bg-tertiary);
    color: var(--text-primary);
}

.btn-action {
    background: var(--accent-bg);
    border: 1px solid var(--border-accent);
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    letter-spacing: 0.5px;
    transition: all 0.2s;
    white-space: nowrap;
}

.btn-action:hover {
    background: rgba(99, 140, 255, 0.15);
    color: var(--accent-hover);
    box-shadow: 0 0 12px rgba(99, 140, 255, 0.1);
}

.btn-submit {
    background: var(--green-bg);
    border: 1px solid var(--green-border);
    color: var(--green);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    letter-spacing: 0.5px;
    transition: all 0.2s;
    white-space: nowrap;
}

.btn-submit:hover {
    background: rgba(52, 211, 153, 0.18);
}

.btn-danger {
    background: var(--red-bg);
    border: 1px solid var(--red-border);
    color: var(--red);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
}

.btn-danger:hover {
    background: rgba(248, 113, 113, 0.18);
}

.btn-small-cancel {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 18px;
    cursor: pointer;
    padding: 0 6px;
    line-height: 1;
    transition: color 0.15s;
}

.btn-small-cancel:hover { color: var(--red); }

/* Tables */

.listings-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}

.listings-table thead {
    position: sticky;
    top: 0;
    z-index: 10;
}

.listings-table th {
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 12px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border-primary);
}

.listings-table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--border-primary);
    font-size: 14px;
    vertical-align: middle;
    color: var(--text-primary);
}

.listings-table tbody tr {
    transition: background 0.15s;
}

.listings-table tbody tr:hover {
    background: var(--bg-hover);
}

.item-cell {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.item-img-sm {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    object-fit: contain;
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.empty-cell {
    text-align: center;
    padding: 40px;
    color: var(--text-muted);
}

.pagination {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 10px 18px;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.listings-count {
    color: var(--text-muted);
    font-size: 13px;
}

/* ============================================================================
   DASHBOARD TAB
   ============================================================================ */

.dashboard-layout {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.stats-row {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
}

.stat-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: 18px 16px;
    text-align: center;
}

.stat-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 8px;
}

.stat-value {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
}

.stat-green { color: var(--green); }

.dashboard-columns {
    display: grid;
    grid-template-columns: 1fr 1fr 2fr;
    gap: 14px;
    flex: 1;
    min-height: 0;
}

.dash-panel {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.dash-panel-wide {
    grid-column: span 1;
}

.dash-panel .panel-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-primary);
    letter-spacing: 0.5px;
}

.dash-panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 10px;
}

.empty-state {
    color: var(--text-muted);
    text-align: center;
    padding: 24px 16px;
    font-size: 13px;
}

/* Top seller rows */
.top-seller-row {
    display: flex;
    align-items: center;
    padding: 8px 10px;
    gap: 10px;
    border-radius: var(--radius-sm);
    transition: background 0.15s;
}

.top-seller-row:hover { background: var(--bg-hover); }

.top-seller-rank {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-muted);
    width: 20px;
    text-align: center;
    flex-shrink: 0;
}

.top-seller-name {
    flex: 1;
    font-size: 13px;
    color: var(--text-primary);
}

.top-seller-qty {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
}

.top-seller-rev {
    font-size: 12px;
    font-weight: 600;
    color: var(--green);
}

/* Low stock row */
.low-stock-row {
    display: flex;
    align-items: center;
    padding: 8px 10px;
    gap: 10px;
    border-radius: var(--radius-sm);
}

.low-stock-name {
    flex: 1;
    font-size: 13px;
    color: var(--text-primary);
}

.low-stock-qty {
    font-size: 12px;
    font-weight: 600;
    color: var(--red);
    background: var(--red-bg);
    padding: 3px 10px;
    border-radius: 20px;
    border: 1px solid var(--red-border);
}

/* Recent txn rows */
.recent-txn-row {
    display: flex;
    align-items: center;
    padding: 8px 10px;
    gap: 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
}

.recent-txn-row:nth-child(even) { background: rgba(255,255,255,0.02); }

.txn-type-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    flex-shrink: 0;
    width: 70px;
    text-align: center;
    line-height: 1.4;
    box-sizing: border-box;
}

.txn-sale     { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-border); }
.txn-purchase { background: var(--accent-bg); color: var(--accent); border: 1px solid var(--border-accent); }
.txn-withdraw { background: var(--orange-bg); color: var(--orange); border: 1px solid var(--orange-border); }
.txn-deposit  { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-border); }

.txn-item-name { flex: 1; color: var(--text-secondary); }
.txn-amount { font-weight: 600; width: 80px; text-align: right; }
.txn-amount-positive { color: var(--green); }
.txn-amount-negative { color: var(--red); }
.txn-time { color: var(--text-muted); font-size: 11px; width: 80px; text-align: right; }

/* ============================================================================
   INVENTORY TAB
   ============================================================================ */

.inventory-layout {
    flex: 1;
    display: flex;
    flex-direction: row;
    gap: 12px;
    overflow: hidden;
}

.inv-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    background: var(--bg-primary);
}

.inv-toolbar {
    display: flex;
    gap: 10px;
    padding: 14px 18px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
    align-items: center;
}

.inv-toolbar .input-field { flex: 1; }

.inv-table-wrapper {
    flex: 1;
    overflow-y: auto;
}

.col-inv-item    { width: 32%; }
.col-inv-qty     { width: 10%; text-align: center; }
.col-inv-price   { width: 20%; padding-left: 12px; }
.col-inv-actions { width: 26%; text-align: center; }\n\n/* Inline edit within table */
.inline-edit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.inline-edit .input-field {
    width: 120px;
    padding: 6px 6px;
    font-size: 13px;
}

.inline-edit .btn-inline-save,
.btn-inline-save {
    background: var(--green-bg);
    border: 1px solid var(--green-border);
    color: var(--green);
    font-size: 11px;
    font-weight: 600;
    padding: 5px 10px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
}

.inline-edit .btn-inline-save:hover,
.btn-inline-save:hover {
    background: rgba(52, 211, 153, 0.2);
}

/* ============================================================================
   BUY LIST TAB
   ============================================================================ */

.buylist-layout {
    display: flex;
    flex: 1;
    overflow: hidden;
}

.buylist-current {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-right: 1px solid var(--border-primary);
}

.buylist-current .panel-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-primary);
    letter-spacing: 0.5px;
}

.buylist-table-wrapper {
    flex: 1;
    overflow-y: auto;
}

.col-bl-item    { width: 40%; }
.col-bl-price   { width: 20%; }
.col-bl-amount  { width: 15%; text-align: center; }
.col-bl-actions { width: 25%; text-align: center; }

.buylist-add-panel {
    width: 340px;
    display: flex;
    flex-direction: column;
    background: var(--bg-secondary);
    flex-shrink: 0;
}

.buylist-add-panel .panel-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-primary);
    letter-spacing: 0.5px;
}

.buylist-search-wrapper {
    padding: 8px 10px;
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.buylist-search-wrapper .input-field { width: 100%; font-size: 13px; padding: 8px 12px; }

.buylist-item-list {
    flex: 1;
    overflow-y: auto;
    padding: 6px;
}

.buylist-item {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    cursor: pointer;
    transition: all 0.15s;
    border-radius: var(--radius-sm);
    gap: 10px;
    margin-bottom: 2px;
    font-size: 13px;
    color: var(--text-secondary);
}

.buylist-item:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.buylist-item.selected {
    background: var(--accent-bg);
    border: 1px solid var(--border-accent);
    color: var(--text-primary);
}

.buylist-add-form {
    padding: 14px;
    border-top: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.selected-item-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--accent-bg);
    border: 1px solid var(--border-accent);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    margin-bottom: 12px;
}

.item-preview-name {
    font-weight: 600;
    color: var(--accent);
    font-size: 13px;
}

.form-row {
    display: flex;
    gap: 10px;
    margin-bottom: 12px;
}

.form-row .form-group { flex: 1; }

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form-group label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.form-group .input-field { width: 100%; }

/* ============================================================================
   EMPLOYEE MANAGEMENT TAB
   ============================================================================ */

.employees-layout {
    display: flex;
    gap: 16px;
    height: 100%;
    overflow: hidden;
}

.emp-current-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.emp-add-panel {
    width: 300px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
}

.emp-add-panel .panel-title {
    padding: 12px 14px;
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.emp-search-wrapper {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.emp-search-wrapper .input-field { width: 100%; font-size: 13px; padding: 8px 12px; }

.emp-player-list {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 10px;
}

.emp-player-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--bg-base);
    border-radius: var(--radius-sm);
    cursor: pointer;
    border: 1px solid var(--border-primary);
    transition: background 0.15s, border-color 0.15s;
}

.emp-player-row:hover {
    background: var(--bg-hover);
    border-color: var(--border-accent);
}

.emp-player-row.selected {
    background: var(--accent-bg);
    border-color: var(--accent);
}

.emp-player-name {
    flex: 1;
    font-weight: 500;
    font-size: 13px;
}

.emp-player-id {
    font-size: 11px;
    color: var(--text-muted);
}

.emp-add-form {
    padding: 14px;
    border-top: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.emp-hint {
    font-size: 12px;
    color: var(--text-secondary);
    margin: 8px 14px;
    line-height: 1.5;
}

/* Role & source badges */
.emp-role-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.emp-role-badge.role-owner    { background: var(--accent-bg); color: var(--accent); }
.emp-role-badge.role-manager  { background: rgba(245,158,11,0.15); color: #f59e0b; }
.emp-role-badge.role-employee { background: rgba(16,185,129,0.15); color: #10b981; }

.emp-source-badge {
    display: inline-block;
