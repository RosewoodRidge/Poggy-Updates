}

.ledger-history {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}

.ledger-history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 18px;
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.ledger-history-header .panel-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    padding: 14px 0;
    letter-spacing: 0.5px;
}

.ledger-filters {
    display: flex;
    gap: 8px;
}

.ledger-filters .input-field {
    font-size: 12px;
    padding: 6px 10px;
}

.ledger-table-wrapper {
    flex: 1;
    overflow-y: auto;
}

.col-txn-date   { width: 16%; }
.col-txn-type   { width: 12%; }
.col-txn-item   { width: 28%; }
.col-txn-qty    { width: 8%; text-align: center; }
.col-txn-amount { width: 16%; }
.col-txn-who    { width: 20%; }

/* ============================================================================
   ANALYTICS TAB
   ============================================================================ */

.analytics-layout {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.analytics-chart-panel {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    overflow: hidden;
}

.analytics-chart-header {
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-primary);
}

.analytics-chart-header .panel-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.5px;
}

.chart-container {
    padding: 20px;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 220px;
}

.chart-bar-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
    gap: 6px;
}

.chart-bar {
    width: 100%;
    max-width: 48px;
    background: linear-gradient(180deg, var(--accent) 0%, rgba(99, 140, 255, 0.3) 100%);
    border-radius: 4px 4px 0 0;
    min-height: 2px;
    transition: height 0.3s ease;
    position: relative;
}

.chart-bar:hover {
    background: linear-gradient(180deg, var(--accent-hover) 0%, rgba(99, 140, 255, 0.5) 100%);
}

.chart-bar-value {
    font-size: 10px;
    font-weight: 600;
    color: var(--text-secondary);
    text-align: center;
}

.chart-bar-label {
    font-size: 10px;
    color: var(--text-muted);
    text-align: center;
    white-space: nowrap;
}

.analytics-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

/* ============================================================================
   SETTINGS TAB
   ============================================================================ */

.settings-layout {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
}

.settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.settings-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: 20px;
}

.settings-card-title {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
}

.settings-card-desc {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 14px;
}

.settings-input-row {
    display: flex;
    gap: 8px;
    align-items: center;
}

.settings-input-row .input-field { flex: 1; }

.settings-toggle-row {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* Toggle switch */
.toggle-switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
    flex-shrink: 0;
}

.toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-secondary);
    border-radius: 24px;
    transition: all 0.3s;
}

.toggle-slider::before {
    content: "";
    position: absolute;
    height: 18px;
    width: 18px;
    left: 2px;
    bottom: 2px;
    background: var(--text-muted);
    border-radius: 50%;
    transition: all 0.3s;
}

.toggle-switch input:checked + .toggle-slider {
    background: var(--accent-bg);
    border-color: var(--border-accent);
}

.toggle-switch input:checked + .toggle-slider::before {
    transform: translateX(20px);
    background: var(--accent);
}

.toggle-label {
    font-size: 13px;
    color: var(--text-secondary);
}

/* ============================================================================
