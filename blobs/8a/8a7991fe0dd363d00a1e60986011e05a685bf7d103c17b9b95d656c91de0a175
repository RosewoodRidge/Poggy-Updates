/* ============================================================================
   CUSTOMER UI — Buy grid
   A 4-wide grid of item tiles with the chosen item's details pinned
   underneath.  Images are 20% larger than the list view's 56px.
   ============================================================================ */

/* List / grid toggle in the Buy toolbar */
.cust-view-toggle {
    display: inline-flex;
    flex-shrink: 0;
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.cust-view-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: var(--bg-elevated);
    color: var(--text-muted);
    border: none;
    cursor: pointer;
    transition: all 0.15s;
}
.cust-view-btn + .cust-view-btn { border-left: 1px solid var(--border-secondary); }
.cust-view-btn:hover { color: var(--text-secondary); }
.cust-view-btn.active {
    background: var(--accent-bg);
    color: var(--accent);
}

/* The grid */
.cust-grid-wrapper {
    flex: 1 1 auto;
    min-height: 0;          /* lets it shrink so the detail bar stays on screen */
    overflow-y: auto;
    max-height: 55vh;
}

/* Four fixed cells, packed tight and centred: image only, like an inventory
   grid.  Name, price and stock live in the detail bar below. */
.cust-buy-grid {
    display: grid;
    grid-template-columns: repeat(4, 75px);
    gap: 4px;
    justify-content: center;
    padding: 12px 18px;
}

/* 67px icon + 3px padding + 1px border.  A fixed cell, so the badge stays in
   the corner even when an icon fails to load. */
.cust-grid-tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 75px;
    height: 75px;
    padding: 3px;
    box-sizing: border-box;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
}
.cust-grid-tile:hover {
    background: var(--bg-hover);
    border-color: var(--border-secondary);
}
.cust-grid-tile.selected {
    background: var(--accent-bg);
    border-color: var(--accent);
}

.customer-container .cust-grid-tile .item-img-sm {
    width: 67px;            /* list size 56px + 20% */
    height: 67px;
    border-radius: 4px;
}

/* Stock count: black circle in the bottom-right corner, only when more than
   one.  Kept inside the cell so it never overlaps the neighbouring tile. */
.cust-grid-qty {
    position: absolute;
    right: 2px;
    bottom: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    border-radius: 999px;   /* a circle for one or two digits, a pill beyond */
    box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.18);
    pointer-events: none;
}

/* Hover tooltip over a tile: the item's name and price.  Placed by JS just
   above the hovered tile, from outside the scrolling grid, so the top row's
   tooltip is never cut off. */
.cust-grid-tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 6px 10px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    line-height: 1.3;
    white-space: nowrap;
    transform: translate(-50%, calc(-100% - 8px));   /* centred, 8px above the tile */
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s, visibility 0.12s;
    pointer-events: none;
}
.cust-grid-tip.show {
    opacity: 1;
    visibility: visible;
}
/* Small arrow pointing down at the tile */
.cust-grid-tip::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 8px;
    height: 8px;
    background: var(--bg-elevated);
    border-right: 1px solid var(--border-secondary);
    border-bottom: 1px solid var(--border-secondary);
    transform: translate(-50%, -50%) rotate(45deg);
}
.cust-grid-tip-name {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
}
.cust-grid-tip-price {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-accent);
}

.cust-grid-empty {
    grid-column: 1 / -1;
    padding: 28px 0;
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
}

/* Detail bar pinned under the grid */
.cust-grid-selection {
    display: flex;
    align-items: center;
    gap: 22px;
    min-height: 91px;       /* same height with or without a selection */
    padding: 12px 18px;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-primary);
    flex-shrink: 0;
}

.cust-sel-empty {
    color: var(--text-muted);
    font-size: 13px;
}

.cust-sel-item {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
}
.customer-container .cust-sel-item .item-img-sm {
    width: 67px;
    height: 67px;
    border-radius: 6px;
    flex-shrink: 0;
}

.cust-sel-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cust-sel-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
}

.cust-sel-key {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--text-muted);
}

.cust-sel-val {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
}
.cust-sel-val.cust-stock-low { color: var(--orange); }
.cust-sel-val.cust-stock-out { color: var(--red); }
.cust-sel-total { color: var(--accent); }

.cust-sel-buy {
    flex-shrink: 0;
    padding: 9px 22px;
    font-size: 13px;
}

/* ============================================================================
   SHOP ADMIN PANEL (/pmadmin) AND HANDING A SHOP OVER
   Built from the manager's own classes; these rules only fill the gaps.
   ============================================================================ */

/* The window.  The manager's own look, keyed to its id, so repeated here; the
   Poggy theme's tokens when poggy_core supplies them, the manager's otherwise. */
#admin-container {
    width: 92vw;
    max-width: 1500px;
    height: 82vh;
    max-height: 900px;
    background: var(--pg-panel-bg, var(--bg-primary));
    border: 1px solid var(--pg-border, var(--border-secondary));
    border-radius: var(--pg-radius, var(--radius-lg));
    color: var(--pg-text, var(--text-primary));
    display: flex;
    flex-direction: column;
    box-shadow: var(--pg-shadow, 0 8px 32px rgba(0, 0, 0, 0.5));
    overflow: hidden;
}

.admin-layout { padding: 16px; box-sizing: border-box; }

.admin-detail {
    width: 420px;
    overflow-y: auto;
    padding-bottom: 12px;
}

.admin-table { table-layout: auto; }
.admin-table td, .admin-table th { white-space: nowrap; }
.admin-table td:nth-child(2), .admin-table td:nth-child(3) { white-space: normal; }

.admin-detail .settings-input-row { flex-wrap: wrap; }
.admin-detail .settings-input-row .input-field { flex: 1 1 120px; min-width: 0; }

.admin-detail > .emp-hint,
.admin-detail #admin-detail-body { padding: 0 14px; }

.admin-detail .settings-card {
    padding: 14px;
    margin-bottom: 10px;
}

.admin-detail .settings-input-row { margin-top: 8px; }

.admin-buttons {
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0 12px;
}

.admin-row { cursor: pointer; }

.admin-row.selected td { background: var(--accent-bg); }

.admin-message {
    margin: 0 14px 8px;
