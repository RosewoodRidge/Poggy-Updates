   ============================================================================ */

.ledger-layout {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.ledger-top {
    display: flex;
    gap: 20px;
    padding: 20px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
