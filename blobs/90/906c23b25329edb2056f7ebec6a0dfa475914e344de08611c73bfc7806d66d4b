{
  "label": "Poggy Multijob",
  "tagline": "Hold every job you're hired for and switch between them in one command",
  "category": "Jobs",
  "description": "Every job a character is given is remembered, so players can switch between them from a menu or with a quick /mj command. Staff get a full admin panel to add, edit, remove and assign jobs for online and offline characters, with one-click job presets.",
  "readme": "README.md",
  "help": [
    {
      "title": "Setting up admin access and job presets",
      "file": "docs/help/admin-and-presets.md"
    },
    {
      "title": "How players switch jobs",
      "file": "docs/help/switching-jobs.md"
    }
  ],
  "commands": [
    {
      "command": "/multijob",
      "configPath": "Config.Command",
      "who": "Everyone",
      "description": "Opens the job menu: every job the character holds (the active one marked), plus Unemployed, Quit Job and Quit All Jobs.",
      "usage": "/multijob",
      "examples": [
        "/multijob"
      ]
    },
    {
      "command": "/mj",
      "configPath": "Config.SwitchCommand",
      "who": "Everyone",
      "description": "Switches straight to one of your other jobs by number. 1 is the first job that is not your current one; Unemployed is always last.",
      "usage": "/mj <number>",
      "examples": [
        "/mj 1",
        "/mj 2"
      ]
    },
    {
      "command": "/mjadmin",
      "who": "Admins",
      "description": "Opens the admin panel: see every character's jobs, set the active job, add, edit or remove jobs, and apply presets. Allowed for the groups in Admin groups. The name is fixed.",
      "usage": "/mjadmin",
      "examples": [
        "/mjadmin"
      ]
    }
  ],
  "tabs": [
    {
      "id": "general",
      "label": "General",
      "icon": "sliders"
    },
    {
      "id": "access",
      "label": "Access & permissions",
      "icon": "shield"
    },
    {
      "id": "presets",
      "label": "Job presets",
      "icon": "clipboard"
    },
    {
      "id": "text",
      "label": "Text & language",
      "icon": "globe"
    },
    {
      "id": "advanced",
      "label": "Advanced",
      "icon": "cog"
    },
    {
      "id": "shopjobs",
      "label": "Shop jobs",
      "icon": "store"
    }
  ],
  "panels": [
    {
      "id": "shopjobs",
      "label": "Shop jobs",
      "tab": "shopjobs",
      "resource": "poggy_markets",
      "export": "HubPanel",
      "itemLabel": "shop",
      "tooltip": "Which job each Poggy Markets shop gives its owner and staff. Everyone hired at a shop gets that job added to their multijob list (their current job is left alone) and loses it when let go. Changes apply at once. Needs poggy_markets running, with its shop jobs switched on."
    }
  ],
  "settings": {
    "Config.Debug": {
      "label": "Debug output",
