      "group": "Commands",
      "advanced": true
    },
    "Config.SwitchCommand": {
      "label": "Quick switch command",
      "tooltip": "The chat command, without the slash, that switches job by number. Its usage hint always says /mj.",
      "tab": "general",
      "group": "Commands"
