/* ── Clock & Weather Widget (below AOP) ──────────────────────────────── */

#clock-widget {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    margin-top: 3px;
}

#aop-display.aop-right #clock-widget {
    align-items: flex-end;
}

/* ── Time row: [sun/moon] │ 3:45 PM ──────────────────────────────────── */
#clock-time {
    display: flex;
    align-items: center;
    gap: 5px;
    line-height: 1;
}

/* ── 2D spin for sun ↔ moon transition ───────────────────────────────── */
#clock-celestial {
    display: inline-block;
    font-size: 14px;
    line-height: 1;
}

@keyframes celestial-spin {
    0%   { transform: rotate(0deg);   }
    100% { transform: rotate(360deg); }
}

#clock-celestial.spinning {
    animation: celestial-spin 0.8s ease;
}

/* ── Divider ─────────────────────────────────────────────────────────── */
#clock-divider {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.25);
    font-weight: 300;
    line-height: 1;
    user-select: none;
}

/* ── Time text ───────────────────────────────────────────────────────── */
#clock-time-text {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 13px;
    font-weight: bold;
    color: #e8e0d4;
    text-shadow:
        2px 2px 4px rgba(0, 0, 0, 0.9),
        -1px -1px 2px rgba(0, 0, 0, 0.7),
        1px -1px 2px rgba(0, 0, 0, 0.7),
        -1px 1px 2px rgba(0, 0, 0, 0.7);
    letter-spacing: 0.8px;
    line-height: 1;
}

/* ── Weather line (icon + label, below time) ─────────────────────────── */
#clock-weather {
    display: flex;
    align-items: center;
    gap: 4px;
    line-height: 1;
    margin-top: 1px;
}

#clock-weather-icon {
    font-size: 12px;
    transition: opacity 0.8s ease;
    line-height: 1;
}

#clock-weather-text {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: #c8c0b4;
    text-shadow:
        2px 2px 4px rgba(0, 0, 0, 0.9),
        -1px -1px 2px rgba(0, 0, 0, 0.7),
        1px -1px 2px rgba(0, 0, 0, 0.7),
        -1px 1px 2px rgba(0, 0, 0, 0.7);
    letter-spacing: 0.5px;
    transition: color 0.8s ease;
}

/* ── Colour shifts for time-of-day ───────────────────────────────────── */
#clock-widget.daytime #clock-time-text          { color: #f5eacc; }
#clock-widget.daytime #clock-weather-text       { color: #d8d0c0; }
#clock-widget.daytime #clock-divider            { color: rgba(255, 230, 180, 0.3); }

#clock-widget.sunrise #clock-time-text          { color: #ffc87c; }
#clock-widget.sunrise #clock-weather-text       { color: #e0b07a; }
#clock-widget.sunrise #clock-divider            { color: rgba(255, 200, 124, 0.3); }

#clock-widget.sunset  #clock-time-text          { color: #e8a060; }
#clock-widget.sunset  #clock-weather-text       { color: #d09060; }
#clock-widget.sunset  #clock-divider            { color: rgba(232, 160, 96, 0.3); }

#clock-widget.nighttime #clock-time-text        { color: #a0a8c0; }
#clock-widget.nighttime #clock-weather-text     { color: #8890a8; }
#clock-widget.nighttime #clock-divider          { color: rgba(160, 168, 192, 0.25); }
