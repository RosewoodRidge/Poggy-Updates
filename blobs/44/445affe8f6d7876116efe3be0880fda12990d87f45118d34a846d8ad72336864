body {
    margin: 0;
    padding: 0;
    overflow: hidden;
}

#youtube-container {
    position: absolute;
    top: -9999px;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
}

#player {
    width: 1px;
    height: 1px;
}

#aop-display {
    position: absolute;
    top: 20px;
    left: 20px;
    right: auto;
    display: none;
    pointer-events: none;
    z-index: 1000;
    opacity: 0.65;
    text-align: left;
    transition: left 0.3s ease, right 0.3s ease;
}

#aop-display.visible {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

/* /aop r mirrors the wrapper to the right edge. Set via the `aopSetSide`
   NUI message from cl_aop.lua. */
#aop-display.aop-right {
    left: auto;
    right: 20px;
    text-align: right;
    align-items: flex-end;
}

#aop-text {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 18px;
    font-weight: bold;
    color: white;
    text-shadow: 
        2px 2px 4px rgba(0, 0, 0, 0.9),
        -1px -1px 2px rgba(0, 0, 0, 0.7),
        1px -1px 2px rgba(0, 0, 0, 0.7),
        -1px 1px 2px rgba(0, 0, 0, 0.7),
        1px 1px 2px rgba(0, 0, 0, 0.7);
    letter-spacing: 0.5px;
}

#aop-players {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 16px;
    font-weight: bold;
    color: white;
    text-shadow: 
        2px 2px 4px rgba(0, 0, 0, 0.9),
        -1px -1px 2px rgba(0, 0, 0, 0.7),
        1px -1px 2px rgba(0, 0, 0, 0.7),
        -1px 1px 2px rgba(0, 0, 0, 0.7),
        1px 1px 2px rgba(0, 0, 0, 0.7);
    letter-spacing: 0.5px;
}

#aop-help {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 12px;
    font-weight: normal;
    color: white;
    text-shadow: 
        1px 1px 3px rgba(0, 0, 0, 0.8),
        -1px -1px 2px rgba(0, 0, 0, 0.6);
    letter-spacing: 0.3px;
    margin-top: 3px;
}

/* ── Duty Count HUD ─────────────────────────────────────────────────────── */
#duty-row {
    display: none; /* shown by JS when at least one service is on duty */
    flex-direction: row;
    align-items: center;
    gap: 0;
}

#aop-display.aop-right #duty-row {
    justify-content: flex-end;
}

#duty-law {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 14px;
    font-weight: bold;
    color: #ffb3ae;
    text-shadow:
        2px 2px 4px rgba(0, 0, 0, 0.9),
        -1px -1px 2px rgba(0, 0, 0, 0.7),
        1px -1px 2px rgba(0, 0, 0, 0.7),
        -1px 1px 2px rgba(0, 0, 0, 0.7),
        1px 1px 2px rgba(0, 0, 0, 0.7);
    letter-spacing: 0.3px;
}

#duty-sep {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 14px;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.5);
    text-shadow:
        2px 2px 4px rgba(0, 0, 0, 0.9);
}

#duty-doc {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 14px;
    font-weight: bold;
    color: #aed0ff;
    text-shadow:
        2px 2px 4px rgba(0, 0, 0, 0.9),
        -1px -1px 2px rgba(0, 0, 0, 0.7),
        1px -1px 2px rgba(0, 0, 0, 0.7),
        -1px 1px 2px rgba(0, 0, 0, 0.7),
        1px 1px 2px rgba(0, 0, 0, 0.7);
    letter-spacing: 0.3px;
}
