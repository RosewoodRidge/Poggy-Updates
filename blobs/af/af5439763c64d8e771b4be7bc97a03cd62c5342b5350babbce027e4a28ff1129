<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Poggy Fishing</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div id="fishing-hud" class="hidden">
        <div class="wave-accent">
            <svg viewBox="0 0 300 12" preserveAspectRatio="none">
                <path d="M0 6C25 2 50 10 75 6S125 2 150 6S200 10 225 6S275 2 300 6" stroke="rgba(72,160,224,0.4)" fill="none" stroke-width="1.2"/>
            </svg>
        </div>
        <div id="zone-label"></div>
        <div id="zone-fish" class="hidden"></div>
        <div id="approach-view" class="hidden">
            <div class="approach-surface">
                <svg viewBox="0 0 260 10" preserveAspectRatio="none" class="surface-wave">
                    <path d="M0 5C20 2 40 8 65 5S110 2 130 5S175 8 195 5S240 2 260 5V10H0Z" fill="rgba(72,160,224,0.15)"/>
                </svg>
            </div>
            <div class="approach-scene">
                <svg class="fishing-line-svg" viewBox="0 0 260 45" preserveAspectRatio="none">
                    <path id="fishing-line-path" d="" stroke="rgba(180,200,220,0.25)" fill="none" stroke-width="1" stroke-linecap="round"/>
                </svg>
                <div class="hook-marker" id="hook-marker">
                    <div class="hook-glow" id="hook-glow"></div>
                    <div class="hook-tip" id="hook-tip">&#9693;</div>
                </div>
                <div id="fish-marker">
                    <div class="fish-ripple r1"></div>
                    <div class="fish-ripple r2"></div>
                    <div class="fish-glow" id="fish-glow"></div>
                    <div class="fish-body" id="fish-body-el">&#x1F41F;</div>
                </div>
                <div id="alert-badge" class="hidden">!</div>
            </div>
            <div id="approach-label">Watching the water...</div>
        </div>
        <div id="status-area">
            <div id="status-icon"></div>
            <div id="status-text">Ready to fish</div>
        </div>
        <div id="fish-info" class="hidden">
            <span id="fish-name"></span>
            <span id="fish-weight"></span>
        </div>
        <div id="progress-container" class="hidden">
            <div id="progress-track">
                <div id="progress-fill">
                    <div class="wave-crest"></div>
                </div>
            </div>
            <div id="progress-label">
                <span id="progress-pct">0%</span>
            </div>
        </div>
        <div id="tug-area" class="hidden">
            <div class="interest-bars">
                <!-- LEFT: Tension bar (red, hook icon above) -->
                <div class="ibar ibar-tension">
                    <div class="ibar-icon-row">
                        <div class="ibar-icon">
                            <svg viewBox="0 0 24 28" width="16" height="20">
                                <line x1="12" y1="0" x2="12" y2="14" stroke="rgba(230,160,160,0.6)" stroke-width="1.5" stroke-dasharray="3,2"/>
                                <path d="M12 14 Q12 18 9 20 Q7 22 9 24" stroke="rgba(230,160,160,0.7)" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                                <circle cx="9" cy="24" r="1.5" fill="rgba(230,160,160,0.6)"/>
                            </svg>
                        </div>
                        <div class="ibar-label">Tension</div>
                    </div>
                    <div class="ibar-track">
                        <div id="tension-fill" class="ibar-fill ibar-fill-red ibar-fill-rtl">
                            <div class="ibar-liquid ibar-liquid-left"></div>
                        </div>
                    </div>
                </div>

                <!-- CENTER: Press E prompt -->
                <div class="interest-prompt" id="interest-prompt">
                    <kbd>E</kbd>
                    <span>Tug</span>
                </div>

                <!-- RIGHT: Interest bar (blue, fish icon above) -->
                <div class="ibar ibar-interest">
                    <div class="ibar-icon-row">
                        <div class="ibar-label">Interest</div>
                        <div class="ibar-icon">&#x1F41F;</div>
                    </div>
                    <div class="ibar-track">
                        <div id="interest-fill" class="ibar-fill ibar-fill-blue">
                            <div class="ibar-liquid"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PRO ROD: Direction pull bar (replaces interest/E prompt) -->
            <div id="pull-direction" class="hidden">
                <div class="pull-labels">
                    <span class="pull-dir-label pull-dir-left">&#9664; LEFT</span>
                    <span class="pull-dir-label pull-dir-fwd">FORWARD</span>
                    <span class="pull-dir-label pull-dir-right">RIGHT &#9654;</span>
                </div>
                <div class="pull-track">
                    <div class="pull-zone pull-zone-left" id="pull-zone-left"></div>
                    <div class="pull-zone pull-zone-center" id="pull-zone-center"></div>
                    <div class="pull-zone pull-zone-right" id="pull-zone-right"></div>
                    <div class="pull-needle" id="pull-needle"></div>
                    <div class="pull-center-mark"></div>
                </div>
                <div class="pull-tension-row">
                    <div class="ibar-icon-row">
                        <div class="ibar-icon">
                            <svg viewBox="0 0 24 28" width="14" height="17">
                                <line x1="12" y1="0" x2="12" y2="14" stroke="rgba(230,160,160,0.6)" stroke-width="1.5" stroke-dasharray="3,2"/>
                                <path d="M12 14 Q12 18 9 20 Q7 22 9 24" stroke="rgba(230,160,160,0.7)" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                                <circle cx="9" cy="24" r="1.5" fill="rgba(230,160,160,0.6)"/>
                            </svg>
                        </div>
                        <div class="ibar-label">Tension</div>
                    </div>
                    <div class="ibar-track pull-tension-track">
                        <div id="pull-tension-fill" class="ibar-fill ibar-fill-red">
                            <div class="ibar-liquid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="controls-bar">
            <span class="ctrl" id="ctrl-cast"><kbd>LMB</kbd> Cast</span>
            <span class="ctrl" id="ctrl-bait"><kbd>G</kbd> Bait</span>
            <span class="ctrl" id="ctrl-stow"><kbd>Bksp</kbd> Stow</span>
            <span class="ctrl" id="ctrl-music"><kbd>D</kbd> Music</span>
        </div>

        <!-- Now-playing strip -->
        <div id="now-playing" class="hidden">
            <div class="np-icon">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13"/>
                    <circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
                </svg>
            </div>
            <span id="np-track-name">Off</span>
        </div>

        <!-- Current bait indicator (always visible when bait equipped) -->
        <div id="bait-indicator" class="hidden">
            <img id="bait-indicator-img" src="" alt="">
            <span id="bait-indicator-name"></span>
            <span id="bait-indicator-qty"></span>
        </div>

        <!-- Time-of-day footer — always visible, adds bottom breathing room -->
        <div id="hud-footer">
            <span id="footer-time-icon">☀️</span>
            <span id="footer-time-label">DAYTIME</span>
            <span id="footer-time-clock">12:00 PM</span>
        </div>

    </div>

    <!-- Reel overlay (outside HUD to avoid overflow:hidden clip) -->
    <div id="reel-overlay" class="hidden">
        <div id="reel-body"></div>
        <div id="reel-gear"></div>
        <div id="reel-handle"></div>
    </div>

    <!-- Bait selection overlay (outside HUD to avoid overflow:hidden clip) -->
    <div id="bait-menu" class="hidden">
        <div class="bait-menu-header">
            <span>Select Bait</span>
            <span class="bait-menu-close" id="bait-menu-close">&times;</span>
        </div>
        <div id="bait-list"></div>
        <div id="bait-remove" class="hidden">
            <button id="btn-remove-bait">Remove Bait</button>
        </div>
    </div>

    <div id="result-flash" class="hidden"></div>
    <script>
    /* Item icon URL prefix from poggy_core (inv.imageBase), sent with show / showBaitMenu.
       Registered before app.js so it is set before app.js draws the icons. */
    window.addEventListener("message", function(event) {
        var d = event.data;
        if (d && typeof d.imageBase === "string" && d.imageBase !== "") window.POGGY_IMG_BASE = d.imageBase;
    });
    </script>
    <script src="app.js"></script>
    <script>
    /* Discovery cover overlay — inline to avoid CEF caching issues */
    (function() {
        function patchGrid(fishList) {
            if (!fishList || !fishList.length) return;
            var zf = document.getElementById("zone-fish");
            if (!zf) return;
            var lookup = {};
            for (var i = 0; i < fishList.length; i++) lookup[fishList[i].key] = fishList[i];
            var icons = zf.querySelectorAll(".zone-fish-icon");
            for (var j = 0; j < icons.length; j++) {
                var el = icons[j];
                var info = lookup[el.dataset.fishKey];
                if (info && !info.discovered) el.classList.add("undiscovered");
            }
        }
        function revealFish(fishKey) {
            var zf = document.getElementById("zone-fish");
            if (!zf) return;
            var el = zf.querySelector('.zone-fish-icon[data-fish-key="' + fishKey + '"]');
            if (el) { el.classList.remove("undiscovered"); el.classList.add("just-discovered"); }
        }
        window.addEventListener("message", function(event) {
            var d = event.data;
            if (!d || !d.action) return;
            if ((d.action === "show" || d.action === "timeUpdate") && d.fish) {
                requestAnimationFrame(function() { patchGrid(d.fish); });
                setTimeout(function() { patchGrid(d.fish); }, 60);
            }
            if (d.action === "revealFish") revealFish(d.fishKey);
        });
    })();
    </script>
</body>
</html>