{
  "label": "Poggy Scenes 2.0",
  "tagline": "Real sign boards you type on, coloured scene text, status tags and a /me box",
  "category": "Roleplay",
  "description": "Players place coloured floating text or a painted wooden sign in the world that stays through restarts, wear a status tag above their head, and send /me and /do actions. Nearby /me messages also collect in a tidy on-screen box so nobody misses them.",
  "readme": "README.md",
