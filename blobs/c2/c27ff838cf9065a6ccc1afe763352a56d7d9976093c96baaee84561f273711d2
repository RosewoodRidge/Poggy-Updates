<!DOCTYPE html>
<html lang="en" style="background:transparent !important;background-color:transparent !important;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store Manager</title>
    <link rel="stylesheet" href="css/manager.css">
    <link rel="stylesheet" href="css/exchange.css">
    <script src="https://cfx-nui-poggy_core/ui/hub/theme.js"></script>
</head>
<body style="background:transparent !important;background-color:transparent !important;">
    <!-- ================================================================ -->
    <!-- MAIN STORE MANAGER CONTAINER                                     -->
    <!-- ================================================================ -->
    <div id="manager-container" class="container hidden">
        <div class="manager-header">
            <div class="header-left">
                <h1 id="shop-title">STORE MANAGER</h1>
                <span id="shop-id-badge" class="shop-id-badge">ID: —</span>
            </div>
            <button id="btn-close" class="btn-close">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M11 3L3 11M3 3l8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
        </div>

        <!-- Tab Bar -->
        <div class="tab-bar">
            <button class="tab-btn active" data-tab="dashboard">Dashboard</button>
            <button class="tab-btn" data-tab="inventory">Inventory</button>
            <button class="tab-btn" data-tab="buylist">Buy List</button>
            <button class="tab-btn" data-tab="storage">Sold Items</button>
            <button class="tab-btn" data-tab="ledger">Ledger</button>
            <button class="tab-btn" data-tab="analytics">Analytics</button>
            <button class="tab-btn" data-tab="settings">Settings</button>
            <button class="tab-btn" data-tab="employees">Employees</button>
        </div>

        <!-- ============================================================ -->
        <!-- DASHBOARD TAB                                                -->
        <!-- ============================================================ -->
        <div id="tab-dashboard" class="tab-content active">
            <div class="dashboard-layout">
                <!-- Stats Row -->
                <div class="stats-row">
                    <div class="stat-card">
                        <div class="stat-label">Ledger Balance</div>
                        <div class="stat-value stat-green" id="dash-ledger">$0.00</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Today's Revenue</div>
                        <div class="stat-value" id="dash-today-revenue">$0.00</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">This Week</div>
                        <div class="stat-value" id="dash-week-revenue">$0.00</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Items Sold Today</div>
                        <div class="stat-value" id="dash-today-items">0</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Stock Items</div>
                        <div class="stat-value" id="dash-stock-count">0</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Storage Used</div>
                        <div class="stat-value" id="dash-storage-used">0 / 0</div>
                    </div>
                </div>

                <div class="dashboard-columns">
                    <!-- Popular Items -->
                    <div class="dash-panel">
                        <h3 class="panel-title">Top Sellers</h3>
                        <div class="dash-panel-body" id="dash-top-sellers">
                            <div class="empty-state">No sales data yet</div>
                        </div>
                    </div>

                    <!-- Low Stock Alerts -->
                    <div class="dash-panel">
                        <h3 class="panel-title">Low Stock Alerts</h3>
                        <div class="dash-panel-body" id="dash-low-stock">
                            <div class="empty-state">All items well stocked</div>
                        </div>
                    </div>

                    <!-- Recent Transactions -->
                    <div class="dash-panel dash-panel-wide">
                        <h3 class="panel-title">Recent Transactions</h3>
                        <div class="dash-panel-body" id="dash-recent-txns">
                            <div class="empty-state">No recent transactions</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- INVENTORY TAB                                                -->
        <!-- ============================================================ -->
        <div id="tab-inventory" class="tab-content">
            <div class="inventory-layout">
                <!-- Shop Stock (left) -->
                <div class="inv-panel">
                    <div class="inv-toolbar">
                        <h3 class="panel-title" style="margin:0;white-space:nowrap;">Shop Stock</h3>
                        <input type="text" id="inv-search" class="input-field" placeholder="Search shop inventory...">
                    </div>
                    <div class="inv-table-wrapper">
                        <table class="listings-table">
                            <thead>
                                <tr>
                                    <th class="col-inv-item">Item</th>
                                    <th class="col-inv-qty">Qty</th>
                                    <th class="col-inv-price">Price</th>
                                    <th class="col-inv-actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="inv-tbody">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                    <div class="pagination">
                        <span id="inv-count" class="listings-count">0 items in stock</span>
                    </div>
                </div>

                <!-- Personal Inventory (right) -->
                <div class="inv-panel">
                    <div class="inv-toolbar">
                        <h3 class="panel-title" style="margin:0;white-space:nowrap;">Your Inventory</h3>
                        <input type="text" id="personal-inv-search" class="input-field" placeholder="Search your items...">
                        <button id="btn-refresh-personal-inv" class="btn-action" style="white-space:nowrap;">Refresh</button>
                    </div>
                    <div class="inv-table-wrapper">
                        <table id="personal-inv-table" class="listings-table">
                            <thead>
                                <tr>
                                    <th class="col-inv-item">Item</th>
                                    <th class="col-inv-qty">Have</th>
                                    <th class="col-personal-price">Price</th>
                                    <th class="col-personal-qty">Qty</th>
                                    <th class="col-personal-actions">Action</th>
                                </tr>
                            </thead>
                            <tbody id="personal-inv-tbody">
                                <tr><td class="empty-cell" colspan="5">Click "Refresh" to load your inventory</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- BUY LIST TAB                                                 -->
        <!-- ============================================================ -->
        <div id="tab-buylist" class="tab-content">
            <div class="buylist-layout">
                <!-- Current Buy List -->
                <div class="buylist-current">
                    <h3 class="panel-title">Current Buy List</h3>
                    <div class="buylist-table-wrapper">
                        <table class="listings-table">
                            <thead>
                                <tr>
                                    <th class="col-bl-item">Item</th>
                                    <th class="col-bl-price">Buy Price</th>
                                    <th class="col-bl-amount">Max Qty</th>
                                    <th class="col-bl-actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="buylist-tbody">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Add Item Panel -->
                <div class="buylist-add-panel">
                    <h3 class="panel-title">Add Item to Buy List</h3>
                    <div class="buylist-search-wrapper">
                        <input type="text" id="buylist-search" class="input-field" placeholder="Search all items...">
                    </div>
                    <div id="buylist-item-list" class="buylist-item-list">
                        <!-- Populated by JS -->
                    </div>
                    <div id="buylist-add-form" class="buylist-add-form hidden">
                        <div class="selected-item-banner">
                            <span id="buylist-selected-name" class="item-preview-name"></span>
                            <button id="buylist-clear-selection" class="btn-small-cancel">&times;</button>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Buy Price ($)</label>
                                <input type="number" id="buylist-price" class="input-field" min="0.01" step="0.01" value="">
                            </div>
                            <div class="form-group">
                                <label>Max Quantity</label>
                                <input type="number" id="buylist-amount" class="input-field" min="1" value="10">
                            </div>
                        </div>
                        <button id="btn-add-buyitem" class="btn-submit">ADD TO BUY LIST</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- LEDGER TAB                                                   -->
        <!-- ============================================================ -->
        <div id="tab-ledger" class="tab-content">
            <div class="ledger-layout">
                <!-- Balance & Actions -->
                <div class="ledger-top">
                    <div class="ledger-balance-card">
                        <div class="stat-label">Current Balance</div>
                        <div class="stat-value stat-green" id="ledger-balance">$0.00</div>
                    </div>
                    <div class="ledger-actions">
                        <div class="form-group">
                            <label>Amount ($)</label>
                            <input type="number" id="ledger-amount" class="input-field" min="0.01" step="0.01" placeholder="0.00">
                        </div>
                        <div class="ledger-btns">
                            <button id="btn-withdraw" class="btn-action">Withdraw</button>
                            <button id="btn-deposit" class="btn-submit">Deposit</button>
                        </div>
                    </div>
                </div>

                <!-- Transaction History -->
                <div class="ledger-history">
                    <div class="ledger-history-header">
                        <h3 class="panel-title">Transaction History</h3>
                        <div class="ledger-filters">
                            <select id="ledger-filter-type" class="input-field">
                                <option value="all">All Types</option>
                                <option value="sale">Sales</option>
                                <option value="ghost">Ghost Sales</option>
                                <option value="deposit">Deposits</option>
                                <option value="purchase">Purchases</option>
                                <option value="withdraw">Withdrawals</option>
                                <option value="tax">Tax</option>
                            </select>
                            <select id="ledger-filter-range" class="input-field">
                                <option value="today">Today</option>
                                <option value="week">This Week</option>
                                <option value="month">This Month</option>
                                <option value="all">All Time</option>
                            </select>
                        </div>
                    </div>
                    <div class="ledger-table-wrapper">
                        <table class="listings-table">
                            <thead>
                                <tr>
                                    <th class="col-txn-date">Date</th>
                                    <th class="col-txn-type">Type</th>
                                    <th class="col-txn-item">Item</th>
                                    <th class="col-txn-qty">Qty</th>
                                    <th class="col-txn-amount">Amount</th>
                                    <th class="col-txn-who">Customer</th>
                                </tr>
                            </thead>
                            <tbody id="ledger-tbody">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- ANALYTICS TAB                                                -->
        <!-- ============================================================ -->
        <div id="tab-analytics" class="tab-content">
            <div class="analytics-layout">
                <!-- Revenue Chart -->
                <div class="analytics-chart-panel">
                    <div class="analytics-chart-header">
                        <h3 class="panel-title" id="revenue-chart-title">Revenue</h3>
                    </div>
                    <div class="chart-container" id="revenue-chart">
                        <!-- CSS bar chart rendered by JS -->
                    </div>
                </div>

                <div class="analytics-columns">
                    <!-- Top Sellers -->
                    <div class="dash-panel">
                        <h3 class="panel-title">Top Sellers (All Time)</h3>
                        <div class="dash-panel-body" id="analytics-top-sellers">
                            <div class="empty-state">No sales data yet</div>
                        </div>
                    </div>

                    <!-- Items by Revenue -->
                    <div class="dash-panel">
                        <h3 class="panel-title">Top Items by Revenue</h3>
                        <div class="dash-panel-body" id="analytics-top-revenue">
                            <div class="empty-state">No sales data yet</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- SETTINGS TAB                                                 -->
        <!-- ============================================================ -->
        <div id="tab-settings" class="tab-content">
            <div class="settings-layout">
                <div class="settings-grid">
                    <!-- Shop Name -->
                    <div class="settings-card">
                        <h4 class="settings-card-title">Shop Name</h4>
                        <p class="settings-card-desc">Change your shop's display name</p>
                        <div class="settings-input-row">
                            <input type="text" id="settings-name" class="input-field" maxlength="50" placeholder="Shop name...">
                            <button id="btn-save-name" class="btn-action">Save</button>
                        </div>
                    </div>

                    <!-- Blip Visibility -->
                    <div class="settings-card">
                        <h4 class="settings-card-title">Map Blip</h4>
                        <p class="settings-card-desc">Show or hide your shop on the map</p>
                        <div class="settings-toggle-row">
                            <label class="toggle-switch">
                                <input type="checkbox" id="settings-blip">
                                <span class="toggle-slider"></span>
                            </label>
                            <span id="settings-blip-label" class="toggle-label">Visible</span>
                        </div>
                    </div>

                    <!-- Blip Icon / Sprite -->
                    <div class="settings-card">
                        <h4 class="settings-card-title">Blip Icon</h4>
                        <p class="settings-card-desc">
                            Enter a blip name to change your shop's map icon.<br>
                            <a href="https://redlookup.com/blips/?p=1" target="_blank" style="color:var(--accent-primary);text-decoration:underline;">Browse available blip names here</a><br>
                            <span style="opacity:0.8;">Example: <code style="background:var(--bg-tertiary);padding:1px 5px;border-radius:3px;">blip_ambient_bounty_hunter_higher</code></span>
                        </p>
                        <div class="settings-input-row">
                            <input type="text" id="settings-blipsprite" class="input-field" maxlength="100" placeholder="e.g. blip_ambient_bounty_hunter_higher">
                            <button id="btn-save-blipsprite" class="btn-action">Apply</button>
                        </div>
                    </div>

                    <!-- Upgrade Storage -->
                    <div class="settings-card">
                        <h4 class="settings-card-title">Upgrade Storage</h4>
                        <p class="settings-card-desc">Current slots: <span id="settings-slots">0</span> &mdash; Cost per slot: <span id="settings-slot-cost">$0.00</span></p>
                        <div class="settings-input-row">
                            <input type="number" id="settings-upgrade-amount" class="input-field" min="1" value="10" placeholder="Slots to add...">
                            <button id="btn-upgrade-slots" class="btn-action">Upgrade (<span id="settings-upgrade-total">$0.00</span>)</button>
                        </div>
                    </div>

                    <!-- Webhook -->
                    <div class="settings-card" id="settings-webhook-card">
                        <h4 class="settings-card-title">Discord Webhook</h4>
                        <p class="settings-card-desc">Receive Discord notifications for shop activity</p>
                        <div class="settings-input-row">
                            <input type="text" id="settings-webhook" class="input-field" placeholder="https://discord.com/api/webhooks/...">
                            <button id="btn-save-webhook" class="btn-action">Save</button>
                        </div>
                    </div>

                    <!-- Hand the shop over (Config.Transfers): the owner only -->
                    <div class="settings-card hidden" id="settings-transfer-card">
                        <h4 class="settings-card-title">Hand Over Shop</h4>
                        <p class="settings-card-desc">Give this shop, with its stock, ledger and staff, to a player standing near you. They have to accept.</p>
                        <div class="settings-input-row">
                            <button id="btn-transfer-find" class="btn-action">Find players nearby</button>
                        </div>
                        <div id="transfer-player-list" class="emp-player-list hidden"></div>
                        <div id="transfer-form" class="buylist-add-form hidden">
                            <div class="selected-item-banner">
                                <span id="transfer-selected-name" class="item-preview-name"></span>
                                <button id="transfer-clear" class="btn-small-cancel">&times;</button>
                            </div>
                            <p class="settings-card-desc">Type the shop&rsquo;s name to confirm.</p>
                            <div class="settings-input-row">
                                <input type="text" id="transfer-confirm-name" class="input-field" maxlength="50" placeholder="Shop name...">
                                <button id="btn-transfer-offer" class="btn-danger">Offer shop</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- SOLD ITEMS / STORAGE TAB                                     -->
        <!-- ============================================================ -->
        <div id="tab-storage" class="tab-content">
            <div class="storage-layout">
                <!-- Left: Current sold items -->
                <div class="storage-current">
                    <div class="inv-toolbar">
                        <h3 class="panel-title" style="margin:0;white-space:nowrap;">Sold Items Storage</h3>
                        <span id="storage-capacity-info" class="storage-capacity"></span>
                        <input type="number" id="storage-upgrade-amount" class="input-field" min="1" value="10" placeholder="Slots..." style="width:70px;flex:0 0 auto">
                        <button id="btn-storage-upgrade" class="btn-action" style="white-space:nowrap">Upgrade (<span id="storage-upgrade-total">$0.00</span>)</button>
                    </div>
                    <div class="inv-table-wrapper">
                        <table class="listings-table">
                            <thead>
                                <tr>
                                    <th class="col-storage-item">Item</th>
                                    <th class="col-storage-qty">Qty</th>
                                    <th class="col-storage-actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="storage-tbody">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                    <div class="pagination">
                        <span id="storage-count" class="listings-count">0 items in storage</span>
                    </div>
                </div>

                <!-- Right: Add from personal inventory -->
                <div class="storage-add-panel">
                    <div class="inv-toolbar">
                        <h3 class="panel-title" style="margin:0;white-space:nowrap;">Add from Inventory</h3>
                        <button id="btn-refresh-storage-inv" class="btn-action" style="white-space:nowrap">Refresh</button>
                    </div>
                    <div class="buylist-search-wrapper">
                        <input type="text" id="storage-inv-search" class="input-field" placeholder="Search your items...">
                    </div>
                    <div class="inv-table-wrapper">
                        <table class="listings-table">
                            <thead>
                                <tr>
                                    <th style="width:52%">Item</th>
                                    <th style="width:11%;text-align:center">Have</th>
                                    <th style="width:18%;text-align:center">Qty</th>
                                    <th style="width:19%;text-align:center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="storage-player-inv-tbody">
                                <tr><td class="empty-cell" colspan="4">Click &ldquo;Refresh&rdquo; to load your inventory</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- ============================================================ -->
        <!-- EMPLOYEES TAB                                                -->
        <!-- ============================================================ -->
        <div id="tab-employees" class="tab-content">
            <div class="employees-layout">
                <!-- Current Employees Table -->
                <div class="emp-current-panel">
                    <!-- Shop job (Config.ShopJobs): a locked, read-only title for
                         everyone. Only server staff change it, with /pmshopjob.
                         Text comes from translations.lua. -->
                    <div id="emp-shopjob" class="inv-toolbar hidden" style="margin-bottom:10px">
                        <h3 id="emp-shopjob-title" class="panel-title" style="margin:0"></h3>
                    </div>
                    <div class="inv-toolbar" style="margin-bottom:10px">
                        <h3 class="panel-title" style="margin:0">Current Employees</h3>
                    </div>
                    <p class="emp-hint">Job-based employees (via the job system) are shown read-only. Directly hired employees can have their role changed or be removed here.</p>
                    <div class="inv-table-wrapper">
                        <table class="listings-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th style="width:160px">Role</th>
                                    <th style="width:130px">Source</th>
                                    <th style="width:200px;text-align:center">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="employees-tbody">
                                <tr><td class="empty-cell" colspan="4">Click &ldquo;Employees&rdquo; tab to load</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Add Employee Panel -->
                <div class="emp-add-panel">
                    <div class="inv-toolbar" style="margin-bottom:10px">
                        <h3 class="panel-title" style="margin:0">Add Employee</h3>
                        <button id="btn-refresh-emp" class="btn-action" style="white-space:nowrap">Refresh</button>
                    </div>
                    <div class="buylist-search-wrapper">
                        <input type="text" id="emp-search" class="input-field" placeholder="Search online players...">
                    </div>
                    <div id="emp-add-player-list" class="emp-player-list">
                        <div class="empty-state">Open this tab to load online players</div>
                    </div>
                    <div id="emp-add-form" class="buylist-add-form hidden">
                        <div class="selected-item-banner">
                            <span id="emp-selected-name" class="item-preview-name"></span>
                            <button id="emp-clear-selection" class="btn-small-cancel">&times;</button>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Role</label>
                                <select id="emp-role-select" class="input-field">
                                    <option value="employee">Employee</option>
                                    <option value="manager">Manager</option>
                                </select>
                            </div>
                        </div>
                        <button id="btn-hire-employee" class="btn-submit">ADD EMPLOYEE</button>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- /manager-container -->

    <!-- ================================================================ -->
    <!-- CUSTOMER SHOP CONTAINER                                          -->
    <!-- ================================================================ -->
    <div id="customer-container" class="customer-container hidden">
        <div class="customer-header">
            <div class="header-left">
                <h1 id="cust-shop-title">SHOP</h1>
            </div>
            <button id="cust-btn-close" class="btn-close">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M11 3L3 11M3 3l8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
        </div>

        <!-- Tab Toggle: Buy / Sell -->
        <div class="cust-tab-bar">
            <button class="cust-tab-btn active" data-cust-tab="buy">Buy</button>
            <button class="cust-tab-btn" data-cust-tab="sell">Sell</button>
        </div>

        <!-- ============================================================ -->
        <!-- BUY TAB                                                      -->
        <!-- ============================================================ -->
        <div id="cust-tab-buy" class="cust-tab-content active">
            <div class="cust-toolbar">
                <input type="text" id="cust-buy-search" class="input-field" placeholder="Search items to buy...">
                <select id="cust-buy-category" class="input-field cust-category-select">
                    <option value="">All Categories</option>
                </select>
                <div class="cust-view-toggle" role="group" aria-label="Layout">
                    <button type="button" class="cust-view-btn active" data-cust-view="list" title="List view" aria-label="List view">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 3.5h10M2 7h10M2 10.5h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    </button>
                    <button type="button" class="cust-view-btn" data-cust-view="grid" title="Grid view" aria-label="Grid view">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1.5" y="1.5" width="4.5" height="4.5" rx="1" stroke="currentColor" stroke-width="1.4"/><rect x="8" y="1.5" width="4.5" height="4.5" rx="1" stroke="currentColor" stroke-width="1.4"/><rect x="1.5" y="8" width="4.5" height="4.5" rx="1" stroke="currentColor" stroke-width="1.4"/><rect x="8" y="8" width="4.5" height="4.5" rx="1" stroke="currentColor" stroke-width="1.4"/></svg>
                    </button>
                </div>
            </div>
            <div class="cust-table-wrapper" id="cust-buy-table-wrapper">
                <table class="listings-table">
                    <thead>
                        <tr>
                            <th style="width:38%">Item</th>
                            <th style="width:8%;text-align:center">Stock</th>
                            <th style="width:11%;text-align:right">Price</th>
