{
  "label": "Poggy Transform",
  "tagline": "Become a wolf, a bear, a legend or any character on your server",
  "category": "Roleplay",
  "description": "Players pick from ninety animals and characters in a card menu and become them, with their own attacks, jump and emotes. Lock any of them behind a job. Admins can also type in any ped model or wear another character's exact appearance.",
  "readme": "README.md",
  "help": [
    {
      "title": "Adding a transformation",
      "file": "docs/help/adding-transformations.md"
    },
    {
      "title": "Tuning animal attacks",
      "file": "docs/help/attacks.md"
    }
  ],
  "files": [
    "config.lua"
  ],
  "commands": [
    {
      "command": "/transform",
      "configPath": "Config.Command",
      "who": "Everyone",
      "description": "Opens the transform menu. Players see only the entries with no job lock or their own job. Admins see everything, plus the custom ped box and (on VORP) the character browser. The menu also has the button to turn back.",
      "usage": "/transform",
      "examples": [
        "/transform"
      ]
    },
    {
      "command": "/ae",
      "who": "Everyone",
      "description": "Animal emotes, while transformed into an animal that has emotes. With no word it opens the emote picker; with an emote name it plays it; stop ends a looping emote (Backspace does too).",
      "usage": "/ae [emote | stop]",
      "examples": [
        "/ae",
        "/ae howl",
        "/ae stop"
      ]
    },
    {
      "command": "/rcp",
      "who": "Everyone",
      "description": "Re-applies the appearance you are wearing from the character browser, if clothing colours drift. Does nothing otherwise.",
      "usage": "/rcp",
      "examples": [
        "/rcp"
      ]
    }
  ],
  "tabs": [
    {
      "id": "general",
      "label": "General",
      "icon": "sliders"
    },
    {
      "id": "access",
      "label": "Access & permissions",
      "icon": "shield"
    },
    {
      "id": "animals",
      "label": "Transformations",
      "icon": "paw"
    },
    {
      "id": "combat",
      "label": "Combat",
      "icon": "swords"
    },
    {
      "id": "advanced",
      "label": "Advanced",
      "icon": "cog"
    }
  ],
  "settings": {
    "Config.Command": {
      "label": "Menu command",
      "tooltip": "Chat command that opens the transform menu, without the slash.",
      "tab": "general",
      "group": "Commands"
    },
    "Config.Debug": {
      "label": "Debug output",
      "tooltip": "Prints extra lines to the server and client consoles (transforms, emotes, bad animation names). Leave off on a live server.",
      "tab": "advanced",
      "group": "Diagnostics",
      "advanced": true
    },
    "Config.AttackCooldown": {
      "label": "Attack cooldown",
      "tooltip": "Wait between basic attacks, and for any extra attack move that has no cooldown of its own. Lower means faster attacks.",
      "tab": "combat",
      "group": "Attacks",
      "min": 0,
      "max": 30000,
      "step": 100,
      "unit": "ms"
    },
    "Config.AttackMinInterval": {
      "label": "Server attack limit",
      "tooltip": "Anti-abuse: the server refuses to pass on attacks from one player faster than this. Keep it below the attack cooldowns, or real attacks get dropped.",
      "tab": "combat",
      "group": "Anti-abuse",
      "min": 0,
      "max": 5000,
      "step": 50,
      "unit": "ms",
      "advanced": true
    },
    "Config.AttackRangeTolerance": {
      "label": "Range tolerance",
      "tooltip": "Anti-abuse: extra distance on top of an animal's reach that the target still accepts an attack from. Raise it if attacks miss on a laggy server; 0 is strictest.",
      "tab": "combat",
      "group": "Anti-abuse",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "unit": "metres",
      "advanced": true
    },
    "Config.AdminAce": {
      "label": "Admin ACE",
      "tooltip": "ACE permission that makes someone a transform admin: every entry unlocked, plus the custom ped box and character browser. Grant it in server.cfg, e.g. add_ace group.admin poggy_transform.admin allow.",
      "tab": "access",
      "group": "Admins",
      "advanced": true
    },
    "Config.AdminGroups": {
      "label": "Admin groups",
      "tooltip": "Character groups (as poggy_core reports them) that count as transform admins. Checked after the ACE. Not case-sensitive.",
      "tab": "access",
      "group": "Admins",
      "picker": "group"
    }
  },
