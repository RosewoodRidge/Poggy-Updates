{
  "label": "Poggy Util",
  "tagline": "Ten small server utilities, each with its own switch",
  "category": "Utility",
  "description": "A bundle of optional utilities: area of play, clock and weather, duty count, armor protection, weapon jams, music zones, object and body cleanup, unstuck, a /help guide and a government stipend. Turn on only the ones you want.",
  "readme": "README.md",
  "help": [
    {"title": "Writing your /help guide", "file": "docs/help/help-menu.md"},
    {"title": "Setting up armor protection", "file": "docs/help/armor.md"}
  ],

  "commands": [
    {
      "command": "/aop",
      "who": "Everyone",
      "description": "Hides or shows the area-of-play box (with the clock and duty count). l or r moves it to the left or right side; the side is remembered.",
      "usage": "/aop [l|r]",
      "examples": ["/aop", "/aop r"]
    },
    {
      "command": "/help",
      "who": "Everyone",
      "description": "Opens or closes the searchable help guide. Only when the help menu is enabled.",
      "usage": "/help",
      "examples": ["/help"]
    },
    {
      "command": "/unstuck",
      "configPath": "Config.Unstuck.Command",
      "who": "Everyone",
      "description": "Teleports the player to the nearest road after a countdown. Moving or dying cancels it.",
      "usage": "/unstuck",
      "examples": ["/unstuck"]
    },
    {
      "command": "/togglemusic",
      "who": "Everyone",
      "description": "Turns music zones off or on for this player only; the choice is remembered.",
      "usage": "/togglemusic",
      "examples": ["/togglemusic"]
    },
    {
      "command": "/movearmor",
      "who": "Everyone",
      "description": "Lets the player drag the armor durability icon; click anywhere to save. Saved per character. Only with armor protection on.",
      "usage": "/movearmor",
      "examples": ["/movearmor"]
    },
    {
      "command": "/removeobjects",
      "who": "Admins",
      "description": "Deletes the given object models on every player's game, or every model in the removal list when none is given. Needs a staff group listed under Admin groups, or the server console.",
      "usage": "/removeobjects [model ...]",
      "examples": ["/removeobjects", "/removeobjects s_coachlock02x"]
    },
    {
      "command": "/cleandead",
      "who": "Admins",
      "description": "Runs dead entity cleanup now. Needs a staff group listed under Admin groups, or the server console. Does nothing while dead entity cleanup is off.",
      "usage": "/cleandead",
      "examples": ["/cleandead"]
    }
  ],

  "tabs": [
    {"id": "general", "label": "General", "icon": "sliders"},
    {"id": "access", "label": "Access & permissions", "icon": "shield"},
    {"id": "world", "label": "World", "icon": "compass"},
