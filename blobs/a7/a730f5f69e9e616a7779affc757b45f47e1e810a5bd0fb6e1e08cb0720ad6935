/* ── SIGN BOARDS ──────────────────────────────────────────────────
   The switch between floating text and a sign board, the sign editor
   (board, lettering, the words) and the placement sliders. Chrome uses
   only the page's own variables, so the Poggy theme carries over without
   a skin rule. The words box and the paint swatches are content: they
   show the board's and the paints' real colours on every theme. */
.mode-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.mode-body.hidden,
.seg.hidden,
.axis-block.hidden,
.slider-block.hidden { display: none; }

.seg {
  display: flex;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.seg-btn {
  flex: 1;
  height: 28px;
  padding: 0 10px;
  background: transparent;
  border: none;
  border-right: 1px solid var(--border);
  color: var(--text-muted);
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.04em;
  cursor: pointer;
  white-space: nowrap;
  transition: background var(--transition), color var(--transition);
}
.seg-btn:last-child { border-right: none; }
.seg-btn:hover { background: var(--bg-hover); color: var(--text); }
.seg-btn.active {
  background: var(--bg-hover);
  color: var(--gold-light);
  box-shadow: inset 0 -2px 0 var(--gold);
}

.sign-options {
  display: flex;
  gap: 10px;
}
.sign-option {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

/* a left / right switcher (◄ value ►): the stepper's frame and buttons, a label in the middle */
.switcher { flex: none; }
.sign-option .switcher { flex: 1; }
.switcher-value {
  flex: 1;
  min-width: 58px;
  padding: 0 8px;
  text-align: center;
  white-space: nowrap;
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  font-weight: 500;
  color: var(--text);
  user-select: none;
}
.switcher .step-btn { height: 28px; }

#sign-toolbar {
  display: flex;
  align-items: center;
  gap: 8px;
}
#sign-paints {
  display: flex;
  gap: 4px;
}

/* the words, on the board's own colour */
#sign-text-input {
  width: 100%;
  min-height: 84px;
  max-height: 180px;
  overflow-y: auto;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 30px;
  line-height: 1.15;
  letter-spacing: 0.04em;
  padding: 10px 12px;
  outline: none;
  text-align: center;
  text-transform: uppercase;
  word-wrap: break-word;
  overflow-wrap: break-word;
  transition: border-color var(--transition);
}
#sign-text-input:focus { border-color: var(--border-strong); }
#sign-text-input { position: relative; white-space: pre-wrap; }
#sign-text-input.empty::before {
  position: absolute;
  left: 0;
  right: 0;
  top: 14px;
  content: attr(data-placeholder);
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-style: italic;
  letter-spacing: 0.02em;
  text-transform: none;
  opacity: 0.55;
  pointer-events: none;
}
#sign-text-input.tone-l { background: var(--sign-board-light); }
#sign-text-input.tone-d { background: var(--sign-board-dark); }
#sign-text-input.sign-font-r { font-family: 'Bebas Neue', sans-serif; }
#sign-text-input.sign-font-s { font-family: 'Cinzel', serif; font-weight: 600; letter-spacing: 0.02em; }
/* words running down the board: each line is a column of upright letters */
#sign-text-input.sign-down {
  writing-mode: vertical-lr;
  text-orientation: upright;
  letter-spacing: 0;
  line-height: 1.15;
  height: 240px;
  max-height: 240px;
  overflow-x: auto;
}
#sign-status.bad { color: var(--red); }
#sign-status.over { color: var(--gold); }
.slider-label { white-space: nowrap; }
#sign-words .slider-label, #sign-sliders .slider-label { width: 96px; }

/* the words are drawn by the script: a row per line, a span per letter or symbol */
.sl { min-height: 1.15em; }
.si { white-space: pre; border-radius: 2px; }
.si.sel { background: var(--sign-select); }
#sign-text-input ::selection { background: transparent; color: currentColor; }   /* our own tint shows the selection */
/* only the text boxes can be selected: Ctrl+A must never highlight the panel itself */
#scene-root, #status-root { user-select: none; }
#scene-text-input, #sign-text-input, #status-text-input, #scene-root input, #status-root input { user-select: text; }
.si-sym { cursor: default; }

/* a painted symbol in the words: its picture cut out of the text's own colour, as tall as a capital */
.sym {
  display: inline-block;
  height: 0.74em;
  width: calc(var(--w, 1) * 0.74em);
  margin: 0 0.1em;
  pointer-events: none;
  vertical-align: baseline;
  background-color: currentColor;
  -webkit-mask-position: center;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-size: 100% 100%;
}
.sym.sym-flourish {
  height: 0.19em;
  width: calc(var(--w, 1) * 0.19em);
  vertical-align: middle;
}
/* words running down: a symbol stands upright in the column like a letter */
#sign-text-input.sign-down .sym { margin: 0.12em 0; }

/* sections that fold away */
.sec {
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-section);
}
.sec-head {
  width: 100%;
  height: 28px;
  padding: 0 8px;
  display: flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: left;
  cursor: pointer;
  transition: color var(--transition), background var(--transition);
}
.sec-head:hover { color: var(--text); background: var(--bg-hover); }
.sec.open > .sec-head { color: var(--gold-light); }
.sec-arrow {
  display: inline-block;
  font-size: 10px;
  transition: transform var(--transition);
}
.sec.open > .sec-head .sec-arrow { transform: rotate(90deg); }
.sec-body {
  display: none;
  flex-direction: column;
  gap: 8px;
  padding: 4px 8px 9px;
}
.sec.open > .sec-body { display: flex; }
.hint-left { text-align: left; }

/* the symbol buttons */
#sign-symbols {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}
.sym-btn {
  height: 26px;
  min-width: 28px;
  padding: 0 5px;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--transition), border-color var(--transition);
}
.sym-btn:hover { background: var(--bg-hover); border-color: var(--border-strong); }
.sym-btn .sym { margin: 0; }
.sym-btn.sym-wide { font-size: 30px; }
.field-label small { text-transform: none; letter-spacing: 0; font-weight: 400; opacity: 0.75; }

/* "none" among the border swatches: an empty square with a stroke through it */
.color-swatch.swatch-none {
  background: linear-gradient(to top right, transparent calc(50% - 1px), var(--text-muted) calc(50% - 1px),
              var(--text-muted) calc(50% + 1px), transparent calc(50% + 1px));
  border-color: var(--border-strong);
}

/* the sign editor is tall: on a small screen its body scrolls instead of leaving the screen */
#scene-text-panel .panel-body {
  max-height: calc(100vh - 110px);
  overflow-y: auto;
}

/* ── placement sliders (as in Poggy Badges) ── */
.slider-block {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.slider-group {
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.slider-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.slider-label {
  width: 74px;
  flex-shrink: 0;
  font-size: 11px;
  color: var(--text-muted);
}
.slider {
  flex: 1;
  min-width: 0;
  height: 4px;
  -webkit-appearance: none;
  appearance: none;
  background: var(--border-strong);
  border-radius: 2px;
  outline: none;
  cursor: pointer;
}
.slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--gold);
  border: 2px solid var(--bg-panel);
  cursor: grab;
}
.slider::-webkit-slider-thumb:active { cursor: grabbing; }
.slider-val {
  width: 64px;
  flex-shrink: 0;
  height: 26px;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
  font-family: 'Inter', monospace, sans-serif;
  font-size: 12px;
  text-align: center;
  outline: none;
}
.slider-val:focus { border-color: var(--border-strong); }
.slider-val::-webkit-inner-spin-button,
.slider-val::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

.btn-primary:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  box-shadow: none;
}
