/* ==========================================================================
   Poggy Storage — menu and prompt
   Replaces vorp_menu and vorp_inputs so the resource carries no UI dependency.
   Palette follows the store art: dark wood, cream, lantern gold.
   ========================================================================== */

:root {
    --ink:        #0e0b08;
    --panel:      #181310;
    --panel-2:    #211a15;
    --edge:       #3a2e24;
    --cream:      #f2ece0;
    --muted:      #a2937f;
    --gold:       #d9a441;
    --gold-dim:   #8a6a2b;
    --danger:     #c2553d;

    --shadow: 0 18px 48px rgba(0, 0, 0, .72);
    --serif: "Georgia", "Times New Roman", serif;
    --sans:  "Segoe UI", Roboto, system-ui, sans-serif;
}

* { box-sizing: border-box; }

html, body {
    margin: 0;
    height: 100%;
    background: transparent;
    overflow: hidden;
    font-family: var(--sans);
    color: var(--cream);
    user-select: none;
}

[hidden] { display: none !important; }

/* ==========================================================================
   List menu
   ========================================================================== */

.menu {
    position: fixed;
    top: 0; right: 0;
    height: 100%;
    display: flex;
    align-items: center;
    padding-right: 3.2vw;
    animation: slide-in .16s ease-out;
}

.menu--left  { right: auto; left: 0; padding: 0 0 0 3.2vw; }
.menu--top   { align-items: flex-start; padding-top: 4vh; }

@keyframes slide-in {
    from { opacity: 0; transform: translateX(14px); }
    to   { opacity: 1; transform: none; }
}

.menu__frame {
    width: 25.5rem;
    max-height: 78vh;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, var(--panel) 0%, var(--ink) 100%);
    border: 1px solid var(--edge);
    border-radius: 4px;
    box-shadow: var(--shadow);
    overflow: hidden;
}

/* Thin gold rule across the top, like a brass fitting on a chest. */
.menu__frame::before {
    content: "";
    display: block;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
}

.menu__head {
    padding: .95rem 1.15rem .8rem;
    border-bottom: 1px solid var(--edge);
}

.menu__title {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.24rem;
    font-weight: 700;
    letter-spacing: .02em;
    color: var(--cream);
    text-shadow: 0 2px 6px rgba(0, 0, 0, .6);
}

.menu__subtext {
    margin: .3rem 0 0;
    font-size: .78rem;
    line-height: 1.35;
    color: var(--muted);
}

.menu__subtext:empty { display: none; }

.menu__list {
    margin: 0;
    padding: .4rem 0;
    list-style: none;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--gold-dim) transparent;
}

.menu__list::-webkit-scrollbar { width: 6px; }
.menu__list::-webkit-scrollbar-thumb {
    background: var(--gold-dim);
    border-radius: 3px;
}

/* Every row is laid out identically whether or not it is highlighted. The
   active state changes colour only -- never size, spacing or visibility -- so
   moving through the list never reflows it. */
.item {
    padding: .5rem 1.15rem;
    border-left: 3px solid transparent;
    cursor: pointer;
    transition: background .1s ease, border-color .1s ease;
}

.item:hover { background: rgba(217, 164, 65, .07); }

.item--active {
    background: rgba(217, 164, 65, .13);
    border-left-color: var(--gold);
}

.item__label {
    font-size: .9rem;
    font-weight: 600;
    color: var(--cream);
}

.item--active .item__label { color: var(--gold); }

/* Always visible, indented under its label, so nothing shifts on hover. */
.item__desc {
    margin-top: .1rem;
    padding-left: .7rem;
    font-size: .72rem;
    line-height: 1.3;
    color: var(--muted);
}

/* Lifting the description on the active row reads as focus without moving it. */
.item--active .item__desc { color: #c4b49a; }

.menu__foot {
    display: flex;
    gap: 1rem;
    padding: .55rem 1.15rem;
    border-top: 1px solid var(--edge);
    background: var(--panel-2);
    font-size: .68rem;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--muted);
}

.menu__foot b { color: var(--gold); font-weight: 700; }

/* ==========================================================================
   Text prompt
   ========================================================================== */

.prompt {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 4, 3, .55);
    backdrop-filter: blur(2px);
}

.prompt__frame {
    width: 26rem;
    padding: 1.35rem 1.4rem 1.2rem;
    background: linear-gradient(180deg, var(--panel) 0%, var(--ink) 100%);
    border: 1px solid var(--edge);
    border-top: 2px solid var(--gold);
    border-radius: 4px;
    box-shadow: var(--shadow);
}

.prompt__header {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.12rem;
    color: var(--cream);
}

.prompt__hint {
    margin: .35rem 0 .9rem;
    font-size: .78rem;
    line-height: 1.4;
    color: var(--muted);
}

.prompt__hint:empty { display: none; }

.prompt__input {
    width: 100%;
    padding: .6rem .7rem;
    background: #0b0806;
    border: 1px solid var(--edge);
    border-radius: 3px;
    color: var(--cream);
    font-family: var(--sans);
    font-size: .92rem;
    outline: none;
    transition: border-color .12s ease;
}

.prompt__input:focus { border-color: var(--gold); }

.prompt__error {
    margin: .45rem 0 0;
    font-size: .74rem;
    color: var(--danger);
}

.prompt__actions {
    display: flex;
    justify-content: flex-end;
    gap: .55rem;
    margin-top: 1rem;
}

.btn {
    padding: .48rem 1.05rem;
    border: 1px solid var(--edge);
    border-radius: 3px;
    background: transparent;
    color: var(--cream);
    font-family: var(--sans);
    font-size: .82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .12s ease, border-color .12s ease, color .12s ease;
}

.btn--ghost:hover { border-color: var(--muted); }

.btn--gold {
    background: var(--gold);
    border-color: var(--gold);
    color: #241a08;
}

.btn--gold:hover { background: #e7b455; border-color: #e7b455; }
