  "commands": [
    {
      "command": "/auctionrefresh",
      "who": "Admins",
      "description": "Settles every listing whose time has run out now, instead of waiting for the next check. Works for characters in the admin, superadmin or god group, and from the server console.",
      "usage": "/auctionrefresh",
      "examples": [
        "/auctionrefresh"
      ]
    },
    {
      "command": "/auctionpurge",
      "who": "Admins",
      "description": "Cancels every active listing on the server. The items in those listings are NOT returned to anyone. To cancel one listing and give its item back, use Live auctions on the Auctions tab instead. Works for characters in the admin, superadmin or god group, and from the server console.",
      "usage": "/auctionpurge",
      "examples": [
        "/auctionpurge"
      ]
    },
    {
      "command": "/auctiondiscord",
      "who": "Admins",
      "description": "Sends a test message to the Discord webhook, so you can check it works. Discord logging and the 'New listings' event must be on, and the webhook set. Works for characters in the admin, superadmin or god group, and from the server console.",
      "usage": "/auctiondiscord",
      "examples": [
        "/auctiondiscord"
      ]
    }
  ],
