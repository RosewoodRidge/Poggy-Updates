/* ── Progress bar ──────────────────────────────────────────────────────────
   Shown while a craft plays out and while a campfire is being built. The fill
   is one CSS transition whose duration the script sets, so the bar stays in
   step with the server's timer without a JS animation loop.
   ─────────────────────────────────────────────────────────────────────── */
.craft-progress{position:fixed;left:50%;transform:translateX(-50%);z-index:9000;width:min(420px,60vw);pointer-events:none;font-family:Roboto,rdr,sans-serif}
.craft-progress-bottom{bottom:9vh}
.craft-progress-top{top:6vh}
.craft-progress-label{margin-bottom:8px;text-align:center;font-size:14px;letter-spacing:2px;text-transform:uppercase;color:var(--text-primary);text-shadow:0 2px 6px rgba(0,0,0,.9)}
.craft-progress-track{height:8px;border-radius:4px;overflow:hidden;background:rgba(10,8,6,.85);border:1px solid var(--border-accent);box-shadow:0 4px 18px rgba(0,0,0,.55)}
.craft-progress-fill{height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--accent-bright));transition-property:width;transition-timing-function:linear}
.craft-prog-enter-active,.craft-prog-leave-active{transition:opacity .2s ease}
.craft-prog-enter-from,.craft-prog-leave-to{opacity:0}
