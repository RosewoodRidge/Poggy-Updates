  "help": [
    {
      "title": "Adding bins",
      "file": "docs/help/adding-bins.md"
    },
    {
      "title": "Tuning the loot",
      "file": "docs/help/loot.md"
    }
  ],
  "commands": [
    {
      "command": "/emptytrash",
      "configPath": "Config.WipeCommand",
      "who": "Admins",
      "description": "Empties every trash bin's storage on the server and resets their search cooldowns. Only characters whose group is in Staff groups may use it, and only while 'Staff wipe command' is on. Also works from the server console.",
      "usage": "/emptytrash",
      "examples": [
        "/emptytrash"
      ]
    }
  ],
