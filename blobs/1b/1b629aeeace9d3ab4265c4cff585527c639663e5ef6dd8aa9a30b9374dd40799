  "commands": [
    {
      "command": "/createstorage",
      "configPath": "Config.menustorage",
      "who": "Everyone",
      "description": "Opens the create menu. Confirming buys a new storage at the spot where you stand, for the creation price, up to the maximum a character may own.",
      "usage": "/createstorage",
      "examples": [
        "/createstorage"
      ]
    },
    {
      "command": "/movestorage",
      "configPath": "Config.adminmovestorage",
      "who": "Admins",
      "description": "Moves a player storage to new coordinates. Works on player storages only (they have a number id); job storages are moved by editing their locations. The Storages panel in /poggy does the same with \"Move to my position\". Admins are players with the ACE in Admin ACE or a character group in Admin groups.",
      "usage": "/movestorage <id> <x> <y> <z>",
      "examples": [
        "/movestorage 12 -758.7 -1242.8 44.4"
      ]
    },
    {
      "command": "/deletestorage",
      "configPath": "Config.admindeletestorage",
      "who": "Admins",
      "description": "Deletes a player storage. Its container is unregistered, not emptied: the items stay in the inventory database but nobody can reach them (empty it first with Contents in the Storages panel if they should go). The Storages panel in /poggy does the same. Admins are players with the ACE in Admin ACE or a character group in Admin groups.",
      "usage": "/deletestorage <id>",
      "examples": [
        "/deletestorage 12"
      ]
    },
    {
      "command": "/storageadmin",
      "configPath": "Config.adminStorageCommand",
      "who": "Admins",
      "description": "Shows the map blip of every storage on the server, or goes back to only the ones you can open. Lasts until you change it or reconnect.",
      "usage": "/storageadmin show | hide",
      "examples": [
        "/storageadmin show",
        "/storageadmin hide"
      ]
    },
    {
      "command": "/adminshop",
      "configPath": "Config.adminShopCommand",
      "who": "Admins",
      "description": "Opens a free shop with every item in the server's item list. Add \"cache\" to rebuild the item list after adding items. Cannot be run from the server console.",
      "usage": "/adminshop [cache]",
      "examples": [
        "/adminshop",
        "/adminshop cache"
      ]
    }
  ],
