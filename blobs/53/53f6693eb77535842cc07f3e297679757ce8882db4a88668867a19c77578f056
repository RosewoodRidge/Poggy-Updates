  "commands": [
    {
      "command": "/emotes",
      "configPath": "Config.MenuCommand",
      "who": "Everyone",
      "description": "Opens the emote menu. Typing it again closes it.",
      "usage": "/emotes",
      "examples": [
        "/emotes"
      ]
    },
    {
      "command": "/e",
      "configPath": "Config.PlayCommand",
      "who": "Everyone",
      "description": "Plays one emote straight away. On its own, with no name after it, it opens the menu.",
      "usage": "/e <emote name>",
      "examples": [
        "/e wave",
        "/e sitground1",
        "/e"
      ]
    },
    {
      "command": "/ec",
      "configPath": "Config.CancelCommand",
      "who": "Everyone",
      "description": "Stops the emote that is playing and puts away any prop the player is holding.",
      "usage": "/ec",
      "examples": [
        "/ec"
      ]
    },
    {
      "command": "/ragdoll",
      "configPath": "Config.Ragdoll.Command",
      "who": "Everyone",
      "description": "Drops the character limp on the ground. Typing it again, or pressing the ragdoll key, lets them get up.",
      "usage": "/ragdoll",
      "examples": [
        "/ragdoll"
      ]
    }
  ],
