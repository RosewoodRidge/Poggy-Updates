/* ───────────────────────────────────────────────────────────
   Poggy Badge – NUI Stylesheet
   Western / RDR-style dark theme, steel-blue accents
   ─────────────────────────────────────────────────────────── */

@import url('https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;600&display=swap');

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  font-family: 'EB Garamond', 'Georgia', serif;
  color: #d5c8a1;
  user-select: none;
  background: transparent !important;
  background-color: transparent !important;
}

.hidden { display: none !important; }

/* ── Editor panel ──────────────────────────────────────────── */
#editor-root {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 32px;
  pointer-events: none;
  background: transparent !important;
}

.editor-panel {
  pointer-events: auto;
  width: 310px;
  background: rgba(18, 16, 14, 0.88);
  border: 1px solid rgba(160,130,80,.25);
  border-radius: 6px;
  padding: 16px 18px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 90vh;
  overflow-y: auto;
}

.editor-panel::-webkit-scrollbar { width: 4px; }
.editor-panel::-webkit-scrollbar-thumb { background: rgba(160,130,80,.35); border-radius: 2px; }

.editor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(160,130,80,.20);
  padding-bottom: 8px;
  margin-bottom: 2px;
}
.editor-title {
  font-size: 20px;
  font-weight: 600;
  color: #c9b97a;
  letter-spacing: .5px;
}
.editor-close {
  background: none; border: none; color: #8a7c5d;
  font-size: 22px; cursor: pointer; line-height: 1;
  transition: color .15s;
}
.editor-close:hover { color: #e2c77a; }

/* ── Badge preview ─────────────────────────────────────────── */
.badge-preview {
  display: flex;
  justify-content: center;
  padding: 6px 0 2px;
}
.badge-preview img {
  width: 64px;
  height: 64px;
  object-fit: contain;
  filter: drop-shadow(0 1px 4px rgba(0,0,0,.6));
}

/* ── Section labels ────────────────────────────────────────── */
.section-label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: #8a7c5d;
  margin-top: 4px;
}

/* ── Slider rows ───────────────────────────────────────────── */
.slider-group { display: flex; flex-direction: column; gap: 5px; }

.slider-row {
  display: flex;
  align-items: center;
  gap: 6px;
}
.slider-label {
  width: 52px;
  font-size: 13px;
  color: #b0a478;
  flex-shrink: 0;
}
.slider-label small { font-size: 10px; color: #8a7c5d; }

/* Range input (slider track + thumb) */
.slider {
  flex: 1;
  -webkit-appearance: none;
  appearance: none;
  height: 6px;
  border-radius: 3px;
  background: rgba(80,70,50,.5);
  outline: none;
  cursor: pointer;
}
.slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 16px; height: 16px;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 35%, #e2c77a, #a08250);
  border: 1px solid rgba(0,0,0,.3);
  box-shadow: 0 1px 4px rgba(0,0,0,.4);
  cursor: grab;
}
.slider::-webkit-slider-thumb:active { cursor: grabbing; }

/* Number box */
.slider-val {
  width: 62px;
  background: rgba(40,36,28,.7);
  border: 1px solid rgba(160,130,80,.25);
  border-radius: 3px;
  color: #d5c8a1;
  font-family: 'Consolas', 'Courier New', monospace;
  font-size: 12px;
  text-align: center;
  padding: 3px 2px;
  outline: none;
}
.slider-val:focus { border-color: #c9b97a; }

/* ── Buttons ───────────────────────────────────────────────── */
.editor-actions {
  display: flex;
  gap: 8px;
  margin-top: 4px;
}
.btn {
  flex: 1;
  padding: 7px 0;
  border: 1px solid rgba(160,130,80,.30);
  border-radius: 4px;
  font-family: inherit;
  font-size: 13px;
  cursor: pointer;
  transition: background .15s, border-color .15s;
}
.btn-show {
  background: rgba(100,130,80,.25);
  color: #bdd4a0;
}
.btn-show:hover { background: rgba(100,130,80,.40); border-color: #8aac60; }

.btn-detach {
  background: rgba(140,70,60,.25);
  color: #d4a0a0;
}
.btn-detach:hover { background: rgba(140,70,60,.40); border-color: #ac6060; }

.btn-attach {
  background: rgba(80,120,140,.25);
  color: #a0c0d4;
}
.btn-attach:hover { background: rgba(80,120,140,.40); border-color: #60a0c0; }

.btn-small {
  flex: none;
  padding: 5px 12px;
  background: rgba(90,80,60,.30);
  color: #c9b97a;
  font-size: 12px;
}
.btn-small:hover { background: rgba(90,80,60,.50); }

/* ── Preset panel ──────────────────────────────────────────── */
.preset-save-row {
  display: flex;
  gap: 6px;
}
.preset-save-row input[type="text"] {
  flex: 1;
  background: rgba(40,36,28,.7);
  border: 1px solid rgba(160,130,80,.25);
  border-radius: 3px;
  color: #d5c8a1;
  font-family: inherit;
  font-size: 13px;
  padding: 5px 8px;
  outline: none;
}
.preset-save-row input[type="text"]:focus { border-color: #c9b97a; }
.preset-save-row input[type="text"]::placeholder { color: #6b6040; }

.preset-list {
  max-height: 120px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.preset-list::-webkit-scrollbar { width: 3px; }
.preset-list::-webkit-scrollbar-thumb { background: rgba(160,130,80,.3); border-radius: 2px; }

.presets-empty {
  font-size: 12px;
  color: #6b6040;
  text-align: center;
  padding: 6px 0;
  font-style: italic;
}

.preset-item {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 6px;
  border-radius: 3px;
  background: rgba(50,44,34,.5);
  transition: background .12s;
}
.preset-item:hover { background: rgba(60,54,40,.7); }
.preset-item-name {
  flex: 1;
  font-size: 13px;
  color: #b0a478;
  cursor: pointer;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.preset-item-name:hover { color: #e2c77a; }
.preset-item-del {
  background: none; border: none;
  color: #8a5050;
  font-size: 14px;
  cursor: pointer;
  line-height: 1;
  padding: 0 2px;
  transition: color .12s;
}
.preset-item-del:hover { color: #d45050; }

/* ── Bone selector ─────────────────────────────────────────── */
.bone-select-row {
  padding: 2px 0 4px;
}
.bone-select {
  width: 100%;
  padding: 5px 8px;
  border: 1px solid rgba(160,130,80,.25);
  border-radius: 3px;
  background: rgba(30,26,20,.8);
  color: #c8b878;
  font-size: 13px;
  font-family: inherit;
  cursor: pointer;
  outline: none;
}
.bone-select:hover { border-color: rgba(160,130,80,.5); }
.bone-select:focus { border-color: rgba(200,180,100,.5); }
.bone-select option {
  background: #1e1a14;
  color: #c8b878;
}

/* ── Badge display (bottom-right flash) ────────────────────── */
.badge-display {
  position: fixed;
  bottom: 80px;
  right: 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  opacity: 0;
  transform: translateX(60px);
  pointer-events: none;
  z-index: 999;
}
.badge-display.active {
  display: flex !important;
  animation: badge-slide-in .35s ease-out forwards,
             badge-slide-out .35s ease-in 4.6s forwards;
}

.badge-display .badge-text {
  font-size: 42px;
  color: #d5c8a1;
  text-shadow: 0 2px 10px rgba(0,0,0,.8);
  letter-spacing: 1px;
}

#badge-image {
  width: 270px;
  height: 270px;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,.7));
}

@keyframes badge-slide-in {
  from { opacity: 0; transform: translateX(60px); }
  to   { opacity: 1; transform: translateX(0); }
}
@keyframes badge-slide-out {
  from { opacity: 1; transform: translateX(0); }
  to   { opacity: 0; transform: translateX(60px); }
}
